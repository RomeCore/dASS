<Application xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="LLMDesktopAssistant.App"
						 xmlns:mvvm="using:LLMDesktopAssistant.MVVM"
						 xmlns:dialogHostAvalonia="using:DialogHostAvalonia"
						 xmlns:styles="using:LLMDesktopAssistant.Styles"
						 xmlns:icons="using:LLMDesktopAssistant.Controls.Icons"
						 RequestedThemeVariant="Dark">
	
	<Application.Resources>
		<ResourceDictionary>
			
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml"/>
				<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Converters.axaml"/>
				<styles:Resources />
			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>
	</Application.Resources>
	
	<Application.Styles>

		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
		<StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml"/>
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
		<dialogHostAvalonia:DialogHostStyles />

		<FluentTheme />
		<styles:Theme />

	</Application.Styles>

	<Application.DataTemplates>
		<mvvm:ViewLocator />
	</Application.DataTemplates>

</Application>