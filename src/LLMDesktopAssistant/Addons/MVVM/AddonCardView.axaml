<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="220"
						 xmlns:cards="using:LLMDesktopAssistant.Addons.MVVM"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 x:Class="LLMDesktopAssistant.Addons.MVVM.AddonCardView"
						 x:DataType="cards:AddonCardViewModel"
						 IsVisible="{Binding IsVisible}">

	<!-- ================================================================ -->
	<!-- Styles                                                           -->
	<!-- ================================================================ -->
	<UserControl.Styles>

		<Style Selector="Border.addonCard">
			<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
			<Setter Property="BorderThickness" Value="0,1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="4"/>
		</Style>

		<!-- Display chip: a plain bordered label with an optional icon. -->
		<Style Selector="Border.cardChip">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- HasBorder == false → no outline at all (used by the source indicator). -->
		<Style Selector="Border.cardChip.noBorder">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="2"/>
		</Style>

		<!-- Tag chip: the same look, but clickable. -->
		<Style Selector="Button.cardChip">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.cardChip.noBorder">
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="Button.cardChip:pointerover">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<Style Selector="TextBlock.cardChipText">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Opacity" Value="0.8"/>
		</Style>

		<!-- A card that holds child cards: the border is emphasized. -->
		<Style Selector="Border.addonCard.group">
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
		</Style>

		<!-- The borderless chevron that toggles the children of a group card. -->
		<Style Selector="ToggleButton.cardExpander">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style Selector="ToggleButton.cardExpander:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#22FFFFFF"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="ToggleButton.cardExpander:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

	</UserControl.Styles>

	<!-- ================================================================ -->
	<!-- Reusable templates                                               -->
	<!-- ================================================================ -->
	<UserControl.Resources>

		<!-- Common chip body, shared by the display and tag chip templates. -->
		<DataTemplate x:Key="AddonCardChipBodyTemplate" x:DataType="cards:IAddonCardChip">
			<StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">

				<ContentControl Content="{Binding Content}"
												IsVisible="{Binding Content, Converter={StaticResource NotnullToBooleanConverter}}"/>

				<ico:VisualIcon Kind="{Binding Icon}"
												  IsVisible="{Binding Icon, Converter={StaticResource NotnullToBooleanConverter}}"
												  Width="12" Height="12"
												  VerticalAlignment="Center"
												  Foreground="{Binding Brush, TargetNullValue={StaticResource SecondaryAccentBrush}}"/>

				<TextBlock Classes="cardChipText"
									   Text="{loc:Loc {Binding Label}}"
									   IsVisible="{Binding Label, Converter={StaticResource NotnullToBooleanConverter}}"
									   VerticalAlignment="Center"/>
			</StackPanel>
		</DataTemplate>

		<!-- Toggle button of a collapsible block, rendered in the card action row. -->
		<DataTemplate x:Key="AddonCardCollapsibleToggleTemplate" x:DataType="cards:IAddonCardBlock">
			<ToggleButton Classes="SmallIconButton"
										IsChecked="{Binding IsExpanded, Mode=TwoWay}"
										ToolTip.Tip="{loc:Loc {Binding ToggleToolTip}}"
										IsVisible="{Binding ToggleIcon, Converter={StaticResource NotnullToBooleanConverter}}">
				<ico:VisualIcon Kind="{Binding ToggleIcon}" Width="14" Height="14"/>
			</ToggleButton>
		</DataTemplate>

		<!-- Common block body, shared by the inline, collapsible and details blocks. -->
		<DataTemplate x:Key="AddonCardBlockBodyTemplate" x:DataType="cards:IAddonCardBlock">
			<StackPanel Orientation="Vertical" Spacing="2">

				<TextBlock Text="{loc:Loc {Binding Title}}"
									 FontWeight="SemiBold"
									 FontSize="12"
									 Opacity="0.8"
									 IsVisible="{Binding Title, Converter={StaticResource NotnullToBooleanConverter}}"/>

				<ContentControl Content="{Binding Content}"
												IsVisible="{Binding Content, Converter={StaticResource NotnullToBooleanConverter}}"/>

				<ItemsControl ItemsSource="{Binding Chips}"
											IsVisible="{Binding Chips, Converter={StaticResource NotnullToBooleanConverter}}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>

			</StackPanel>
		</DataTemplate>

		<!-- Common rendering of a block: the content is shown only while the block is expanded, so a
			 collapsed block occupies no space. The plain and change block templates below compose this
			 template explicitly, which keeps the implicit template resolution chain finite. -->
		<DataTemplate x:Key="AddonCardBlockTemplate" x:DataType="cards:IAddonCardBlock">
			<ContentControl IsVisible="{Binding IsExpanded}"
											Content="{Binding}"
											ContentTemplate="{StaticResource AddonCardBlockBodyTemplate}"/>
		</DataTemplate>

	</UserControl.Resources>

	<!-- ================================================================ -->
	<!-- Element templates (resolved implicitly by element type)          -->
	<!-- ================================================================ -->
	<UserControl.DataTemplates>
		
		<!-- Header slot: an accent marker when the value is overridden, then the slot content. -->
		<DataTemplate x:DataType="cards:IAddonCardHeaderChange">
			<Grid ColumnDefinitions="3,Auto" ColumnSpacing="2" VerticalAlignment="Center">
				<Button Grid.Column="0"
									 BorderBrush="{DynamicResource PrimaryAccentBrush}"
									 Background="{DynamicResource PrimaryAccentBrush}"
									 CornerRadius="1"
									 Command="{Binding ResetCommand}"
									 IsEnabled="{Binding IsChanged}"/>
				<ContentControl Grid.Column="1"
												Content="{Binding Content}"
												VerticalAlignment="Center"/>
			</Grid>
		</DataTemplate>

		<!-- Header slot: an accent marker when the value is overridden, then the slot content. -->
		<DataTemplate x:DataType="cards:IAddonCardHeaderElement">
				<ContentControl Content="{Binding Content}"
												VerticalAlignment="Center"/>
		</DataTemplate>

		<!-- Clickable chip (tags). Must be listed BEFORE the plain chip so that the tag shape wins. -->
		<DataTemplate x:DataType="cards:IAddonCardTagChip">
			<Button Classes="cardChip"
							Classes.noBorder="{Binding !HasBorder}"
							Opacity="{Binding Opacity}"
							Command="{Binding Command}"
							CommandParameter="{Binding CommandParameter}"
							BorderBrush="{Binding Brush, TargetNullValue={StaticResource SecondaryAccentBrush}}"
							ToolTip.Tip="{loc:Loc {Binding ToolTip}}">
				<ContentControl Content="{Binding}" ContentTemplate="{StaticResource AddonCardChipBodyTemplate}"/>
			</Button>
		</DataTemplate>

		<!-- Plain chip. -->
		<DataTemplate x:DataType="cards:IAddonCardChip">
			<Border Classes="cardChip"
							Classes.noBorder="{Binding !HasBorder}"
							Opacity="{Binding Opacity}"
							BorderBrush="{Binding Brush, TargetNullValue={StaticResource SecondaryAccentBrush}}"
							ToolTip.Tip="{loc:Loc {Binding ToolTip}}">
				<ContentControl Content="{Binding}" ContentTemplate="{StaticResource AddonCardChipBodyTemplate}"/>
			</Border>
		</DataTemplate>

		<!-- Action row left side. -->
		<DataTemplate x:DataType="cards:IAddonCardActionRowElement">
			<ContentControl Content="{Binding Content}" VerticalAlignment="Center"/>
		</DataTemplate>

		<!-- Block that edits an override: the accent marker on the left resets the override when clicked.
			 The marker and the body are gated by the block visibility flag, so a collapsed block
			 (marker included) occupies no space. -->
		<DataTemplate x:DataType="cards:IAddonCardBlockChange">
			<Grid ColumnDefinitions="3,Auto" ColumnSpacing="6"
						IsVisible="{Binding IsExpanded}">
				<Button Grid.Column="0"
								BorderBrush="{DynamicResource PrimaryAccentBrush}"
								Background="{DynamicResource PrimaryAccentBrush}"
								CornerRadius="1"
								VerticalAlignment="Stretch"
								Margin="0,2"
								Command="{Binding ResetCommand}"
								IsEnabled="{Binding IsChanged}"
								ToolTip.Tip="{loc:Loc common.reset}"/>
				<ContentControl Grid.Column="1"
											Content="{Binding}"
											ContentTemplate="{StaticResource AddonCardBlockTemplate}"/>
			</Grid>
		</DataTemplate>

		<!-- Block: the common block template renders the body and owns the visibility gate. -->
		<DataTemplate x:DataType="cards:IAddonCardBlock">
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource AddonCardBlockTemplate}"/>
		</DataTemplate>

		<!-- Action button. IsEnabled is driven by Command.CanExecute. -->
		<DataTemplate x:DataType="cards:IAddonCardAction">
			<Button Classes="SmallIconButton"
							Command="{Binding Command}"
							CommandParameter="{Binding CommandParameter}"
							ToolTip.Tip="{loc:Loc {Binding ToolTip}}">
				<ico:VisualIcon Kind="{Binding Icon}"/>
			</Button>
		</DataTemplate>

	</UserControl.DataTemplates>

	<!-- ================================================================ -->
	<!-- Card                                                             -->
	<!-- ================================================================ -->
	<Border Classes="addonCard" Classes.group="{Binding HasChildren}">
		<StackPanel Orientation="Vertical" Spacing="4">

			<!-- ============================================================== -->
			<!-- Row 0: header (left slots | icon + name | right slots | reset) -->
			<!-- ============================================================== -->
			<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center" ColumnSpacing="4"
									PointerPressed="Header_PointerPressed">

				<!-- Group expander -->
				<ToggleButton Grid.Column="0"
											Classes="cardExpander"
											IsVisible="{Binding HasChildren}"
											IsChecked="{Binding IsChildrenExpanded, Mode=TwoWay}"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc card.group.expand}">
					<Panel>
						<ico:VisualIcon Kind="ChevronRight" Width="16" Height="16"
												  IsVisible="{Binding !IsChildrenExpanded}"/>
						<ico:VisualIcon Kind="ChevronDown" Width="16" Height="16"
												  IsVisible="{Binding IsChildrenExpanded}"/>
					</Panel>
				</ToggleButton>

				<ItemsControl Grid.Column="1"
											ItemsSource="{Binding LeftHeaderElements}"
											IsVisible="{Binding LeftHeaderElements.Count}"
											VerticalAlignment="Center">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="4"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>

				<!-- Name + optional subtitle -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<ico:VisualIcon Kind="{Binding Icon}"
													  Foreground="{DynamicResource PrimaryAccentBrush}"
													  Width="20" Height="20"
													  VerticalAlignment="Center"/>
					<TextBlock Text="{loc:Loc {Binding NamePrefix}}"
									   FontWeight="Bold"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"
									   Foreground="{Binding NamePrefixBrush, TargetNullValue=White}"
									   IsVisible="{Binding HasNamePrefix}"/>
					<TextBlock Text="{loc:Loc {Binding Name}}"
									   FontWeight="Bold"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"/>
					<TextBlock Text="{loc:Loc {Binding Subtitle}}"
									   FontSize="11"
									   Opacity="0.6"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"
									   IsVisible="{Binding HasSubtitle}"/>
				</StackPanel>

				<ItemsControl Grid.Column="3"
											ItemsSource="{Binding RightHeaderElements}"
											IsVisible="{Binding RightHeaderElements.Count}"
											VerticalAlignment="Center">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="4"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>

				<!-- Reset override button -->
				<Button Grid.Column="4"
								Command="{Binding ResetCommand}"
								HorizontalAlignment="Center"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc common.reset}"
								IsEnabled="{Binding HasChanges}">
					<ico:VisualIcon Kind="Refresh"/>
				</Button>

			</Grid>

			<!-- ============================================================ -->
			<!-- Row 1: description                                           -->
			<!-- ============================================================ -->
			<TextBlock Text="{loc:Loc {Binding Description}}"
							   Opacity="0.7"
							   FontSize="12"
							   TextWrapping="Wrap"
							   Margin="28,0,0,0"
							   IsVisible="{Binding HasDescription}"/>

			<!-- ============================================================ -->
			<!-- Row 2: chips                                                 -->
			<!-- ============================================================ -->
			<ItemsControl ItemsSource="{Binding Chips}"
										IsVisible="{Binding Chips.Count}"
										Margin="28,0,0,0">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>

			<!-- ============================================================ -->
			<!-- Row 3: inline blocks                                         -->
			<!-- ============================================================ -->
			<ItemsControl ItemsSource="{Binding Blocks}"
										IsVisible="{Binding Blocks.Count}"
										Margin="28,0,0,0"/>

			<!-- ============================================================ -->
			<!-- Row 4: action row (left content | right actions)             -->
			<!-- ============================================================ -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
						Margin="28,0,0,0">

				<ItemsControl Grid.Column="0"
											ItemsSource="{Binding ActionRowElements}"
											IsVisible="{Binding ActionRowElements.Count}"
											VerticalAlignment="Center">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="6"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

					<ItemsControl ItemsSource="{Binding Actions}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="2"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>

					<!-- One toggle button per collapsible block (e.g. parameters). -->
					<ItemsControl ItemsSource="{Binding CollapsibleBlocks}"
												IsVisible="{Binding CollapsibleBlocks.Count}"
												ItemTemplate="{StaticResource AddonCardCollapsibleToggleTemplate}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="2"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>

					<!-- Details toggle (shown only when there are detail blocks). -->
					<ToggleButton Classes="SmallIconButton"
												IsVisible="{Binding HasDetails}"
												IsChecked="{Binding IsDetailsVisible, Mode=TwoWay}"
												ToolTip.Tip="{loc:Loc card.details}">
						<ico:VisualIcon Kind="CardAccountDetailsOutline" Width="14" Height="14"/>
					</ToggleButton>

				</StackPanel>
			</Grid>

			<!-- ============================================================ -->
			<!-- Row 5: collapsible block contents                            -->
			<!-- ============================================================ -->
			<ItemsControl ItemsSource="{Binding CollapsibleBlocks}"
										IsVisible="{Binding CollapsibleBlocks.Count}"
										Margin="28,0,0,0"/>

			<!-- ============================================================ -->
			<!-- Row 6: detail blocks                                         -->
			<!-- ============================================================ -->
			<ItemsControl ItemsSource="{Binding DetailBlocks}"
										IsVisible="{Binding IsDetailsVisible}"
										Margin="28,0,0,0"/>
			
			<!-- ============================================================ -->
			<!-- Row 7: Children (group cards only)                           -->
			<!-- ============================================================ -->
			<Border IsVisible="{Binding IsChildrenExpanded}"
							Margin="28,4,0,0"
							Padding="0,2,0,2"
							BorderThickness="2,0,0,0"
							BorderBrush="{DynamicResource SecondaryAccentBrush}">
				<ItemsControl ItemsSource="{Binding Children}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Vertical"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ContentControl Content="{Binding}" IsVisible="{Binding IsVisible}"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>

		</StackPanel>
	</Border>
</UserControl>
