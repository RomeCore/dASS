<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
			 xmlns:local="using:LLMDesktopAssistant.Agents.Memory.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.Agents.Memory.MVVM.MemoryBlockFactsView"
			 x:DataType="local:MemoryBlockFactsViewModel">

	<DockPanel>

		<!-- Search -->
		<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
			<TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
					 PlaceholderText="{loc:Loc settings.memory.facts.search.placeholder}"/>
			<NumericUpDown Grid.Column="1"
						   Value="{Binding MinImportance, Mode=TwoWay}"
						   Minimum="0"
						   Maximum="1"
						   Increment="0.05"
						   FormatString="0.00"
						   Width="90"
						   VerticalAlignment="Center"
						   ToolTip.Tip="{loc:Loc settings.memory.facts.min_importance.tooltip}"/>
			<Button Grid.Column="2"
					Command="{Binding SearchCommand}"
					Content="{loc:Loc settings.memory.facts.search.action}"/>
		</Grid>

		<!-- Add / Clear -->
		<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,2,0,6">

			<Button Command="{Binding AddFactCommand}"
					Classes="AccentButton"
					Content="{loc:Loc settings.memory.facts.add.action}"/>

			<TextBlock Grid.Column="1"
					   Text="{loc:Loc settings.memory.facts.hint}"
					   Opacity="0.5"
					   FontSize="12"
					   VerticalAlignment="Center"
					   TextWrapping="Wrap"/>

			<Button Grid.Column="2"
					Command="{Binding ClearFactsCommand}"
					Content="{loc:Loc settings.memory.facts.clear.action}"
					Foreground="{DynamicResource DangerBrush}"
					VerticalAlignment="Center"/>

		</Grid>

		<!-- Results -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="2">

				<TextBlock Text="{loc:Loc settings.memory.facts.empty}"
						   Opacity="0.5"
						   IsVisible="{Binding HasResults, Converter={StaticResource InverseBooleanConverter}}"/>

				<ItemsControl ItemsSource="{Binding SearchResults}">

					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:MemoryFactItemViewModel">
							<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="0,0,0,1"
									Padding="4,4">

								<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">

									<StackPanel Grid.Column="0" Spacing="2">
										<TextBlock Text="{Binding Text}"
												   TextWrapping="Wrap"/>
										<TextBlock Text="{Binding Scores}"
												   FontSize="11"
												   Opacity="0.6"/>
										<TextBlock Text="{Binding CreatedAt}"
												   FontSize="11"
												   Opacity="0.4"/>
									</StackPanel>

									<Button Grid.Column="1"
											Command="{Binding SupersedeCommand}"
											Classes="IconButton"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc settings.memory.fact.supersede.tooltip}">
										<ico:VisualIcon Kind="SwapHorizontal"/>
									</Button>

									<Button Grid.Column="2"
											Command="{Binding DeleteCommand}"
											Classes="IconButton"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc settings.memory.fact.delete.action}">
										<ico:VisualIcon Kind="Delete"/>
									</Button>

								</Grid>

							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>

				</ItemsControl>

			</StackPanel>
		</ScrollViewer>

	</DockPanel>

</UserControl>
