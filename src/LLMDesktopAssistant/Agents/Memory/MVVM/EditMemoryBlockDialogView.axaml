<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
			 xmlns:local="using:LLMDesktopAssistant.Agents.Memory.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
			 xmlns:beh="using:LLMDesktopAssistant.Controls.Behaviours"
			 x:Class="LLMDesktopAssistant.Agents.Memory.MVVM.EditMemoryBlockDialogView"
			 x:DataType="local:EditMemoryBlockDialogViewModel"
			 beh:DialogLayoutBehaviour.DialogMargin="100">

	<DockPanel>

		<!-- Header: dialog title and close button -->
		<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,8,10,4">

			<StackPanel Orientation="Horizontal" Spacing="8">
				<ico:VisualIcon Kind="Database" Width="20" Height="20"
								  VerticalAlignment="Center"
								  Foreground="{DynamicResource PrimaryAccentBrush}"/>
				<TextBlock Text="{loc:Loc settings.memory.block.editor.title}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>
			</StackPanel>

			<Button Grid.Column="1"
					Command="{Binding CloseCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc common.close}">
				<ico:VisualIcon Kind="Close"/>
			</Button>

		</Grid>

		<Grid ColumnDefinitions="180,4,*" DockPanel.Dock="Top">

			<TreeView ItemsSource="{Binding Sections}"
					  SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
					  BorderThickness="0"
					  Margin="4">

				<TreeView.DataTemplates>

					<DataTemplate x:DataType="local:EditMemoryBlockSection">
						<StackPanel Orientation="Horizontal" Spacing="6" Margin="4,3">
							<ico:VisualIcon Kind="{Binding Icon}"
											  Width="16" Height="16"
											  VerticalAlignment="Center"
											  Opacity="0.8"/>
							<TextBlock Text="{Binding DisplayName}"
									   VerticalAlignment="Center"/>
						</StackPanel>
					</DataTemplate>

				</TreeView.DataTemplates>

			</TreeView>

			<GridSplitter Grid.Column="1"
						  Width="4"
						  ResizeDirection="Columns"
						  HorizontalAlignment="Stretch"/>

			<ContentControl Grid.Column="2"
							Content="{Binding SelectedSection.ViewModel}"
							Margin="6"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Stretch">

					<ContentControl.DataTemplates>

						<!-- Block information section: the edit form of the dialog itself -->
						<DataTemplate x:DataType="local:EditMemoryBlockDialogViewModel">
							<ScrollViewer VerticalScrollBarVisibility="Auto">

								<StackPanel Orientation="Vertical" Spacing="10"
											HorizontalAlignment="Stretch">

									<!-- Block ID + management -->
									<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
											BorderThickness="1"
											CornerRadius="4"
											Padding="8">
										<StackPanel Spacing="6">

											<StackPanel Orientation="Horizontal" Spacing="8">

												<TextBlock Text="{loc:Loc settings.memory.block.id.label}"
														   FontWeight="Medium"
														   VerticalAlignment="Center"/>

												<TextBlock Text="{Binding BlockId}"
														   Opacity="0.7"
														   FontSize="12"
														   VerticalAlignment="Center"
														   TextTrimming="CharacterEllipsis"
														   ToolTip.Tip="{Binding BlockId}"/>

											</StackPanel>

											<WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
												<Button Command="{Binding RenameCommand}"
														Content="{loc:Loc settings.memory.rename.action}"/>
												<Button Command="{Binding DuplicateCommand}"
														Content="{loc:Loc settings.memory.duplicate.action}"/>
												<Button Command="{Binding ClearCommand}"
														Content="{loc:Loc settings.memory.clear.action}"
														Foreground="{DynamicResource DangerBrush}"/>
												<Button Command="{Binding DeleteCommand}"
														Content="{loc:Loc settings.memory.delete.action}"
														Foreground="{DynamicResource DangerBrush}"/>
											</WrapPanel>

											<!-- Rename editor -->
											<StackPanel Orientation="Horizontal"
														Spacing="4"
														IsVisible="{Binding IsEditingId}">

												<TextBox MinWidth="160"
														 VerticalAlignment="Center"
														 Text="{Binding NewId}"/>

												<Button Command="{Binding ConfirmRenameCommand}"
														Classes="IconButton"
														ToolTip.Tip="{loc:Loc settings.memory.rename.confirm.tooltip}">
													<ico:VisualIcon Kind="Check"/>
												</Button>

												<Button Command="{Binding CancelRenameCommand}"
														Classes="IconButton"
														ToolTip.Tip="{loc:Loc common.cancel}">
													<ico:VisualIcon Kind="Cancel"/>
												</Button>

											</StackPanel>

										</StackPanel>
									</Border>

									<!-- Name -->
									<StackPanel Orientation="Vertical" Spacing="4">
										<TextBlock Text="{loc:Loc settings.memory.block.name.label}"
												   FontWeight="Medium"/>
										<TextBox Text="{Binding Block.Name, Mode=TwoWay}"/>
									</StackPanel>

									<!-- Description -->
									<StackPanel Orientation="Vertical" Spacing="4">
										<TextBlock Text="{loc:Loc settings.memory.block.description.label}"
												   FontWeight="Medium"/>
										<TextBox Text="{Binding Block.Description, Mode=TwoWay}"
												 AcceptsReturn="True"
												 MinHeight="70"
												 TextWrapping="Wrap"/>
									</StackPanel>

									<!-- Storage -->
									<StackPanel Orientation="Vertical" Spacing="4">
										<TextBlock Text="{loc:Loc settings.memory.block.storage.label}"
												   FontWeight="Medium"/>
										<CheckBox Content="{loc:Loc settings.memory.block.facts.label}"
												  IsChecked="{Binding Block.FactsEnabled, Mode=TwoWay}"/>
										<CheckBox Content="{loc:Loc settings.memory.block.logs.label}"
												  IsChecked="{Binding Block.LogsEnabled, Mode=TwoWay}"/>
									</StackPanel>

									<!-- Models -->
									<StackPanel Orientation="Vertical" Spacing="4">
										<TextBlock Text="{loc:Loc settings.memory.block.embedding_model.label}"
												   FontWeight="Medium"/>
										<ctrl:ModelSelectorControl SelectedModel="{Binding Block.EmbeddingModel, Mode=TwoWay}"/>
									</StackPanel>

									<StackPanel Orientation="Vertical" Spacing="4">
										<TextBlock Text="{loc:Loc settings.memory.block.maintainer_model.label}"
												   FontWeight="Medium"/>
										<ctrl:ModelSelectorControl SelectedModel="{Binding Block.MaintainerModel, Mode=TwoWay}"/>
									</StackPanel>

								</StackPanel>

							</ScrollViewer>
						</DataTemplate>

				</ContentControl.DataTemplates>

			</ContentControl>

		</Grid>

	</DockPanel>

</UserControl>
