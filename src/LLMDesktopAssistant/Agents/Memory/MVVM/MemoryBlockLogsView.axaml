<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="400"
			 xmlns:local="using:LLMDesktopAssistant.Agents.Memory.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.Agents.Memory.MVVM.MemoryBlockLogsView"
			 x:DataType="local:MemoryBlockLogsViewModel">

	<DockPanel>

		<!-- Search -->
		<StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">

			<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">

				<ToggleButton IsChecked="{Binding IsTimeSearch, Mode=TwoWay}"
							  Content="{loc:Loc settings.memory.logs.search.by_time.label}"
							  VerticalAlignment="Center"/>

				<TextBox Grid.Column="1"
						 Text="{Binding SearchQuery, Mode=TwoWay}"
						 PlaceholderText="{loc:Loc settings.memory.logs.search.placeholder}"
						 IsVisible="{Binding IsTimeSearch, Converter={StaticResource InverseBooleanConverter}}"/>

				<NumericUpDown Grid.Column="2"
							   Value="{Binding MinImportance, Mode=TwoWay}"
							   Minimum="0"
							   Maximum="1"
							   Increment="0.05"
							   FormatString="0.00"
							   Width="90"
							   VerticalAlignment="Center"
							   ToolTip.Tip="{loc:Loc settings.memory.logs.min_importance.tooltip}"/>

				<Button Grid.Column="3"
						Command="{Binding SearchCommand}"
						Content="{loc:Loc settings.memory.logs.search.action}"/>

			</Grid>

			<!-- Time search windows -->
			<StackPanel Spacing="4"
						IsVisible="{Binding IsTimeSearch}">

				<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="6">

					<StackPanel Spacing="4">

						<Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
							<TextBlock Text="{loc:Loc settings.memory.logs.from.label}"
									   VerticalAlignment="Center"/>
							<DatePicker Grid.Column="1"
										SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
							<TextBlock Grid.Column="2"
									   Text="{loc:Loc settings.memory.logs.to.label}"
									   VerticalAlignment="Center"/>
							<DatePicker Grid.Column="3"
										SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
							<TextBlock Text="{loc:Loc settings.memory.logs.from.label}"
									   VerticalAlignment="Center"/>
							<TimePicker Grid.Column="1"
										SelectedTime="{Binding FromTime, Mode=TwoWay}"/>
							<TextBlock Grid.Column="2"
									   Text="{loc:Loc settings.memory.logs.to.label}"
									   VerticalAlignment="Center"/>
							<TimePicker Grid.Column="3"
										SelectedTime="{Binding ToTime, Mode=TwoWay}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
							<TextBlock Text="{loc:Loc settings.memory.logs.ordinal.from.label}"
									   VerticalAlignment="Center"/>
							<NumericUpDown Grid.Column="1"
										   Value="{Binding TimeLineFrom, Mode=TwoWay}"/>
							<TextBlock Grid.Column="2"
									   Text="{loc:Loc settings.memory.logs.ordinal.to.label}"
									   VerticalAlignment="Center"/>
							<NumericUpDown Grid.Column="3"
										   Value="{Binding TimeLineTo, Mode=TwoWay}"/>
						</Grid>

					</StackPanel>

				</Border>

			</StackPanel>

		</StackPanel>

		<!-- Add / Clear -->
		<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,2,0,6">

			<Button Command="{Binding AddLogCommand}"
					Classes="AccentButton"
					Content="{loc:Loc settings.memory.logs.add.action}"/>

			<TextBlock Grid.Column="1"
					   Text="{loc:Loc settings.memory.logs.hint}"
					   Opacity="0.5"
					   FontSize="12"
					   VerticalAlignment="Center"
					   TextWrapping="Wrap"/>

			<Button Grid.Column="2"
					Command="{Binding ClearLogsCommand}"
					Content="{loc:Loc settings.memory.logs.clear.action}"
					Foreground="{DynamicResource DangerBrush}"
					VerticalAlignment="Center"/>

		</Grid>

		<!-- Results -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="2">

				<TextBlock Text="{loc:Loc settings.memory.logs.empty}"
						   Opacity="0.5"
						   IsVisible="{Binding HasResults, Converter={StaticResource InverseBooleanConverter}}"/>

				<ItemsControl ItemsSource="{Binding SearchResults}">

					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:MemoryLogItemViewModel">
							<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="0,0,0,1"
									Padding="4,4">

								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">

									<StackPanel Grid.Column="0" Spacing="2">
										<TextBlock Text="{Binding Text}"
												   TextWrapping="Wrap"/>
										<StackPanel Orientation="Horizontal" Spacing="8">
											<TextBlock Text="{Binding TimeStampBegin}"
													   FontSize="11"
													   Opacity="0.4"/>
											<TextBlock Text="{Binding Timeline}"
													   FontSize="11"
													   Opacity="0.6"
													   IsVisible="{Binding Timeline, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>
											<TextBlock Text="{Binding Bm25Score}"
													   FontSize="11"
													   Opacity="0.6"/>
										</StackPanel>
									</StackPanel>

									<Button Grid.Column="1"
											Command="{Binding DeleteCommand}"
											Classes="IconButton"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc settings.memory.log.delete.action}">
										<ico:VisualIcon Kind="Delete"/>
									</Button>

								</Grid>

							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>

				</ItemsControl>

			</StackPanel>
		</ScrollViewer>

	</DockPanel>

</UserControl>
