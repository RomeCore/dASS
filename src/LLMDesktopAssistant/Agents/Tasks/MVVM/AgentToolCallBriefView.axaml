<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:local="using:LLMDesktopAssistant.Agents.Tasks.MVVM"
						 xmlns:consents="using:LLMDesktopAssistant.Tools.Consents"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:settings="using:LLMDesktopAssistant.LLM.MVVM.Settings"
						 mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="60"
						 x:Class="LLMDesktopAssistant.Agents.Tasks.MVVM.AgentToolCallBriefView"
						 x:DataType="local:AgentToolCallBriefViewModel">
	
	<Border Padding="6,4" CornerRadius="4"
					Margin="0,1"
					IsVisible="{Binding !IsCompleted}"
					Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">

		<StackPanel Spacing="4">

			<!-- Main row: icon + tool name + status + behaviour flags -->
			<WrapPanel Orientation="Horizontal" ItemSpacing="4">

				<!-- Status icon -->
				<Panel Width="18" Height="18" VerticalAlignment="Center">
						<ico:VisualIcon Kind="{Binding StatusIcon}"
															Width="18" Height="18"/>
				</Panel>

				<!-- Tool name -->
				<TextBlock Text="{loc:Loc {Binding ToolDisplayName}}"
									 FontSize="12" FontWeight="Medium"
									 VerticalAlignment="Center"
									 TextTrimming="CharacterEllipsis"/>

				<!-- Status text -->
				<TextBlock Text="{Binding StatusText}"
									 FontSize="11"
									 Opacity="0.55"
									 VerticalAlignment="Center"/>

				<!-- Behaviour flags (compact icons) -->
				<ItemsControl ItemsSource="{Binding BehaviourFlags}"
											IsVisible="{Binding IsConfirming}"
											VerticalAlignment="Center">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="2"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="settings:ToolBehaviourFlagInfo">
							<Panel>
								<ToolTip.Tip>
									<StackPanel Orientation="Vertical" Spacing="4">
										<TextBlock Text="{loc:Loc {Binding DisplayName}}"
										           FontSize="{DynamicResource FontSizeM}"
										           FontWeight="SemiBold"/>
										<TextBlock Text="{loc:Loc {Binding Description}}"/>
									</StackPanel>
								</ToolTip.Tip>
								<ico:VisualIcon Kind="{Binding Icon}"
								                  Foreground="{Binding Color}"
								                  Width="12" Height="12"/>
							</Panel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</WrapPanel>

			<!-- Arguments preview (compact, one line) -->
			<DockPanel HorizontalSpacing="2"
								 IsVisible="{Binding Arguments, Converter={StaticResource StringNonEmptyToBooleanConverter}}">
			
				<Button Classes="MiniIconButton"
								DockPanel.Dock="Left">

					<ico:VisualIcon Kind="CodeBraces"/>
					
					<Button.Flyout>
						<Flyout>
							<ctrl:MarkdownControl MarkdownText="{Binding Arguments}"
																		MaxWidth="540"
																		Margin="10"/>
						</Flyout>
					</Button.Flyout>

				</Button>
			
				<TextBlock Text="{Binding Arguments}"
									 FontSize="11"
									 Opacity="0.5"
									 TextTrimming="CharacterEllipsis"
									 MaxLines="1"/>
			
			</DockPanel>

			<!-- Result preview (compact, one line) -->
			<DockPanel HorizontalSpacing="2"
								 IsVisible="{Binding HasResult}">
			
				<Button Classes="MiniIconButton"
								DockPanel.Dock="Left">

					<ico:VisualIcon Kind="CommentTextOutline"/>
					
					<Button.Flyout>
						<Flyout>
							<ctrl:MarkdownControl MarkdownText="{Binding Result}"
																		UsePlaintext="True"
																		MaxWidth="540"
																		Margin="10"/>
						</Flyout>
					</Button.Flyout>

				</Button>
			
				<TextBlock Text="{Binding Result}"
									 FontSize="11"
									 Opacity="0.5"
									 TextTrimming="CharacterEllipsis"
									 MaxLines="1"/>
			
			</DockPanel>

			<!-- Confirmation controls: reject/approve + note + remember -->
			<consents:ToolConsentPanel IsVisible="{Binding ShowConfirmButtons}"
																 ResolveConsentCommand="{Binding ConsentCommand}"/>

		</StackPanel>

	</Border>

</UserControl>
