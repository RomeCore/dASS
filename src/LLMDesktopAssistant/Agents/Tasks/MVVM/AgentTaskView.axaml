<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:local="using:LLMDesktopAssistant.Agents.Tasks.MVVM"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						 xmlns:beh="using:LLMDesktopAssistant.Controls.Behaviours"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
						 x:Class="LLMDesktopAssistant.Agents.Tasks.MVVM.AgentTaskView"
						 x:DataType="local:AgentTaskViewModel">
	
	<UserControl.Styles>
		<Style Selector="FlyoutPresenter">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="MaxWidth" Value="755"/>
			<Setter Property="MaxHeight" Value="655"/>
			<Setter Property="MinWidth" Value="205"/>
			<Setter Property="MinHeight" Value="105"/>
		</Style>
	</UserControl.Styles>

		<Button Padding="10,6" CornerRadius="6"
					Margin="0,2"
					Background="{Binding StatusBackground}"
					BorderBrush="Transparent"
					Command="{Binding ShowDetailsCommand}">

		<StackPanel>

			<Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Left" MaxWidth="400">

				<!-- Status indicator: ProgressRing when running, icon otherwise -->
				<Panel Width="20" Height="20"
							 Margin="0,0,10,0"
							 VerticalAlignment="Center"
							 Grid.Column="0">

					<ctrl:ProgressRing IsVisible="{Binding IsRunning}"
														 IsIndeterminate="True"
														 Width="20" Height="20"
														 StrokeThickness="3"
														 Foreground="{DynamicResource PrimaryAccentBrush}"/>

					<ico:VisualIcon Kind="{Binding StatusIcon}"
														Width="20" Height="20"
														IsVisible="{Binding !IsRunning}"/>

				</Panel>

				<!-- Main content -->
				<StackPanel VerticalAlignment="Center"
										Grid.Column="1">

					<!-- Task name -->
					<TextBlock Text="{Binding TaskName, TargetNullValue={loc:Loc task.unnamed}}"
										 FontSize="13" FontWeight="Medium"
										 TextTrimming="CharacterEllipsis"
										 MaxLines="1"/>

					<!-- Status text + confirmation indicator -->
					<WrapPanel Orientation="Horizontal" ItemSpacing="4">

						<TextBlock Text="{Binding StatusText}"
											 FontSize="11"
											 Opacity="0.6"
											 Margin="0,2,0,0"/>

						<!-- Confirmation needed indicator -->
						<Border IsVisible="{Binding HasConfirmingToolCalls}"
										Background="#F44336"
										CornerRadius="3"
										Padding="4,1"
										Margin="0,2,0,0">
							<TextBlock Text="{loc:Loc task.confirmation_needed}"
												 FontSize="10"
												 Foreground="White"
												 FontWeight="Bold"/>
						</Border>

					</WrapPanel>
					
					<!-- Last content preview -->
					<DockPanel HorizontalSpacing="2"
										 IsVisible="{Binding LastContent, Converter={StaticResource StringNonEmptyToBooleanConverter}}">
		
						<Button Classes="MiniIconButton"
										DockPanel.Dock="Left">

							<ico:VisualIcon Kind="Info"/>
			
							<Button.Flyout>
								<Flyout>
									<ctrl:MarkdownControl MarkdownText="{Binding LastContent}"
																				MaxWidth="540"
																				Margin="10"/>
								</Flyout>
							</Button.Flyout>

						</Button>
		
						<TextBlock Text="{Binding LastContent}"
											 FontSize="11"
											 Opacity="0.65"
											 TextTrimming="CharacterEllipsis"
											 MaxLines="1"
											 IsVisible="{Binding LastContent, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>
		
					</DockPanel>

				</StackPanel>

				<!-- Right side: summary + cancel + expand -->
				<StackPanel Orientation="Horizontal"
										VerticalAlignment="Center"
										Spacing="6"
										Grid.Column="2">

					<TextBlock Text="{Binding Summary}"
										 FontSize="11"
										 Opacity="0.55"
										 VerticalAlignment="Center"/>

					<Button Classes="SmallIconButton"
									Command="{Binding CancelCommand}"
									IsVisible="{Binding IsRunning}"
									ToolTip.Tip="{loc:Loc task.cancel}">
						<ico:VisualIcon Kind="Stop" Width="14" Height="14"/>
					</Button>

					<ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
												IsVisible="{Binding SubTaskViewModels.Any}"
												Classes="SmallIconButton"
												ToolTip.Tip="{loc:Loc task.toggle_subtasks}">
						<ico:VisualIcon Kind="ChevronDown" Width="14" Height="14"/>
					</ToggleButton>

				</StackPanel>

			</Grid>

			<!-- Tool calls -->
			<ItemsControl ItemsSource="{Binding ToolCallViewModels}"
										IsVisible="{Binding ToolCallViewModels.Any}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ContentControl Content="{Binding}"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Sub-tasks (recursive) -->
			<ItemsControl ItemsSource="{Binding SubTaskViewModels}"
										IsVisible="{Binding IsExpanded}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						 <ContentControl Content="{Binding}" Margin="20,0,0,0"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>

	</Button>

</UserControl>
