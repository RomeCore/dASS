@template core_prompt
{
	@metadata
	{
		lang: 'iv'
	}
	@if prompt
	{
		@prompt
	}
	@foreach component in components
	{
		@component
	}
	@if persona
	{
		<persona>
		@persona
		</persona>
	}
	@if specialization
	{
		<specialization>
		@specialization
		</specialization>
	}
	@if persona && specialization
	{
		Integrate your personality with your specialization naturally.
		Your personality defines who you are, your specialization defines what you do.
	}
	@if assistant_nickname
	{
		Your alternate name is:
		@assistant_nickname
	}
	@if skills
	{
		<available_skills>
			The following skills provide specialized instructions for specific tasks.
			When a task matches a skill's description, call the `skill-load` tool
			with the skill's name to load its full instructions.
			@foreach skill in skills
			{
				<skill>
					<name>@skill.name</name>
					<description>@skill.description</description>
					@if skill.path
					{
						<location>@skill.path</location>
					}
					@if skill.body
					{
						<body>@skill.body</body>
					}
				</skill>
			}
		</available_skills>
	}
	@if sub_agents
	{
		<sub_agents>
			The following sub-agents are available to assist with specific tasks.
			If a task matches a sub-agent's description, call the `agent-callsub` tool
			@foreach sub_agent in sub_agents
			{
				<sub_agent>
					<name>@sub_agent.name</name>
					<description>@sub_agent.description</description>
				</sub_agent>
			}
		</sub_agents>
	}
	@if memory_blocks
	{
		<memory_blocks>
			The following memory blocks provide context for the conversation.
			You can access these blocks by calling the `memory-*` tools (if available).
			@foreach block in memory_blocks
			{
				<block>
					<name>@block.name</name>
					<description>@block.description</description>
					@if block.can_read && block.can_write
					{
						<access>read-write</access>
					}
					else if block.can_read
					{
						<access>read-only</access>
					}
					else if block.can_write
					{
						<access>write-only</access>
					}
					else
					{
						<access>none</access>
					}
					@if block.facts_enabled && block.logs_enabled
					{
						<types>facts,logs</types>
					}
					else if block.facts_enabled
					{
						<types>facts</types>
					}
					else if block.logs_enabled
					{
						<types>logs</types>
					}
					else
					{
						<types>none</types>
					}
				</block>
			}
		</memory_blocks>
	}
}

@template reminder_system_section
{
	@metadata
	{
		lang: 'iv'
	}
	You will receive <system-reminder>...</system-reminder> tags with your's behaviour and context changes.
	These tags are authoritative and you should follow them if they provide changes to your instructions.
	For example: if you receive something like "Your new persona: <...>" inside these tags, forget your previous persona and apply new.
	If you receive diff of instructions
}

@template system_slot_system_section
{
	@metadata
	{
		lang: 'iv'
	}
	@if prompt
	{
		@prompt
	}
	@foreach component in components
	{
		@component
	}
}

@template identity_system_section
{
	@metadata
	{
		lang: 'iv'
	}
	@if persona
	{
		<persona>
		@persona
		</persona>
	}
	@if specialization
	{
		<specialization>
		@specialization
		</specialization>
	}
	@if persona && specialization
	{
		Integrate your personality with your specialization naturally.
		Your personality defines who you are, your specialization defines what you do.
	}
	@if assistant_nickname
	{
		Your alternate name is:
		@assistant_nickname
	}
}

@template identity_system_section_delta
{
	@metadata
	{
		lang: 'iv'
	}
	@if persona_changed
	{
		@if persona
		{
			Your new persona is:
			<persona>
			@persona
			</persona>
		}
		else
		{
			<persona>
			None
			</persona>
			Forget your previous persona.
		}
	}
	@if specialization_changed
	{
		@if specialization
		{
			Your new specialization is:
			<specialization>
			@specialization
			</specialization>
		}
		else
		{
			<specialization>
			None
			</specialization>
			Forget your previous specialization.
		}
	}
	@if assistant_nickname_changed
	{
		@if assistant_nickname
		{
			Your new nickname is: @assistant_nickname
		}
		else
		{
			Forget your previous nickname.
		}
	}
}

