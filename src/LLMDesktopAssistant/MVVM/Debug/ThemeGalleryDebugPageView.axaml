<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:local="using:LLMDesktopAssistant.MVVM.Debug"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:txt="using:LLMDesktopAssistant.Controls.Text"
						 xmlns:scroll="using:LLMDesktopAssistant.Controls.Scrolling"
						 mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
						 x:Class="LLMDesktopAssistant.MVVM.Debug.ThemeGalleryDebugPageView"
						 x:DataType="local:ThemeGalleryDebugPageViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="{DynamicResource FontSizeL}" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="{DynamicResource FontSizeS}" />
			<Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
		</Style>
	</UserControl.Styles>

	<DockPanel Margin="8">

		<Border DockPanel.Dock="Top"
						BorderBrush="{DynamicResource BorderDefault}"
						BorderThickness="0,0,0,1"
						Padding="0,0,0,6"
						Margin="0,0,0,8">
			<TextBlock Text="{Binding Summary}"
								 FontSize="{DynamicResource FontSizeS}"
								 Foreground="{DynamicResource TextTertiary}"
								 TextWrapping="Wrap" />
		</Border>

		<scroll:SmoothScrollViewer VerticalScrollBarVisibility="Auto"
															 BringIntoViewOnFocusChange="False">
			<StackPanel Spacing="18">
				
				<!-- Buttons -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.buttons}" />

				<WrapPanel ItemSpacing="8" LineSpacing="8">
					<Button Content="Default" />
					<Button Classes="accent" Content="Accent" />
					<Button Classes="ghost" Content="Ghost" />
					<Button Classes="danger" Content="Danger" />
					<Button IsEnabled="False" Content="Disabled" />
					<Button IsEnabled="False" Classes="accent" Content="Disabled accent" />
				</WrapPanel>

				<WrapPanel ItemSpacing="4" LineSpacing="8">
					<Button Classes="icon accent" ToolTip.Tip="Add">
						<ico:VisualIcon Kind="Plus" />
					</Button>
					<Button Classes="icon" ToolTip.Tip="Search">
						<ico:VisualIcon Kind="Magnify" />
					</Button>
					<Button Classes="icon" ToolTip.Tip="Delete">
						<ico:VisualIcon Kind="DeleteOutline" />
					</Button>
					<Button Classes="icon" ToolTip.Tip="More">
						<ico:VisualIcon Kind="DotsHorizontal" />
					</Button>
					<Button Classes="ghost">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<ico:VisualIcon Kind="Check" />
							<TextBlock Text="Ghost with icon" />
						</StackPanel>
					</Button>
				</WrapPanel>
				
				<WrapPanel ItemSpacing="4" LineSpacing="8">
					<Button Classes="icon small accent" ToolTip.Tip="Add">
						<ico:VisualIcon Kind="Plus" />
					</Button>
					<Button Classes="icon small" ToolTip.Tip="Search">
						<ico:VisualIcon Kind="Magnify" />
					</Button>
					<Button Classes="icon small" ToolTip.Tip="Delete">
						<ico:VisualIcon Kind="DeleteOutline" />
					</Button>
					<Button Classes="icon small" ToolTip.Tip="More">
						<ico:VisualIcon Kind="DotsHorizontal" />
					</Button>
				</WrapPanel>
				
				<WrapPanel ItemSpacing="4" LineSpacing="8">
					<Button Classes="icon mini accent" ToolTip.Tip="Add">
						<ico:VisualIcon Kind="Plus" />
					</Button>
					<Button Classes="icon mini" ToolTip.Tip="Search">
						<ico:VisualIcon Kind="Magnify" />
					</Button>
					<Button Classes="icon mini" ToolTip.Tip="Delete">
						<ico:VisualIcon Kind="DeleteOutline" />
					</Button>
					<Button Classes="icon mini" ToolTip.Tip="More">
						<ico:VisualIcon Kind="DotsHorizontal" />
					</Button>
				</WrapPanel>
				
				<WrapPanel ItemSpacing="4" LineSpacing="8">
					<Button Classes="icon large accent" ToolTip.Tip="Add">
						<ico:VisualIcon Kind="Plus" />
					</Button>
					<Button Classes="icon large" ToolTip.Tip="Search">
						<ico:VisualIcon Kind="Magnify" />
					</Button>
					<Button Classes="icon large" ToolTip.Tip="Delete">
						<ico:VisualIcon Kind="DeleteOutline" />
					</Button>
					<Button Classes="icon large" ToolTip.Tip="More">
						<ico:VisualIcon Kind="DotsHorizontal" />
					</Button>
				</WrapPanel>

				<TextBlock Classes="hint" Text="RepeatButton (fires while held)" Margin="0,6,0,0" />
				<WrapPanel ItemSpacing="8" LineSpacing="8">
					<RepeatButton Content="Hold to repeat" />
					<RepeatButton Classes="accent" Content="Accent" />
					<RepeatButton Classes="ghost" Content="Ghost" />
					<RepeatButton Classes="danger" Content="Danger" />
					<RepeatButton Classes="icon" ToolTip.Tip="Icon">
						<ico:VisualIcon Kind="Plus" />
					</RepeatButton>
					<RepeatButton Content="Disabled" IsEnabled="False" />
				</WrapPanel>
				
				<Separator />

				<!-- Toggle buttons -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.toggle_buttons}" />

				<WrapPanel ItemSpacing="8" LineSpacing="8">
					<ToggleButton Content="Off" />
					<ToggleButton Content="On" IsChecked="True" />
					<ToggleButton Classes="solid" Content="Solid off" />
					<ToggleButton Classes="solid" Content="Solid on" IsChecked="True" />
					<ToggleButton IsEnabled="False" Content="Disabled on" IsChecked="True" />
				</WrapPanel>

				<StackPanel Orientation="Horizontal" Spacing="12">
					<Border Background="{DynamicResource PanelBackground}"
									CornerRadius="{DynamicResource RadiusM}"
									Padding="2"
									HorizontalAlignment="Left">
						<StackPanel Orientation="Horizontal" Spacing="2">
							<ToggleButton Classes="segment" IsChecked="True" ToolTip.Tip="Bold">
								<ico:VisualIcon Kind="FormatBold" />
							</ToggleButton>
							<ToggleButton Classes="segment" ToolTip.Tip="Italic">
								<ico:VisualIcon Kind="FormatItalic" />
							</ToggleButton>
							<ToggleButton Classes="segment" ToolTip.Tip="Underline">
								<ico:VisualIcon Kind="FormatUnderline" />
							</ToggleButton>
						</StackPanel>
					</Border>

					<StackPanel Orientation="Horizontal" Spacing="4">
						<ToggleButton Classes="icon" IsChecked="True" ToolTip.Tip="Star">
							<ico:VisualIcon Kind="Star" />
						</ToggleButton>
						<ToggleButton Classes="icon" ToolTip.Tip="Lock">
							<ico:VisualIcon Kind="Lock" />
						</ToggleButton>
						<ToggleButton Classes="icon" ToolTip.Tip="Eye">
							<ico:VisualIcon Kind="Eye" />
						</ToggleButton>
					</StackPanel>
				</StackPanel>
				
				<Separator />

				<!-- Checks and radios -->

				<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
					<StackPanel Spacing="6">
						<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.checks}" />
						<CheckBox Content="Checked" IsChecked="True" />
						<CheckBox Content="Unchecked" />
						<CheckBox Content="Indeterminate" IsChecked="{x:Null}" />
						<CheckBox Content="Disabled checked" IsChecked="True" IsEnabled="False" />
						<CheckBox Content="Disabled" IsEnabled="False" />
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="6">
						<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.radios}" />
						<RadioButton GroupName="gallery-density" Content="Checked" IsChecked="True" />
						<RadioButton GroupName="gallery-density" Content="Unchecked" />
						<RadioButton GroupName="gallery-density" Content="Disabled" IsEnabled="False" />
					</StackPanel>
				</Grid>
				
				<Separator />

				<!-- Switches -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.switches}" />

				<StackPanel Orientation="Horizontal" Spacing="16">
					<ToggleSwitch IsChecked="True" />
					<ToggleSwitch />
					<ToggleSwitch IsChecked="True" IsEnabled="False" />
				</StackPanel>
				
				<Separator />

				<!-- Inputs -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.inputs}" />

				<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
					<StackPanel Spacing="6">
						<TextBlock Classes="hint" Text="TextBox" />
						<TextBox Text="dASS desktop assistant" />
						<TextBox PlaceholderText="Add a short description..." />
						<TextBox PasswordChar="&#x25CF;" Text="s3cret-token" />
						<TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="72"
										 Text="A multiline field shares the same frame, radius and focus colour." />
						<TextBox IsEnabled="False" Text="Not editable" />

						<TextBlock Classes="hint" Text="TextBox.nochrome (host owns the frame)" Margin="0,6,0,0" />
						<Border Background="{DynamicResource PanelBackground}"
										BorderBrush="{DynamicResource BorderDefault}"
										BorderThickness="1"
										CornerRadius="{DynamicResource RadiusM}"
										Padding="6,0">
							<TextBox Classes="nochrome" PlaceholderText="Search..." />
						</Border>
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="6">
						<TextBlock Classes="hint" Text="ComboBox" />
						<ComboBox SelectedIndex="2">
							<ComboBoxItem Content="claude-sonnet-4.5" />
							<ComboBoxItem Content="gpt-5.1" />
							<ComboBoxItem Content="deepseek-v3.2" />
						</ComboBox>
						<ComboBox PlaceholderText="Pick a model">
							<ComboBoxItem Content="claude-sonnet-4.5" />
							<ComboBoxItem Content="claude-sonnet-5.5" />
							<ComboBoxItem Content="gpt-5.1" />
							<ComboBoxItem Content="gpt-6-sol" />
						</ComboBox>
						<ComboBox IsEditable="True" Text="custom-model-id" PlaceholderText="Type or pick">
							<ComboBoxItem Content="claude-sonnet-4.5" />
							<ComboBoxItem Content="gpt-5.1" />
						</ComboBox>
						<ComboBox IsEnabled="False" SelectedIndex="0">
							<ComboBoxItem Content="claude-sonnet-4.5" />
						</ComboBox>

						<TextBlock Classes="hint" Text="NumericUpDown" Margin="0,6,0,0" />
						<NumericUpDown Minimum="0" Maximum="100" Value="42" Increment="1" />
						<NumericUpDown Minimum="0" Maximum="1000" Value="128" ShowButtonSpinner="False" />
						<NumericUpDown IsEnabled="False" Value="7" />

						<TextBlock Classes="hint" Text="HighlightTextBox" Margin="0,6,0,0" />
						<txt:HighlightTextBox Text="ls -la /home/user" />
						<txt:HighlightTextBox PlaceholderText="Type a shell command..." />
					</StackPanel>
				</Grid>
				
				<Separator />

				<!-- Ranges -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.ranges}" />

				<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
					<StackPanel Spacing="6">
						<TextBlock Classes="hint" Text="Slider" />
						<Slider Minimum="0" Maximum="100" Value="62" />
						<Slider Minimum="0" Maximum="1" Value="0.25" />
						<Slider IsEnabled="False" Value="40" />

						<TextBlock Classes="hint" Text="ProgressBar" Margin="0,6,0,0" />
						<ProgressBar Minimum="0" Maximum="100" Value="62" />
						<ProgressBar Minimum="0" Maximum="100" Value="94" Foreground="{DynamicResource StatusSuccessBase}" />
						<ProgressBar IsIndeterminate="True" />
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="6">
						<TextBlock Classes="hint" Text="ScrollViewer + ScrollBar" />
						<Border Height="150"
										Background="{DynamicResource CardBackground}"
										BorderBrush="{DynamicResource BorderSubtle}"
										BorderThickness="1"
										CornerRadius="{DynamicResource RadiusM}">
							<scroll:SmoothScrollViewer VerticalScrollBarVisibility="Auto">
								<StackPanel Margin="10" Spacing="6">
									<TextBlock Text="Line 01" />
									<TextBlock Text="Line 02" />
									<TextBlock Text="Line 03" />
									<TextBlock Text="Line 04" />
									<TextBlock Text="Line 05" />
									<TextBlock Text="Line 06" />
									<TextBlock Text="Line 07" />
									<TextBlock Text="Line 08" />
									<TextBlock Text="Line 09" />
									<TextBlock Text="Line 10" />
									<TextBlock Text="Line 11" />
									<TextBlock Text="Line 12" />
									<TextBlock Text="Again!" />
									<TextBlock Text="Line 01" />
									<TextBlock Text="Line 02" />
									<TextBlock Text="Line 03" />
									<TextBlock Text="Line 04" />
									<TextBlock Text="Line 05" />
									<TextBlock Text="Line 06" />
									<TextBlock Text="Line 07" />
									<TextBlock Text="Line 08" />
									<TextBlock Text="Line 09" />
									<TextBlock Text="Line 10" />
									<TextBlock Text="Line 11" />
									<TextBlock Text="Line 12" />
								</StackPanel>
							</scroll:SmoothScrollViewer>
						</Border>

						<TextBlock Classes="hint" Text="AutoCompleteBox" Margin="0,6,0,0" />
						<AutoCompleteBox PlaceholderText="Type a model..." ItemsSource="{Binding AutocompleteItems}"/>
					</StackPanel>
				</Grid>
				
				<Separator />

				<!-- Collections -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.collections}" />

				<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
					<StackPanel Spacing="6">
						<TextBlock Classes="hint" Text="ListBox" />
						<Border Background="{DynamicResource PanelBackground}"
										CornerRadius="{DynamicResource RadiusM}"
										Padding="4">
							<ListBox SelectedIndex="1">
								<ListBoxItem Content="claude-sonnet-4.5" />
								<ListBoxItem Content="gpt-5.1" />
								<ListBoxItem Content="deepseek-v3.2" />
								<ListBoxItem Content="Disabled" IsEnabled="False" />
							</ListBox>
						</Border>
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="6">
						<TextBlock Classes="hint" Text="TreeView" />
						<Border Background="{DynamicResource PanelBackground}"
										CornerRadius="{DynamicResource RadiusM}"
										Padding="4">
							<TreeView>
								<TreeViewItem Header="Agents" IsExpanded="True">
									<TreeViewItem Header="Chat agents" IsSelected="True" />
									<TreeViewItem Header="Sub-agents">
										<TreeViewItem Header="web-searcher" />
									</TreeViewItem>
								</TreeViewItem>
								<TreeViewItem Header="Tools" />
								<TreeViewItem Header="Disabled" IsEnabled="False" />
							</TreeView>
						</Border>
					</StackPanel>
				</Grid>
				
				<Separator />

				<TabControl SelectedIndex="0" Margin="0,4,0,0">
					<TabItem Header="General">
						<TextBlock Text="The selected tab is a card on the trough; the pipe variant is not used."
										 Classes="hint" />
					</TabItem>
					<TabItem Header="Advanced">
						<TextBlock Text="Tabs wrap when the strip runs out of width." Classes="hint" />
					</TabItem>
					<TabItem Header="Disabled" IsEnabled="False">
						<TextBlock Text="Disabled tab." Classes="hint" />
					</TabItem>
				</TabControl>
				
				<Separator />

				<!-- Surfaces -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.surfaces}" />

				<Grid ColumnDefinitions="*,8,*" Height="72">
					<Border Background="{DynamicResource PanelBackground}"
									CornerRadius="{DynamicResource RadiusM}" />
					<GridSplitter Grid.Column="1"
										Background="{DynamicResource BorderSubtle}"
										ResizeDirection="Columns" />
					<Border Grid.Column="2"
									Background="{DynamicResource PanelBackground}"
									CornerRadius="{DynamicResource RadiusM}" />
				</Grid>
				
				<Separator />

				<Expander Header="Expander - collapsible section">
					<TextBlock Classes="hint"
										 Text="The header is a keyed ToggleButton: the chevron rotates, the app-wide toggle theme does not leak in." />
				</Expander>

				<Separator />

				<WrapPanel ItemSpacing="8" LineSpacing="8">
					<Button Content="Hover for a tooltip"
									ToolTip.Tip="A popup card with a hairline and a shadow." />
					<Button Classes="ghost"
									Content="Ghost with tooltip"
									ToolTip.Tip="Same surface, no frame." />
				</WrapPanel>
				
				<Separator />

				<!-- Menus -->

				<Menu HorizontalAlignment="Left">
					<MenuItem Header="File">
						<MenuItem Header="New" InputGesture="Ctrl+N" />
						<MenuItem Header="Open..." InputGesture="Ctrl+O" />
						<MenuItem Header="Recent">
							<MenuItem Header="chat-theme-rework.md" />
							<MenuItem Header="handoff.md" />
						</MenuItem>
						<Separator />
						<MenuItem Header="Exit" InputGesture="Alt+F4" />
					</MenuItem>
					<MenuItem Header="View">
						<MenuItem Header="Compact" ToggleType="Radio" IsChecked="True" />
						<MenuItem Header="Comfortable" ToggleType="Radio" />
						<Separator />
						<MenuItem Header="Show sidebar" ToggleType="CheckBox" IsChecked="True" />
						<MenuItem Header="Disabled" IsEnabled="False" />
					</MenuItem>
					<MenuItem Header="Help">
						<MenuItem Header="Documentation" />
					</MenuItem>
				</Menu>

				<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
					<Border Background="{DynamicResource PanelBackground}"
									CornerRadius="{DynamicResource RadiusM}"
									Padding="12">
						<Border.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Copy" InputGesture="Ctrl+C" />
								<MenuItem Header="Duplicate" InputGesture="Ctrl+D" />
								<Separator />
								<MenuItem Header="Delete" InputGesture="Delete" />
							</ContextMenu>
						</Border.ContextMenu>
						<TextBlock Classes="hint" Text="Right-click for a ContextMenu" />
					</Border>

					<Button Grid.Column="1"
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Content="MenuFlyout">
						<Button.Flyout>
							<MenuFlyout>
								<MenuItem Header="First" />
								<MenuItem Header="Second" InputGesture="Ctrl+2" />
								<MenuItem Header="Nested">
									<MenuItem Header="Leaf" />
								</MenuItem>
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</Grid>
				
				<Separator />

				<WrapPanel ItemSpacing="12" LineSpacing="8">
					<HyperlinkButton Content="HyperlinkButton" />

					<DropDownButton Content="DropDownButton">
						<DropDownButton.Flyout>
							<MenuFlyout>
								<MenuItem Header="First action" />
								<MenuItem Header="Second action" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>

					<SplitButton Content="SplitButton">
						<SplitButton.Flyout>
							<MenuFlyout>
								<MenuItem Header="Run with defaults" />
								<MenuItem Header="Run with options..." />
							</MenuFlyout>
						</SplitButton.Flyout>
					</SplitButton>
				</WrapPanel>
				
				<Separator />

				<GroupBox Header="GroupBox">
					<TextBlock Classes="hint"
									 Text="A caption above a framed panel; no opacity mask and no gap-cutting converter." />
				</GroupBox>
				
				<Separator />

				<!-- Roles -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.roles}" />

				<WrapPanel ItemSpacing="8" LineSpacing="8">
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource WindowBackground}" ToolTip.Tip="WindowBackground" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource PanelBackground}" ToolTip.Tip="PanelBackground" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource CardBackground}" ToolTip.Tip="CardBackground" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource ControlBackgroundPressed}" ToolTip.Tip="ControlBackgroundPressed" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource BorderDefault}" ToolTip.Tip="BorderDefault" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource PrimaryBase}" ToolTip.Tip="PrimaryBase" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource PrimarySubtle}" ToolTip.Tip="PrimarySubtle" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource AccentBase}" ToolTip.Tip="AccentBase" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource StatusSuccessBase}" ToolTip.Tip="StatusSuccessBase" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource StatusWarningBase}" ToolTip.Tip="StatusWarningBase" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource StatusErrorBase}" ToolTip.Tip="StatusErrorBase" />
					<Border Width="80" Height="40" CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource StatusDangerBase}" ToolTip.Tip="StatusDangerBase" />
				</WrapPanel>
				
				<Separator />

				<!-- Rungs -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.rungs}" />

				<StackPanel Spacing="4">
					<TextBlock Classes="hint" Text="Light" />
					<ItemsControl ItemsSource="{Binding LightRungs}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel ItemSpacing="4" LineSpacing="4" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ThemeSwatch">
								<Border Width="26" Height="26"
												CornerRadius="{DynamicResource RadiusS}"
												Background="{Binding Brush}"
												ToolTip.Tip="{Binding Name}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Classes="hint" Text="Dark" />
					<ItemsControl ItemsSource="{Binding DarkRungs}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel ItemSpacing="4" LineSpacing="4" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ThemeSwatch">
								<Border Width="26" Height="26"
												CornerRadius="{DynamicResource RadiusS}"
												Background="{Binding Brush}"
												ToolTip.Tip="{Binding Name}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
				
				<Separator />

				<!-- Type scale -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.typography}" />

				<ItemsControl ItemsSource="{Binding TypeSamples}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:ThemeTypeSample">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,2">
								<TextBlock Grid.Column="0"
													 Width="40"
													 Text="{Binding Name}"
													 Classes="hint"
													 VerticalAlignment="Center" />
								<TextBlock Grid.Column="1"
													 Text="{Binding Sample}"
													 FontSize="{Binding Size}"
													 LineHeight="{Binding LineHeight}" />
								<TextBlock Grid.Column="2"
													 Text="{Binding Details}"
													 Classes="hint"
													 VerticalAlignment="Center" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				
				<Separator />

				<!-- Radii -->

				<TextBlock Classes="section" Text="{loc:Loc debug.theme_gallery.radii}" />

				<ItemsControl ItemsSource="{Binding RadiusSamples}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="12" LineSpacing="12" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:ThemeRadiusSample">
							<StackPanel Spacing="4">
								<Border Width="64" Height="40"
												Background="{DynamicResource CardBackground}"
												BorderBrush="{DynamicResource BorderDefault}"
												BorderThickness="1"
												CornerRadius="{Binding Radius}" />
								<TextBlock Text="{Binding Name}" Classes="hint" />
								<TextBlock Text="{Binding Details}" Classes="hint" />
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>
		</scroll:SmoothScrollViewer>

	</DockPanel>

</UserControl>
