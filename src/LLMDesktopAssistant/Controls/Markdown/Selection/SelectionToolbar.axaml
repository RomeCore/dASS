<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:sel="using:LLMDesktopAssistant.Controls.Markdown.Selection"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="40"
			 x:Class="LLMDesktopAssistant.Controls.Markdown.Selection.SelectionToolbar"
			 x:CompileBindings="False">

	<UserControl.Styles>
		<Style Selector="Border.selectionToolbar">
			<Setter Property="Background" Value="{DynamicResource InputCompletionPopupBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource InputCompletionPopupBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="3" />
			<Setter Property="BoxShadow" Value="0 4 12 0 #33000000" />
		</Style>
		<Style Selector="Button.selectionToolbarItem">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="6" />
			<Setter Property="Focusable" Value="False" />
		</Style>
		<Style Selector="Button.selectionToolbarItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource InputCompletionPopupSelectedBrush}" />
		</Style>
	</UserControl.Styles>

	<!--
		The toolbar must never take the keyboard focus: the markdown text block clears its selection on focus
		loss, so a focusable button would erase the very selection it acts on. Every interactive element is
		therefore Focusable="False" - the click still works, the focus never moves.
	-->
	<Popup x:Name="ToolbarPopup"
		   Placement="Top"
		   PlacementConstraintAdjustment="FlipY"
		   VerticalOffset="-6"
		   IsLightDismissEnabled="True"
		   Focusable="False">
		<Border Classes="selectionToolbar">
			<ItemsControl ItemsSource="{Binding Items}" Focusable="False">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" Spacing="2" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button Classes="selectionToolbarItem"
								Command="{Binding Command}"
								CommandParameter="{Binding Processor}"
								ToolTip.Tip="{loc:Loc {Binding Title}}">
							<ico:VisualIcon Kind="{Binding Icon}" Width="16" Height="16" />
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>
	</Popup>
</UserControl>
