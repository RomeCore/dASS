<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:md="using:LiveMarkdown.Avalonia"
			 xmlns:sel="using:LLMDesktopAssistant.Controls.Markdown.Selection"
			 xmlns:theming="using:LLMDesktopAssistant.Styles.Theming"
			 x:Class="LLMDesktopAssistant.Controls.MarkdownControl">

	<!-- The Markdown copy of the type scale shadows the application one below this control only. -->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<theming:MarkdownTypographyProvider/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Panel>
		<md:MarkdownRenderer x:Name="MarkdownRenderer"/>
		<md:MarkdownTextBlock x:Name="MarkdownTextBlock"/>
		<sel:SelectionToolbar x:Name="SelectionToolbar"/>
	</Panel>

</UserControl>
