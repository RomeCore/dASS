<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:LLMDesktopAssistant.Providers"
             xmlns:loc="using:LLMDesktopAssistant.Localization"
             xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="400"
             x:Class="LLMDesktopAssistant.Providers.ManageModifiersDialogView"
             x:DataType="local:ManageModifiersDialogViewModel"
             Name="VMRoot">

  <StackPanel Orientation="Vertical" Spacing="8" Margin="16" Width="520" MinHeight="300">

    <!-- Header -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <ico:VisualIcon Kind="Tune" Width="20" Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryAccentBrush}"/>
      <TextBlock Text="{loc:Loc model.modifier.manage.title}"
                 FontSize="{DynamicResource FontSizeL}"
                 FontWeight="Bold"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Toolbar -->
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4"
                HorizontalAlignment="Left">
      <Button Command="{Binding AddCommand}"
              Classes="Primary">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ico:VisualIcon Kind="AddCircle" Width="14" Height="14"/>
          <TextBlock Text="{loc:Loc model.modifier.add}"/>
        </StackPanel>
      </Button>

      <Button Command="{Binding EditCommand}"
              IsEnabled="{Binding IsModifierSelected}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ico:VisualIcon Kind="Edit" Width="14" Height="14"/>
          <TextBlock Text="{loc:Loc model.modifier.edit}"/>
        </StackPanel>
      </Button>

      <Button Command="{Binding DeleteCommand}"
              IsEnabled="{Binding IsModifierSelected}"
              Classes="Danger">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ico:VisualIcon Kind="Delete" Width="14" Height="14"/>
          <TextBlock Text="{loc:Loc model.modifier.delete}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Modifier list -->
    <ListBox ItemsSource="{Binding Modifiers}"
             SelectedItem="{Binding SelectedModifier, Mode=TwoWay}"
             MinHeight="200">
      <ListBox.DataTemplates>
        <DataTemplate x:DataType="local:ModelModifier">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="4,3" ColumnSpacing="4">
            <ico:VisualIcon Kind="Tune"
                              Width="18" Height="18"
                              VerticalAlignment="Center"
                              Opacity="0.7"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       FontWeight="Medium"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding Hint}"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Opacity="0.7"/>
            <Button Grid.Column="4"
                    Classes="IconButton"
                    Command="{Binding #VMRoot.DataContext.MoveUpCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{loc:Loc model.modifier.move_up}">
              <ico:VisualIcon Kind="ArrowUp"/>
            </Button>
            <Button Grid.Column="5"
                    Classes="IconButton"
                    Command="{Binding #VMRoot.DataContext.MoveDownCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{loc:Loc model.modifier.move_down}">
              <ico:VisualIcon Kind="ArrowDown"/>
            </Button>
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>

    <!-- Close button -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{loc:Loc common.close}"
              Command="{Binding CloseCommand}"/>
    </StackPanel>

  </StackPanel>

</UserControl>
