<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:LLMDesktopAssistant.Providers"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="600"
			 x:Class="LLMDesktopAssistant.Providers.ConfigureModelProviderDialogView"
			 x:DataType="local:ConfigureModelProviderDialogViewModel"
			 Name="VMRoot">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Orientation="Vertical" Spacing="10" Margin="20" Width="520">

			<!-- Header -->
			<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
				<ico:VisualIcon Kind="Settings" Width="20" Height="20"
									VerticalAlignment="Center"
									Foreground="{DynamicResource PrimaryAccentBrush}"/>
				<TextBlock Text="{loc:Loc settings.provider.add.title}"
							 FontSize="{DynamicResource FontSizeL}"
							 FontWeight="Bold"
							 VerticalAlignment="Center"/>
			</StackPanel>

			<!-- Name -->
			<StackPanel Orientation="Vertical" Spacing="4">
				<TextBlock Text="{loc:Loc settings.provider.name.label}"/>
				<TextBox Text="{Binding EditingProvider.Name, Mode=TwoWay}"
						 PlaceholderText="{loc:Loc settings.provider.name.placeholder}"/>
			</StackPanel>

			<!-- Provider Type -->
			<StackPanel Orientation="Vertical" Spacing="4">
				<TextBlock Text="{loc:Loc settings.provider.type.label}"/>
				<ComboBox ItemsSource="{Binding ProviderTypes}"
							SelectedItem="{Binding SelectedProviderType, Mode=TwoWay}"
							PlaceholderText="{loc:Loc settings.provider.type.label}">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="local:ProviderTypeItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>

			<!-- Endpoint URI -->
			<StackPanel Orientation="Vertical" Spacing="4">
				<TextBlock Text="{loc:Loc settings.provider.endpoint.label}"/>
				<TextBox Text="{Binding EditingProvider.EndpointUri, Mode=TwoWay}"
						 PlaceholderText="{loc:Loc settings.provider.endpoint.placeholder}"/>
			</StackPanel>

			<!-- API Key -->
			<StackPanel Orientation="Vertical" Spacing="4">
				<TextBlock Text="{loc:Loc settings.provider.apikey.label}"/>
				<ctrl:ApiKeySelectorControl ApiKeyId="{Binding EditingProvider.ApiKeyId, Mode=TwoWay}"/>
			</StackPanel>

			<!-- Test Connection + Refresh Models -->
			<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
				<Button Command="{Binding TestConnectionCommand}"
						Classes="Primary">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<ico:VisualIcon Kind="Link" Width="16" Height="16"/>
						<TextBlock Text="{loc:Loc settings.provider.test_connection}"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding LoadModelsCommand}">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<ico:VisualIcon Kind="Refresh" Width="16" Height="16"/>
						<TextBlock Text="{loc:Loc model.selector.refresh}"/>
					</StackPanel>
				</Button>

				<TextBlock Text="{Binding ConnectionTestResult}"
							 VerticalAlignment="Center"
							 FontWeight="Medium"
							 Margin="4,0,0,0"/>
			</StackPanel>

			<!-- Model list -->
			<StackPanel Orientation="Vertical" Spacing="4">
			
				<Separator Margin="0,4"/>
			
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="{loc:Loc model.selector.available_models}"
								 FontWeight="Bold"
								 FontSize="{DynamicResource FontSizeL}"
								 VerticalAlignment="Center"/>
				
					<Button Command="{Binding SelectAllCommand}"
							Classes="IconButton"
							ToolTip.Tip="{loc:Loc model.selector.select_all}">
						<ico:VisualIcon Kind="SelectAll" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding DeselectAllCommand}"
							Classes="IconButton"
							ToolTip.Tip="{loc:Loc model.selector.deselect_all}">
						<ico:VisualIcon Kind="SelectOff" Width="14" Height="14"/>
					</Button>
				</StackPanel>

				<Border BorderBrush="{DynamicResource DefaultForeground}"
								BorderThickness="1"
								CornerRadius="4"
								MaxHeight="300">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding AvailableModels}"
													Margin="5,5,20,10">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ModelCheckboxItem">

									<Panel>
								
										<Border BorderThickness="0,0,0,1"
														BorderBrush="{DynamicResource DefaultForeground}"
														Opacity="0.3"
														Padding="4"/>
									
										<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
													ColumnSpacing="6">
									
											<CheckBox Grid.Column="0"
																IsChecked="{Binding IsSelected, Mode=TwoWay}"
																VerticalAlignment="Center"/>
									
											<StackPanel Grid.Column="1" Orientation="Vertical"
																	IsVisible="{Binding DisplayName, Converter={StaticResource StringNonEmptyToBooleanConverter}}">
												<TextBlock Text="{Binding DisplayName}"
																	 ToolTip.Tip="{Binding DisplayName}"
																	 TextTrimming="CharacterEllipsis"
																	 FontWeight="Medium"/>
												<TextBlock Text="{Binding Model.Name}"
																	 ToolTip.Tip="{Binding Model.Name}"
																	 TextTrimming="CharacterEllipsis"
																	 FontSize="{DynamicResource FontSizeS}"
																	 Opacity="0.6"/>
											</StackPanel>
									
											<TextBlock Grid.Column="1" 
																 Text="{Binding Model.Name}"
																 ToolTip.Tip="{Binding Model.Name}"
																 TextTrimming="CharacterEllipsis"
																 IsVisible="{Binding DisplayName, Converter={StaticResource StringNonEmptyToBooleanConverterInverted}}"/>
									
											<!-- Input Modalities icons -->
											<StackPanel Grid.Column="2" Orientation="Vertical"
																	VerticalAlignment="Center">
												<TextBlock Text="{loc:Loc model.modality.in}"
															 FontSize="10"
															 Opacity="0.4"
															 HorizontalAlignment="Center"/>
												<ItemsControl ItemsSource="{Binding InputModalityFlags}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<WrapPanel ItemSpacing="2"/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="local:ModelModalityFlagInfo">
															<Panel ToolTip.Tip="{Binding DisplayName}"
																		 Background="Transparent">
																<ico:VisualIcon Kind="{Binding Icon}"
																									Foreground="{Binding Color}"
																									Width="12" Height="12"/>
															</Panel>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
									
											<!-- Output Modalities icons -->
											<StackPanel Grid.Column="3" Orientation="Vertical"
																	VerticalAlignment="Center">
												<TextBlock Text="{loc:Loc model.modality.out}"
															 FontSize="10"
															 Opacity="0.4"
															 HorizontalAlignment="Center"/>
												<ItemsControl ItemsSource="{Binding OutputModalityFlags}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<WrapPanel ItemSpacing="2"/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="local:ModelModalityFlagInfo">
															<Panel ToolTip.Tip="{Binding DisplayName}"
																		 Background="Transparent">
																<ico:VisualIcon Kind="{Binding Icon}"
																									Foreground="{Binding Color}"
																									Width="12" Height="12"/>
															</Panel>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
									
											<!-- Capabilities icons -->
											<StackPanel Grid.Column="4" Orientation="Vertical"
																	VerticalAlignment="Center">
												<TextBlock Text="{loc:Loc model.capability.label}"
															 FontSize="10"
															 Opacity="0.4"
															 HorizontalAlignment="Center"/>
												<ItemsControl ItemsSource="{Binding CapabilityFlags}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<WrapPanel ItemSpacing="2"/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="local:ModelCapabilityFlagInfo">
															<Panel ToolTip.Tip="{Binding DisplayName}"
																		 Background="Transparent">
																<ico:VisualIcon Kind="{Binding Icon}"
																									Foreground="{Binding Color}"
																									Width="12" Height="12"/>
															</Panel>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Grid>

									</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
			</StackPanel>

			<!-- Custom models -->
			<StackPanel Orientation="Vertical" Spacing="4">

				<Separator Margin="0,4"/>

				<TextBlock Text="{loc:Loc settings.provider.custom.title}"
							 FontWeight="Bold"
							 FontSize="{DynamicResource FontSizeL}"
							 VerticalAlignment="Center"/>

				<TextBlock Text="{loc:Loc settings.provider.custom.hint}"
							 FontSize="{DynamicResource FontSizeS}"
							 Opacity="0.6"
							 TextWrapping="Wrap"/>

				<!-- Add custom model form -->
				<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
					<TextBox Text="{Binding CustomModelName, Mode=TwoWay}"
							 Width="220"
							 PlaceholderText="{loc:Loc settings.provider.custom.name.placeholder}"/>
					<TextBox Text="{Binding CustomModelDisplayName, Mode=TwoWay}"
							 Width="180"
							 PlaceholderText="{loc:Loc settings.provider.custom.displayname.placeholder}"/>
					<Button Command="{Binding AddCustomModelCommand}"
							Classes="Primary"
							VerticalAlignment="Stretch">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ico:VisualIcon Kind="Add" Width="14" Height="14"/>
							<TextBlock Text="{loc:Loc settings.provider.custom.add}"/>
						</StackPanel>
					</Button>
				</StackPanel>

				<TextBlock Text="{Binding CustomModelError}"
							 Foreground="Red"
							 FontSize="{DynamicResource FontSizeS}"
							 IsVisible="{Binding CustomModelError, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

				<!-- Custom model list -->
				<Border BorderBrush="{DynamicResource DefaultForeground}"
							 BorderThickness="1"
							 CornerRadius="4"
							 MaxHeight="200"
							 IsVisible="{Binding HasCustomModels}">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding CustomModels}"
											Margin="5,5,20,10">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ModelDescriptor">
									<Panel>

										<Border BorderThickness="0,0,0,1"
												BorderBrush="{DynamicResource DefaultForeground}"
												Opacity="0.3"
												Padding="4"/>

										<Grid ColumnDefinitions="*,Auto"
													ColumnSpacing="6">

											<StackPanel Grid.Column="0" Orientation="Vertical"
														IsVisible="{Binding DisplayName, Converter={StaticResource StringNonEmptyToBooleanConverter}}">
												<TextBlock Text="{Binding DisplayName}"
														 ToolTip.Tip="{Binding DisplayName}"
														 TextTrimming="CharacterEllipsis"
														 FontWeight="Medium"/>
												<TextBlock Text="{Binding Name}"
														 ToolTip.Tip="{Binding Name}"
														 TextTrimming="CharacterEllipsis"
														 FontSize="{DynamicResource FontSizeS}"
														 Opacity="0.6"/>
											</StackPanel>

											<TextBlock Grid.Column="0"
														 Text="{Binding Name}"
														 ToolTip.Tip="{Binding Name}"
														 TextTrimming="CharacterEllipsis"
														 IsVisible="{Binding DisplayName, Converter={StaticResource StringNonEmptyToBooleanConverterInverted}}"/>

											<Button Grid.Column="1"
													Classes="IconButton"
													Command="{Binding #VMRoot.DataContext.RemoveCustomModelCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="{loc:Loc settings.provider.custom.remove.tooltip}"
													VerticalAlignment="Center">
												<ico:VisualIcon Kind="Delete" Width="14" Height="14"/>
											</Button>

										</Grid>
									</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>

				<TextBlock Text="{loc:Loc settings.provider.custom.empty}"
							 FontSize="{DynamicResource FontSizeS}"
							 Opacity="0.6"
							 IsVisible="{Binding !HasCustomModels}"/>

			</StackPanel>

			<!-- Buttons -->
			<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right"
									Spacing="8"
									Margin="0,16,0,0">

				<Button Content="{loc:Loc common.close}"
								Command="{Binding CloseCommand}"
								Classes="Primary"/>

			</StackPanel>

		</StackPanel>
	</ScrollViewer>

</UserControl>
