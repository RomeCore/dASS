<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>0.2.0</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>LLMDesktopAssistant</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
	  <AvaloniaXaml Remove="Styles\Avalonia.Themes.Fluent\**" />
	  <Compile Remove="Settings\Objects\**" />
	  <Compile Remove="Styles\Avalonia.Themes.Fluent\**" />
	  <EmbeddedResource Remove="Settings\Objects\**" />
	  <EmbeddedResource Remove="Styles\Avalonia.Themes.Fluent\**" />
	  <None Remove="Settings\Objects\**" />
	  <None Remove="Styles\Avalonia.Themes.Fluent\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Prompting\Resources\ru-RU\components.llt" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\Fonts\*.ttf" />
		<AvaloniaResource Include="Assets\icon.ico" />
		<EmbeddedResource Include="Assets\TextMate\**\*.json" />
		<EmbeddedResource Include="Prompting\Resources\**\*.llt" />
		<EmbeddedResource Include="Localization\Resources\**\*.loc" />
		<EmbeddedResource Include="..\..\docs\help\**\*.md" Visible="False" LogicalName="HelpDocs.%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
		<AvaloniaResource Include="..\..\docs\help\**\*.png" Visible="False" Link="Assets\help\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LLMDesktopAssistant.SourceGenerators\LLMDesktopAssistant.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AsyncLua" Version="0.5.1" />
		<PackageReference Include="Avalonia" Version="12.1.0" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
		<PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="DetectSecretsSharp" Version="1.3.0" />
		<PackageReference Include="DialogHost.Avalonia" Version="0.12.2" />
		<PackageReference Include="LiveMarkdown.Avalonia" Version="2.4.3" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.5.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="LLTSharp" Version="1.6.0" />
		<PackageReference Include="Markdig" Version="1.4.0" />
		<PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.6.0" />

		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="ModelContextProtocol" Version="1.4.1" />
		<PackageReference Include="PdfPig" Version="0.1.15" />
		<PackageReference Include="RCLLM" Version="0.7.5" />
		<PackageReference Include="RCParsing" Version="5.3.1" />
		<PackageReference Include="ReverseMarkdown" Version="6.1.0" />
		<PackageReference Include="SearXSharp" Version="1.1.1" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="WebReaper" Version="11.3.1" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

