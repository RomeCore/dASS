<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
						 xmlns:add="using:LLMDesktopAssistant.LLM.MVVM.Additional.Chat"
						 xmlns:layout="using:LLMDesktopAssistant.Controls.Layout"
						 xmlns:scroll="using:LLMDesktopAssistant.Controls.Scrolling"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:loc="clr-namespace:LLMDesktopAssistant.Localization"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatOverlayHostView"
						 x:DataType="local:ChatOverlayHostViewModel">

	<UserControl.Styles>

		<Style Selector="Border.overlayWindow">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="{DynamicResource RadiusM}"/>
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="BoxShadow" Value="0 4 20 0 #33000000"/>
		</Style>

		<!-- The whole header is the drag handle, so it looks like one. -->
		<Style Selector="Border.overlayHeader">
			<Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource RadiusTopM}"/>
			<Setter Property="Padding" Value="8,2"/>
			<Setter Property="Cursor" Value="SizeAll"/>
		</Style>

		<!-- Quiet chrome: the buttons are there, they just do not compete with the payload until used. -->
		<Style Selector="Button.overlayButton">
			<Setter Property="Opacity" Value="0.45"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="Border.overlayHeader:pointerover Button.overlayButton">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="Button.overlayButton:pointerover">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<!-- The resize grip is quiet like the header buttons: it shows itself only under the pointer. -->
		<Style Selector="ico|VisualIcon.overlayGrip">
			<Setter Property="Opacity" Value="0.4"/>
		</Style>

		<Style Selector="ico|VisualIcon.overlayGrip:pointerover">
			<Setter Property="Opacity" Value="1"/>
		</Style>

	</UserControl.Styles>

	<Panel>

		<ItemsControl Classes="overlays"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									ItemsSource="{Binding Windows}">

			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<layout:FractionPanel/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="add:AdditionalChatDataOverlayItem">

					<!--
						The fractions and the stacking order live here, on the template root: the panel reads them off this
						element instead of off the content presenter the items control wraps around it.
					-->
					<Border Classes="overlayWindow"
									IsVisible="{Binding IsWindowShown}"
									ZIndex="{Binding Z}"
									layout:FractionPanel.RelativeLeft="{Binding Left}"
									layout:FractionPanel.RelativeTop="{Binding Top}"
									layout:FractionPanel.RelativeWidth="{Binding EffectiveWidth}"
									layout:FractionPanel.RelativeHeight="{Binding EffectiveHeight}">

						<Grid RowDefinitions="Auto,*">

							<Border Grid.Row="0"
											Classes="overlayHeader"
											PointerPressed="OnHeaderPointerPressed">

								<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

									<StackPanel Grid.Column="0"
															Orientation="Horizontal"
															Margin="2,0,8,0"
															Spacing="6">
										
										<ico:VisualIcon Kind="{Binding Icon}"
																		IsVisible="{Binding HasIcon}"
																		Width="14" Height="14"
																		VerticalAlignment="Center"
																		Foreground="{DynamicResource TextSecondary}"/>

										<TextBlock Text="{Binding Title}"
															 IsVisible="{Binding HasTitle}"
															 FontSize="{DynamicResource FontSizeS}"
															 VerticalAlignment="Center"
															 TextTrimming="CharacterEllipsis"/>

									</StackPanel>

									<Button Grid.Column="1"
													Classes="icon mini overlayButton"
													ToolTip.Tip="{loc:Loc chat.overlay.toggle}"
													Command="{Binding $parent[ItemsControl].((local:ChatOverlayHostViewModel)DataContext).ToggleCommand}"
													CommandParameter="{Binding}">
										<Panel>
											<ico:VisualIcon Kind="ChevronUp" IsVisible="{Binding IsContentShown}"/>
											<ico:VisualIcon Kind="ChevronDown" IsVisible="{Binding !IsContentShown}"/>
										</Panel>
									</Button>

									<Button Grid.Column="2"
													Classes="icon mini overlayButton"
													IsVisible="{Binding HasExplicitSize}"
													ToolTip.Tip="{loc:Loc chat.overlay.fit}"
													Command="{Binding $parent[ItemsControl].((local:ChatOverlayHostViewModel)DataContext).ResetSizeCommand}"
													CommandParameter="{Binding}">
										<ico:VisualIcon Kind="Compress"/>
									</Button>

									<Button Grid.Column="3"
													Classes="icon mini overlayButton"
													ToolTip.Tip="{loc:Loc chat.overlay.hide}"
													Command="{Binding $parent[ItemsControl].((local:ChatOverlayHostViewModel)DataContext).HideCommand}"
													CommandParameter="{Binding}">
										<ico:VisualIcon Kind="TrayArrowDown"/>
									</Button>

									<Button Grid.Column="4"
													Classes="icon mini overlayButton"
													IsVisible="{Binding CanClose}"
													ToolTip.Tip="{loc:Loc chat.overlay.close}"
													Command="{Binding $parent[ItemsControl].((local:ChatOverlayHostViewModel)DataContext).CloseCommand}"
													CommandParameter="{Binding}">
										<ico:VisualIcon Kind="Close"/>
									</Button>

								</Grid>

							</Border>

							<!-- The body stays in the tree while collapsed: a terminal or a live control comes back as it was. -->
							<scroll:SmoothScrollViewer Grid.Row="1"
																				 VerticalScrollBarVisibility="Auto"
																				 HorizontalScrollBarVisibility="Auto"
																				 Padding="4,4"
																				 Step="65"
																				 IsVisible="{Binding IsContentShown}">
								<ContentControl Content="{Binding Content}"/>
							</scroll:SmoothScrollViewer>

							<!-- The size the user drags here is sealed as explicit, as if the script had asked for it. -->
							<ico:VisualIcon Grid.Row="1"
															Classes="overlayGrip"
															Kind="ResizeBottomRight"
															Width="16"
															Height="16"
															Margin="0,0,2,2"
															Cursor="BottomRightCorner"
															HorizontalAlignment="Right"
															VerticalAlignment="Bottom"
															Background="Transparent"
															IsVisible="{Binding IsContentShown}"
															ZIndex="1"
															PointerPressed="OnResizeGripPointerPressed"/>

						</Grid>

					</Border>

				</DataTemplate>
			</ItemsControl.ItemTemplate>

		</ItemsControl>
	</Panel>

</UserControl>
