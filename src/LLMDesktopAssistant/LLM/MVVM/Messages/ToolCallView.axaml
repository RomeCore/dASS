<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Messages"
						 xmlns:consents="using:LLMDesktopAssistant.Tools.Consents"
						 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.Messages.ToolCallView"
						 x:DataType="local:ToolCallViewModel">

	<UserControl.Styles>
		<Style Selector="FlyoutPresenter">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="MaxWidth" Value="755"/>
			<Setter Property="MaxHeight" Value="655"/>
			<Setter Property="MinWidth" Value="505"/>
			<Setter Property="MinHeight" Value="305"/>
		</Style>
	</UserControl.Styles>

	<StackPanel Orientation="Vertical" Margin="0,0,0,4">

		<!-- Main tool call button -->
		<Button Padding="2">

			<Button.Flyout>

				<Flyout Placement="BottomEdgeAlignedLeft"
								ShowMode="Standard">

					<ContentControl Content="{Binding Flyout}"/>

				</Flyout>

			</Button.Flyout>

			<WrapPanel Orientation="Horizontal"
								 ItemSpacing="4">

				<Panel Width="28" Height="28">

					<Panel IsVisible="{Binding StatusIcon, Converter={StaticResource NotnullToBooleanConverter}}">

						<ico:VisualIcon Kind="{Binding StatusIcon}"
															Classes="MidIcon"
															HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

						<Border Width="16" Height="16" CornerRadius="6"
										HorizontalAlignment="Right"
										VerticalAlignment="Bottom"
										IsVisible="{Binding DisplayMiniIcon}"
										Background="#ac000000"
										BoxShadow="0 0 3 0 #ac000000">

							<Panel>

								<Panel IsVisible="{Binding ToolIconVisible}">

									<ico:VisualIcon Kind="{Binding ToolIcon}"
																		Foreground="{Binding ToolIconBrush}"
																		Width="16" Height="16"
																		IsVisible="{Binding IsBlinking}">

										<ico:VisualIcon.Styles>
											<Style Selector="ico|VisualIcon">
												<Style.Animations>
													<Animation Duration="0:0:1"
																			IterationCount="INFINITE"
																			PlaybackDirection="Alternate"
																			Easing="SineEaseInOut">
														<KeyFrame Cue="0%">
															<Setter Property="Opacity" Value="1.0"/>
														</KeyFrame>
														<KeyFrame Cue="100%">
															<Setter Property="Opacity" Value="0.3"/>
														</KeyFrame>
													</Animation>
												</Style.Animations>
											</Style>
										</ico:VisualIcon.Styles>

									</ico:VisualIcon>

									<ico:VisualIcon Kind="{Binding ToolIcon}"
																		Foreground="{Binding ToolIconBrush}"
																		Width="16" Height="16"
																		IsVisible="{Binding !IsBlinking}"/>

								</Panel>

								<ctrl:ProgressRing IsVisible="{Binding InProgress}"
																	 Foreground="{Binding ToolIconBrush}"
																	 Width="16" Height="16"
																	 StrokeThickness="4"
																	 Minimum="{Binding MinProgress}" Maximum="{Binding MaxProgress}"
																	 Value="{Binding Progress}"
																	 IsIndeterminate="{Binding Progress, Converter={StaticResource NotnullToBooleanConverterInverted}}"/>

							</Panel>

						</Border>

					</Panel>

					<Panel IsVisible="{Binding StatusIcon, Converter={StaticResource NotnullToBooleanConverterInverted}}">

						<Panel IsVisible="{Binding ToolIconVisible}">

							<ico:VisualIcon Kind="{Binding ToolIcon}"
																Foreground="{Binding ToolIconBrush}"
																Width="28" Height="28"
																IsVisible="{Binding IsBlinking}">

								<ico:VisualIcon.Styles>
									<Style Selector="ico|VisualIcon">
										<Style.Animations>
											<Animation Duration="0:0:1"
																	IterationCount="INFINITE"
																	PlaybackDirection="Alternate"
																	Easing="SineEaseInOut">
												<KeyFrame Cue="0%">
													<Setter Property="Opacity" Value="1.0"/>
												</KeyFrame>
												<KeyFrame Cue="100%">
													<Setter Property="Opacity" Value="0.3"/>
												</KeyFrame>
											</Animation>
										</Style.Animations>
									</Style>
								</ico:VisualIcon.Styles>

							</ico:VisualIcon>

							<ico:VisualIcon Kind="{Binding ToolIcon}"
																Foreground="{Binding ToolIconBrush}"
																Width="28" Height="28"
																IsVisible="{Binding !IsBlinking}"/>

						</Panel>

						<ctrl:ProgressRing IsVisible="{Binding InProgress}"
															 Foreground="{Binding ToolIconBrush}"
															 Width="28" Height="28"
															 Minimum="{Binding MinProgress}" Maximum="{Binding MaxProgress}"
															 Value="{Binding Progress}"
															 IsIndeterminate="{Binding Progress, Converter={StaticResource NotnullToBooleanConverterInverted}}"/>

					</Panel>

				</Panel>

				<StackPanel Orientation="Vertical"
										VerticalAlignment="Center">

					<TextBlock Text="{loc:Loc {Binding ToolTitle}}"
										 FontSize="{DynamicResource FontSizeM}"
										 FontWeight="Medium"/>

					<ItemsControl ItemsSource="{Binding BehaviourFlags}"
												IsVisible="{Binding ExpectedBehaviour, Converter={StaticResource NotnullToBooleanConverter}}">

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="2" Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Panel>
									<ToolTip.Tip>
										<StackPanel Orientation="Vertical" Spacing="4">
											<TextBlock Text="{Binding DisplayName}"
											           FontSize="{DynamicResource FontSizeM}"
											           FontWeight="SemiBold"/>
											<TextBlock Text="{Binding Description}"/>
										</StackPanel>
									</ToolTip.Tip>
									<ico:VisualIcon Kind="{Binding Icon}"
																		Foreground="{Binding Color}"
																		Background="Transparent"
																		Width="12" Height="12"/>
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

				<GridSplitter Width="2" MinWidth="2" ResizeDirection="Columns" IsEnabled="False"
											IsVisible="{Binding StatusTitle, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

				<ctrl:MarkdownControl MarkdownText="{Binding StatusTitle}"
															Margin="2,3"
															VerticalAlignment="Bottom"
															IsVisible="{Binding StatusTitle, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

				<GridSplitter Width="2" MinWidth="2" ResizeDirection="Columns" IsEnabled="False"
											IsVisible="{Binding UserAsked}"/>

				<consents:ToolConsentPanel IsVisible="{Binding UserAsked}"
																	 ResolveConsentCommand="{Binding ConsentCommand}"/>

			</WrapPanel>

		</Button>

		<!-- Additional data of the tool call -->
		<ContentControl Content="{Binding AdditionalData}" Margin="0,2"/>

	</StackPanel>

</UserControl>
