<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Messages"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Messages.AssistantMessageTextPartView"
			 x:DataType="local:AssistantMessageTextPartViewModel">

	<ctrl:MarkdownControl MarkdownText="{Binding Text}"
											  UsePlaintext="{Binding !RenderMarkdown}"
											  AnimateBlocks="{Binding !Completed}"
											  IsVisible="{Binding IsVisible}"
											  Margin="0,5"/>

</UserControl>
