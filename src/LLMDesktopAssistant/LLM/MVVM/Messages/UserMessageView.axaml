<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Messages"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:ctrl="clr-namespace:LLMDesktopAssistant.Controls"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Messages.UserMessageView"
			 x:DataType="local:UserMessageViewModel">

	<StackPanel Orientation="Vertical"
							VerticalAlignment="Top"
							Margin="40,8">

		<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Right"
								IsVisible="{Binding ShowAvatar}">

			<TextBlock Text="{Binding SenderName}"
								 FontSize="16"
								 FontWeight="Bold"
								 Margin="4"
								 VerticalAlignment="Center"/>

			<Panel>

				<Border IsVisible="{Binding SenderAvatar, Converter={StaticResource NotnullToBooleanConverter}}"
								Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Margin="4">
					<Image Source="{Binding SenderAvatar}" Width="32" Height="32"/>
				</Border>

				<ico:VisualIcon Kind="Account" Width="32" Height="32" Margin="4"
													IsVisible="{Binding SenderAvatar, Converter={StaticResource NotnullToBooleanConverterInverted}}"/>

			</Panel>

		</StackPanel>

		<Border HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Padding="12,8"
						Background="{DynamicResource MessageBackground}"
						CornerRadius="16 16 4 16"
						MaxWidth="500">

			<ctrl:MarkdownControl MarkdownText="{Binding Text}"
														UsePlaintext="{Binding !RenderMarkdown}"/>

		</Border>

		<ContentControl Content="{Binding ToolCalls}" HorizontalAlignment="Right"/>
		<ContentControl Content="{Binding AdditionalData}" HorizontalAlignment="Right" Margin="0,2"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
								Spacing="4">

			<Button Command="{Binding ResendCommand}"
							Classes="IconButton"
							ToolTip.Tip="{loc:Loc message.resend}">

				<ico:VisualIcon Kind="ArrowUDownLeft"/>
			</Button>

			<Button Command="{Binding EditCommand}"
							Classes="IconButton"
							ToolTip.Tip="{loc:Loc message.edit}">

				<ico:VisualIcon Kind="Edit"/>
			</Button>

			<Button Command="{Binding DeleteCommand}"
							Classes="IconButton"
							ToolTip.Tip="{loc:Loc message.delete}">

				<ico:VisualIcon Kind="Delete"/>
			</Button>

			<StackPanel Orientation="Horizontal"
									IsVisible="{Binding BranchSelectionAvailable}"
									Spacing="0">

				<Button Command="{Binding SwitchBranchCommand}"
								Classes="IconButton"
								CommandParameter="{Binding PreviousBranchIndex}"
								CornerRadius="8,0,0,8"
								ToolTip.Tip="{loc:Loc message.previous_branch}">
					<ico:VisualIcon Kind="ChevronLeft"/>
				</Button>

				<ComboBox ItemsSource="{Binding BranchIndices}"
									CornerRadius="0"
									SelectedItem="{Binding SelectedBranchIndex}"/>

				<Button Command="{Binding SwitchBranchCommand}"
								Classes="IconButton"
								CommandParameter="{Binding NextBranchIndex}"
								CornerRadius="0,8,8,0"
								ToolTip.Tip="{loc:Loc message.next_branch}">
					<ico:VisualIcon Kind="ChevronRight"/>
				</Button>

			</StackPanel>

			<ToggleButton Classes="IconButton"
							IsChecked="{Binding RenderMarkdown, Mode=TwoWay}"
							ToolTip.Tip="{loc:Loc message.render_markdown}">
				<ico:VisualIcon Kind="LanguageMarkdown"/>
			</ToggleButton>

			<ItemsControl ItemsSource="{Binding Extensions}"
										Margin="-4,0,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>

						<Panel IsVisible="{Binding IsVisible}" Margin="4,0,0,0">

							<ContentControl Content="{Binding ViewModel}"
															IsVisible="{Binding ViewModel, Converter={StaticResource NotnullToBooleanConverter}}"/>

							<Button Command="{Binding Command}"
											Classes="IconButton"
											IsVisible="{Binding ViewModel, Converter={StaticResource NotnullToBooleanConverterInverted}}"
											ToolTip.Tip="{loc:Loc {Binding Tooltip}}">
								<ico:VisualIcon Kind="{Binding Icon}"/>
							</Button>

						</Panel>

					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</StackPanel>

	</StackPanel>

</UserControl>
