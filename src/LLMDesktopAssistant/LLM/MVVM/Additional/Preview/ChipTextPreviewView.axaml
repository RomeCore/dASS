<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="200"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Additional.Preview"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.Additional.Preview.ChipTextPreviewView"
						 x:DataType="local:ChipTextPreviewViewModel"
						 MaxWidth="960">

	<StackPanel Spacing="6">

		<!-- Code blocks stay bare source: a tooltip has no room for a top bar and no providers to fill its tabs. -->
		<ctrl:MarkdownControl MarkdownText="{Binding Markdown}"
													CompactCodeBlocks="True"/>

		<TextBlock Text="{loc:Loc {Binding HiddenSummary}}"
							 IsVisible="{Binding IsTruncated}"
							 FontSize="11"
							 Opacity="0.55"/>

	</StackPanel>

</UserControl>
