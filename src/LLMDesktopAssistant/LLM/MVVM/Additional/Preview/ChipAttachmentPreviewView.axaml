<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="260"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Additional.Preview"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.Additional.Preview.ChipAttachmentPreviewView"
						 x:DataType="local:ChipAttachmentPreviewViewModel"
						 MaxWidth="340">

	<StackPanel Spacing="6">

		<Image Source="{Binding Image}"
					 IsVisible="{Binding HasImage}"
					 MaxWidth="320" MaxHeight="240"
					 Stretch="Uniform"/>

		<StackPanel Orientation="Horizontal" Spacing="6">

			<TextBlock Text="{loc:Loc {Binding Caption}}"
								 IsVisible="{Binding Caption, Converter={StaticResource NotnullToBooleanConverter}}"
								 FontSize="11"
								 Opacity="0.55"/>

			<TextBlock Text="{Binding Source}"
								 IsVisible="{Binding Source, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
								 FontSize="11"
								 Opacity="0.45"
								 TextWrapping="Wrap"/>

		</StackPanel>

	</StackPanel>

</UserControl>
