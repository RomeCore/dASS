<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Additional.Context"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
						  xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Additional.Context.TokenCostView"
			 x:DataType="local:TokenCostViewModel">

	<UserControl.Styles>
		<Style Selector="Rectangle.separator">
			<Setter Property="Width" Value="1"/>
			<Setter Property="Height" Value="14"/>
			<Setter Property="Fill" Value="{DynamicResource DefaultForeground}"/>
			<Setter Property="Opacity" Value="0.18"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.metric">
			<Setter Property="FontSize" Value="10.5"/>
			<Setter Property="Opacity" Value="0.4"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.value">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Opacity" Value="0.75"/>
			<Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<!-- Transparent keeps the whole row hit-testable, so the tooltip opens over the empty space too. -->
	<Border Background="Transparent" Padding="0,2,0,4">
		<ToolTip.Tip>
			<StackPanel MinWidth="260" Spacing="7">
				<StackPanel Spacing="2">
					<TextBlock Text="{Binding ModelDisplayName}"
										 FontSize="12" FontWeight="SemiBold" Opacity="0.92"/>
					<TextBlock Text="{Binding ProviderName}"
										 FontSize="9.5" Opacity="0.35"
										 IsVisible="{Binding HasProvider}"/>
				</StackPanel>

				<ItemsControl ItemsSource="{Binding Modifiers}" IsVisible="{Binding HasModifiers}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="3" LineSpacing="3"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="x:String">
							<Border Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
											CornerRadius="3" Padding="5,0">
								<TextBlock Text="{Binding}" FontSize="9" Opacity="0.7"/>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Rectangle Height="1" Fill="{DynamicResource DefaultForeground}" Opacity="0.1" IsVisible="{Binding HasTokenCounts}"/>

				<StackPanel Spacing="4" IsVisible="{Binding HasTokenCounts}">
					<Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasInputTokens}">
						<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.input}" FontSize="10.5" Opacity="0.4"/>
						<TextBlock Grid.Column="1" Text="{Binding InputTokensFormatted}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.9" HorizontalAlignment="Right"/>
						<ico:VisualIcon Grid.Column="2" Kind="ArrowDownward" Width="11" Height="11" Opacity="0.3" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</Grid>
					<Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasOutputTokens}">
						<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.output}" FontSize="10.5" Opacity="0.4"/>
						<TextBlock Grid.Column="1" Text="{Binding OutputTokensFormatted}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.9" HorizontalAlignment="Right"/>
						<ico:VisualIcon Grid.Column="2" Kind="ArrowUpward" Width="11" Height="11" Opacity="0.3" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</Grid>
				</StackPanel>

				<Rectangle Height="1" Fill="{DynamicResource DefaultForeground}" Opacity="0.1" IsVisible="{Binding HasCacheBlock}"/>

				<StackPanel Spacing="4" IsVisible="{Binding HasCacheBlock}">
					<Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasCacheHit}">
						<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.cache_hit}" FontSize="10.5" Opacity="0.4"/>
						<TextBlock Grid.Column="1" Text="{Binding CacheHitFormatted}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.9" HorizontalAlignment="Right"/>
						<ico:VisualIcon Grid.Column="2" Kind="Cached" Width="11" Height="11" Opacity="0.3" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</Grid>
					<Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasCacheMiss}">
						<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.cache_miss}" FontSize="10.5" Opacity="0.4"/>
						<TextBlock Grid.Column="1" Text="{Binding CacheMissFormatted}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.9" HorizontalAlignment="Right"/>
						<ico:VisualIcon Grid.Column="2" Kind="Close" Width="11" Height="11" Opacity="0.3" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</Grid>
					<Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasCacheCreate}">
						<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.cache_create}" FontSize="10.5" Opacity="0.4"/>
						<TextBlock Grid.Column="1" Text="{Binding CacheCreateFormatted}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.9" HorizontalAlignment="Right"/>
						<ico:VisualIcon Grid.Column="2" Kind="Add" Width="11" Height="11" Opacity="0.3" Margin="4,0,0,0" VerticalAlignment="Center"/>
					</Grid>

					<StackPanel Spacing="3">
						<Border Height="6" CornerRadius="3" ClipToBounds="True"
										Background="#1AFFFFFF">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="{Binding CacheHitLength}"/>
									<ColumnDefinition Width="{Binding CacheMissLength}"/>
									<ColumnDefinition Width="{Binding CacheCreateLength}"/>
								</Grid.ColumnDefinitions>

								<Border Background="#FF6FD98A"
												Grid.Column="0"
												IsVisible="{Binding IsCacheGood}"/>
								<Border Background="#FFE0B65A"
												Grid.Column="0"
												IsVisible="{Binding IsCacheWarning}"/>
								<Border Background="#FFEF6E6E"
												Grid.Column="0"
												IsVisible="{Binding IsCacheBad}"/>
								<Border Background="#40FFFFFF"
												Grid.Column="1"/>
								<Border Background="#FF7FA8E0"
												Grid.Column="2"/>
							</Grid>
						</Border>

						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.cache}" FontSize="9.5" Opacity="0.35"/>
							<TextBlock Grid.Column="1" Text="{Binding CacheHitPercentText}"
												 FontSize="9.5" FontWeight="SemiBold"
												 Foreground="#FF6FD98A"
												 IsVisible="{Binding IsCacheGood}"/>
							<TextBlock Grid.Column="1" Text="{Binding CacheHitPercentText}"
												 FontSize="9.5" FontWeight="SemiBold"
												 Foreground="#FFE0B65A"
												 IsVisible="{Binding IsCacheWarning}"/>
							<TextBlock Grid.Column="1" Text="{Binding CacheHitPercentText}"
												 FontSize="9.5" FontWeight="SemiBold"
												 Foreground="#FFEF6E6E"
												 IsVisible="{Binding IsCacheBad}"/>
							<TextBlock Grid.Column="1" Text="{loc:Loc message.token_cost.cache_created}"
												 FontSize="9.5" FontWeight="SemiBold"
												 Foreground="#FF7FA8E0"
												 IsVisible="{Binding IsCacheJustCreated}"/>
						</Grid>
					</StackPanel>
				</StackPanel>

				<Rectangle Height="1" Fill="{DynamicResource DefaultForeground}" Opacity="0.1"/>

				<StackPanel Spacing="4">
					<Grid ColumnDefinitions="Auto,*">
						<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.ttft}" FontSize="10.5" Opacity="0.4"/>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
							<TextBlock Text="{Binding TTFTValue}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.9"/>
							<TextBlock Text="{loc:Loc message.token_cost.seconds}" FontSize="10" Opacity="0.35"/>
						</StackPanel>
					</Grid>
					<Grid ColumnDefinitions="Auto,*">
						<TextBlock Grid.Column="0" Text="{loc:Loc message.token_cost.generation_time}" FontSize="10.5" Opacity="0.4"/>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
							<TextBlock Text="{Binding GenerationTimeValue}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.9"/>
							<TextBlock Text="{loc:Loc message.token_cost.seconds}" FontSize="10" Opacity="0.35"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</StackPanel>
		</ToolTip.Tip>

		<WrapPanel LineSpacing="6" ItemSpacing="10" VerticalAlignment="Center">

			<!-- Model: provider, name, first modifier and a counter for the rest. -->
			<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
				<TextBlock Text="{Binding ProviderName}"
									 FontSize="10.5" Opacity="0.4" VerticalAlignment="Center"
									 IsVisible="{Binding HasProvider}"/>
				<TextBlock Text="·"
									 FontSize="10.5" Opacity="0.22" VerticalAlignment="Center"
									 IsVisible="{Binding HasProvider}"/>
				<TextBlock Text="{Binding ModelDisplayName}"
									 FontSize="11" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center"/>
				<TextBlock Text="·"
									 FontSize="10.5" Opacity="0.22" VerticalAlignment="Center"
									 IsVisible="{Binding HasModifiers}"/>
				<TextBlock Text="{Binding FirstModifier}"
									 FontSize="10.5" Opacity="0.55" VerticalAlignment="Center"
									 IsVisible="{Binding HasModifiers}"/>
				<TextBlock Text="{Binding MoreModifiersText}"
									 FontSize="9.5" Opacity="0.3" VerticalAlignment="Center"
									 IsVisible="{Binding HasMoreModifiers}"/>
			</StackPanel>

			<Rectangle Classes="separator" IsVisible="{Binding HasTokenCounts}"/>

			<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
									IsVisible="{Binding HasTokenCounts}">
				<TextBlock Classes="value" Text="{Binding InputTokensFormatted}"
									 IsVisible="{Binding HasInputTokens}"/>
				<TextBlock Text="→" FontSize="11" Opacity="0.3" VerticalAlignment="Center"
									 IsVisible="{Binding HasBothTokenCounts}"/>
				<TextBlock Classes="value" Text="{Binding OutputTokensFormatted}"
									 IsVisible="{Binding HasOutputTokens}"/>
			</StackPanel>

			<Rectangle Classes="separator" IsVisible="{Binding HasCachePercent}"/>

			<!-- Cache stays neutral inline: the coloured verdict belongs to the tooltip. -->
			<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
						IsVisible="{Binding HasCachePercent}">
				<TextBlock Classes="metric" Text="{loc:Loc message.token_cost.cache}"/>
				<TextBlock Text="{Binding CacheHitPercentText}"
									 FontSize="10.5" Opacity="0.55" VerticalAlignment="Center"/>
			</StackPanel>

			<Rectangle Classes="separator"/>

			<StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
				<TextBlock Text="{Binding TTFTValue}" FontSize="11" Opacity="0.75"
									 FontFamily="Cascadia Mono, Consolas, monospace" VerticalAlignment="Center"/>
				<TextBlock Text="{loc:Loc message.token_cost.seconds}" FontSize="10" Opacity="0.35" VerticalAlignment="Center"/>
				<TextBlock Text=" / " FontSize="11" Opacity="0.25" VerticalAlignment="Center"/>
				<TextBlock Text="{Binding GenerationTimeValue}" FontSize="11" Opacity="0.75"
									 FontFamily="Cascadia Mono, Consolas, monospace" VerticalAlignment="Center"/>
				<TextBlock Text="{loc:Loc message.token_cost.seconds}" FontSize="10" Opacity="0.35" VerticalAlignment="Center"/>
			</StackPanel>

		</WrapPanel>
	</Border>
</UserControl>
