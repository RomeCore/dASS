<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="32"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Additional"
						 xmlns:preview="using:LLMDesktopAssistant.LLM.MVVM.Additional.Preview"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.Additional.AdditionalMessagePartView"
						 x:DataType="local:AdditionalMessagePart">

	<UserControl.Resources>

		<!-- The whole content behind a click: the tooltip peeks, this shows everything. -->
		<DataTemplate x:Key="ChipFullPreview" DataType="preview:ChipTextPreviewViewModel">
			<Border MinWidth="420" MaxWidth="1060" MaxHeight="520" Padding="12">
				<ctrl:MarkdownControl MarkdownText="{Binding FullMarkdown}"
															CompactCodeBlocks="True"/>
			</Border>
		</DataTemplate>

	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="FlyoutPresenter">
			<Setter Property="Cursor" Value="Arrow"/>
		</Style>
	</UserControl.Styles>

	<!-- A part that hides nothing (a plain chip) has no preview, and a null Tip shows no tooltip at all. -->
	<!-- The look lives in Styles/Chips.axaml: a surface that wants a lighter chip overrides that selector. -->
	<Border Classes="messagePartChip"
					x:Name="ChipBorder"
					ToolTip.Tip="{Binding Preview}">

		<FlyoutBase.AttachedFlyout>
			<Flyout Placement="Bottom">
				<ContentControl Content="{Binding Preview}"
												ContentTemplate="{StaticResource ChipFullPreview}"/>
			</Flyout>
		</FlyoutBase.AttachedFlyout>

		<StackPanel Orientation="Horizontal" Spacing="4">

			<ico:VisualIcon Kind="{Binding ChipIcon}"
											IsVisible="{Binding ChipIcon, Converter={StaticResource NotnullToBooleanConverter}}"/>

			<TextBlock Text="{loc:Loc {Binding ChipTitle}}"
					   VerticalAlignment="Center"/>

		</StackPanel>

	</Border>

</UserControl>
