<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
						 xmlns:local="clr-namespace:LLMDesktopAssistant.LLM.MVVM"
						 xmlns:loc="clr-namespace:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.UserInputChipsView"
						 x:DataType="local:UserInputChipsViewModel">

	<StackPanel Orientation="Horizontal"
							Spacing="6"
							IsVisible="{Binding IsVisible}">

		<!-- Pending follow-ups -->
		<Border Classes="inputChip" IsVisible="{Binding HasQueue}">
			<StackPanel Orientation="Horizontal" Spacing="0">
				<Button Classes="chipLabel"
								Command="{Binding OpenQueueCommand}"
								ToolTip.Tip="{loc:Loc chat.follow_up.open}">
					<TextBlock Text="{Binding QueueTitle}"/>
				</Button>
				<Button Classes="icon mini"
								Command="{Binding ClearQueueCommand}"
								ToolTip.Tip="{loc:Loc chat.follow_up.clear}">
					<ico:VisualIcon Kind="Close"/>
				</Button>
			</StackPanel>
		</Border>

		<!-- Message being edited -->
		<Border Classes="inputChip accent" IsVisible="{Binding IsEditing}">
			<StackPanel Orientation="Horizontal" Spacing="0">
				<Button Classes="chipLabel"
								Command="{Binding RevealEditCommand}"
								ToolTip.Tip="{loc:Loc chat.follow_up.edit_reveal}">
					<TextBlock Text="{Binding EditTitle}"/>
				</Button>
				<Button Classes="icon mini"
								Command="{Binding CancelEditCommand}"
								ToolTip.Tip="{loc:Loc chat.input.cancel_edit.hint}">
					<ico:VisualIcon Kind="Close"/>
				</Button>
			</StackPanel>
		</Border>

	</StackPanel>

</UserControl>
