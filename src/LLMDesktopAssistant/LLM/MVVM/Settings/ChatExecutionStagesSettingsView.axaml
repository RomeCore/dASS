<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:stages="using:LLMDesktopAssistant.LLM.MVVM.Settings.ExecutionStages"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.ChatExecutionStagesSettingsView"
			 x:DataType="local:ChatExecutionStagesSettingsViewModel">

	<DockPanel>
		<!-- Toolbar -->
		<Border DockPanel.Dock="Top"
				BorderBrush="{DynamicResource SecondaryAccentBrush}"
				BorderThickness="0,0,0,1"
				Padding="8,6">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<Button Command="{Binding AddStageCommand}" Classes="IconButton"
						ToolTip.Tip="{loc:Loc settings.stage.add}">
					<ico:VisualIcon Kind="Plus"/>
				</Button>
			</StackPanel>
		</Border>

		<!-- Stages list -->
		<ItemsControl ItemsSource="{Binding Stages}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="stages:StageContainerViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8"
									Margin="0,0,0,8">
						<StackPanel>
							<!-- Stage Header -->
							<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
											BorderThickness="0,0,0,1"
											Padding="0,0,0,6"
											Margin="0,0,0,6">
								<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

									<!-- Enabled checkbox -->
									<CheckBox Grid.Column="0"
														IsChecked="{Binding Stage.Enabled}"/>

									<!-- Type selector -->
									<ComboBox Grid.Column="1"
														ItemsSource="{Binding AvailableStageTypes}"
														SelectedItem="{Binding SelectedType}"
														Width="180"
														Margin="0,0,8,0">
										
										<ComboBox.ItemTemplate>
											<DataTemplate DataType="stages:StageTypeOption">
												<TextBlock Text="{Binding DisplayName}"/>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>

									<!-- Move up -->
									<Button Grid.Column="3"
													Command="{Binding MoveUpCommand}"
													Classes="IconButton"
													Margin="2,0"
													ToolTip.Tip="{loc:Loc settings.stage.move_up}">
										<ico:VisualIcon Kind="ChevronUp"/>
									</Button>

									<!-- Move down -->
									<Button Grid.Column="4"
													Command="{Binding MoveDownCommand}"
													Classes="IconButton"
													Margin="2,0"
													ToolTip.Tip="{loc:Loc settings.stage.move_down}">
										<ico:VisualIcon Kind="ChevronDown"/>
									</Button>

									<!-- Clone -->
									<Button Grid.Column="5"
													Command="{Binding CloneCommand}"
													Classes="IconButton"
													Margin="2,0"
													ToolTip.Tip="{loc:Loc settings.stage.clone}">
										<ico:VisualIcon Kind="ContentCopy"/>
									</Button>

									<!-- Delete -->
									<Button Grid.Column="6"
													Command="{Binding DeleteCommand}"
													Classes="IconButton"
													Margin="2,0"
													ToolTip.Tip="{loc:Loc settings.stage.remove}">
										<ico:VisualIcon Kind="Delete"/>
									</Button>
								</Grid>
							</Border>

							<!-- Stage Body - content depends on type -->
							<ContentControl Content="{Binding StageVM}"/>
						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</DockPanel>

</UserControl>
