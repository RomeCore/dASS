<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
						 xmlns:local="using:LLMDesktopAssistant.LLM.Settings"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:util="using:LLMDesktopAssistant.Utils"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						 x:Class="LLMDesktopAssistant.LLM.Settings.ChatEnvironmentSettingsView"
						 x:DataType="local:ChatEnvironmentSettingsViewModel"
						 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- ============================================================ -->
		<!-- WORKING DIRECTORIES -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto,Auto,Auto">
			<TextBlock Grid.Column="0"
								 Text="{loc:Loc env.workdir.title}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static local:InheritanceLevelItem.AllProfile}"
								SelectedItem="{Binding SelectedWorkingDirectoriesInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="local:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

			<Button Grid.Column="2"
							Command="{Binding AddWorkingDirectoryCommand}"
							Classes="IconButton"
							ToolTip.Tip="{loc:Loc env.add_working_directory}">
				<ico:VisualIcon Kind="Plus"/>
			</Button>

			<Button Grid.Column="3"
							Command="{Binding AddWorkingDirectoryByDialogCommand}"
							Classes="IconButton"
							Margin="4,0,0,0"
							ToolTip.Tip="{loc:Loc env.select_working_directory}">
				<ico:VisualIcon Kind="FolderOpen"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc env.workdir.hint}"
							 Opacity="0.6"
							 TextWrapping="Wrap"
							 Margin="0,0,0,8"/>

		<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="8">
			<StackPanel Spacing="6">
				<!-- Header row: Active | Name | buttons -->
				<Grid ColumnDefinitions="Auto,Auto,*">

					<!-- Active radio -->
					<RadioButton Grid.Column="0"
											 IsChecked="{Binding EffectiveWorkingDirectories.IsDefaultWorkingDirectoryActive, Mode=OneWay}"
											 Command="{Binding SetDefaultWorkingDirectoryActiveCommand}"
											 VerticalAlignment="Center"
											 Margin="0,0,6,0"
											 ToolTip.Tip="{loc:Loc env.active}"/>

					<!-- Name -->
					<TextBox Grid.Column="1"
									 Text="{x:Static util:Directories.DefaultWorkingDirectoryName}"
									 IsReadOnly="True"
									 IsEnabled="False"
									 PlaceholderText="{loc:Loc env.name}"
									 UseFloatingPlaceholder="True"
									 VerticalContentAlignment="Center"
									 MinWidth="120"
									 Margin="0,0,6,0"/>
				
					<!-- Enabled checkbox -->
					<CheckBox Grid.Column="2"
										IsChecked="{Binding EffectiveWorkingDirectories.IsDefaultWorkingDirectoryEnabled}"
										Content="{loc:Loc env.enabled}"/>

				</Grid>

				<!-- Path row + Browse button -->
				<Grid ColumnDefinitions="*,Auto">
					<TextBox Grid.Column="0"
									 Text="{x:Static util:Directories.DefaultWorkingDirectory}"
									 PlaceholderText="{loc:Loc env.path}"
									 UseFloatingPlaceholder="True"
									 VerticalContentAlignment="Center"
									 IsReadOnly="True"
									 IsEnabled="False"/>

					<Button Grid.Column="1"
									Margin="6,0,2,0"
									Command="{Binding #VMRoot.DataContext.OpenDirectoryCommand}"
									CommandParameter="{x:Static util:Directories.DefaultWorkingDirectory}"
									Classes="IconButton"
									ToolTip.Tip="{loc:Loc env.open_in_explorer}">
						<ico:VisualIcon Kind="OpenInNew"/>
					</Button>

				</Grid>
			</StackPanel>
		</Border>

		<ItemsControl ItemsSource="{Binding EffectiveWorkingDirectories.Items}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Vertical" Spacing="8"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="local:WorkingDirectorySetting">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8">
						<StackPanel Spacing="6">
							<!-- Header row: Active | Name | buttons -->
							<Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

								<!-- Active radio -->
								<RadioButton Grid.Column="0"
														 IsChecked="{Binding IsActive, Mode=OneWay}"
														 Command="{Binding #VMRoot.DataContext.SetActiveWorkingDirectoryCommand}"
														 CommandParameter="{Binding}"
														 VerticalAlignment="Center"
														 Margin="0,0,6,0"
														 ToolTip.Tip="{loc:Loc env.active}"/>

								<!-- Name -->
								<TextBox Grid.Column="1"
												 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 PlaceholderText="{loc:Loc env.name}"
												 UseFloatingPlaceholder="True"
												 VerticalContentAlignment="Center"
												 MinWidth="120"
												 Margin="0,0,6,0"/>
									
								<!-- Enabled checkbox -->
								<CheckBox Grid.Column="2"
													IsChecked="{Binding IsEnabled}"
													Content="{loc:Loc env.enabled}"/>

								<!-- Move up -->
								<Button Grid.Column="4"
												Command="{Binding #VMRoot.DataContext.MoveWorkingDirectoryUpCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												Margin="2,0"
												ToolTip.Tip="{loc:Loc env.move_up}">
									<ico:VisualIcon Kind="ChevronUp"/>
								</Button>

								<!-- Move down -->
								<Button Grid.Column="5"
												Command="{Binding #VMRoot.DataContext.MoveWorkingDirectoryDownCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												Margin="2,0"
												ToolTip.Tip="{loc:Loc env.move_down}">
									<ico:VisualIcon Kind="ChevronDown"/>
								</Button>

								<!-- Delete -->
								<Button Grid.Column="6"
												Command="{Binding #VMRoot.DataContext.RemoveWorkingDirectoryCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												Margin="2,0"
												ToolTip.Tip="{loc:Loc env.remove}">
									<ico:VisualIcon Kind="Delete"/>
								</Button>
							</Grid>

							<!-- Path row + Browse button -->
							<Grid ColumnDefinitions="*,Auto,Auto" IsEnabled="{Binding IsEnabled}">
								<TextBox Grid.Column="0"
												 Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 PlaceholderText="{loc:Loc env.path}"
												 UseFloatingPlaceholder="True"
												 VerticalContentAlignment="Center"/>

								<Button Grid.Column="1"
												Margin="6,0,0,0"
												Command="{Binding #VMRoot.DataContext.BrowseWorkingDirectoryPathCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												ToolTip.Tip="{loc:Loc env.browse}">
									<ico:VisualIcon Kind="FolderOpen"/>
								</Button>
									
								<Button Grid.Column="2"
												Command="{Binding #VMRoot.DataContext.OpenDirectoryCommand}"
												CommandParameter="{Binding Path}"
												Classes="IconButton"
												Margin="2,0"
												ToolTip.Tip="{loc:Loc env.open_in_explorer}">
									<ico:VisualIcon Kind="OpenInNew"/>
								</Button>

							</Grid>
						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		
		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<!-- ============================================================ -->
		<!-- DIRECTORY ACCESS RULES -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto,Auto">
			<TextBlock Grid.Column="0"
								 Text="{loc:Loc env.directory_access_rules}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static local:InheritanceLevelItem.AllProfile}"
								SelectedItem="{Binding SelectedDirectoryAccessRulesInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="local:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

			<Button Grid.Column="2"
							Command="{Binding AddDirectoryAccessRuleCommand}"
							Classes="IconButton"
							ToolTip.Tip="{loc:Loc env.add_access_rule}">
				<ico:VisualIcon Kind="Plus"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc env.access_rules.hint}"
						Opacity="0.6"
						TextWrapping="Wrap"
						Margin="0,0,0,8"/>

		<ItemsControl ItemsSource="{Binding EffectiveDirectoryAccessRules}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="local:DirectoryAccessSetting">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8"
									Margin="0,0,0,8">
						<StackPanel Spacing="6">
							<!-- Header row: Active | Name | buttons -->
							<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
									
								<!-- Enabled checkbox -->
								<CheckBox Grid.Column="0"
													IsChecked="{Binding IsEnabled}"
													Content="{loc:Loc env.enabled}"/>

								<!-- Move up -->
								<Button Grid.Column="2"
												Command="{Binding #VMRoot.DataContext.MoveDirectoryAccessRuleUpCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												Margin="2,0"
												ToolTip.Tip="{loc:Loc env.move_up}">
									<ico:VisualIcon Kind="ChevronUp"/>
								</Button>

								<!-- Move down -->
								<Button Grid.Column="3"
												Command="{Binding #VMRoot.DataContext.MoveDirectoryAccessRuleDownCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												Margin="2,0"
												ToolTip.Tip="{loc:Loc env.move_down}">
									<ico:VisualIcon Kind="ChevronDown"/>
								</Button>

								<!-- Delete -->
								<Button Grid.Column="4"
												Command="{Binding #VMRoot.DataContext.RemoveDirectoryAccessRuleCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												Margin="2,0"
												ToolTip.Tip="{loc:Loc env.remove}">
									<ico:VisualIcon Kind="Delete"/>
								</Button>
							</Grid>

							<!-- Path + Browse + Delete -->
							<Grid ColumnDefinitions="*,Auto,Auto">
								<TextBox Grid.Column="0"
												 Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 PlaceholderText="{loc:Loc env.path}"
												 UseFloatingPlaceholder="True"
												 VerticalContentAlignment="Center"/>

								<Button Grid.Column="1"
												Margin="6,0,0,0"
												Command="{Binding #VMRoot.DataContext.BrowseDirectoryAccessRulePathCommand}"
												CommandParameter="{Binding}"
												Classes="IconButton"
												VerticalAlignment="Center"
												ToolTip.Tip="{loc:Loc env.browse}">
									<ico:VisualIcon Kind="FolderOpen"/>
								</Button>

								<Button Grid.Column="2"
												Margin="6,0,0,0"
												Command="{Binding #VMRoot.DataContext.OpenDirectoryCommand}"
												CommandParameter="{Binding Path}"
												Classes="IconButton"
												VerticalAlignment="Center"
												ToolTip.Tip="{loc:Loc env.open_in_explorer}">
									<ico:VisualIcon Kind="OpenInNew"/>
								</Button>
							</Grid>
								
							<!-- Access mode checkboxes -->
							<StackPanel Orientation="Horizontal" Spacing="12" IsEnabled="{Binding IsEnabled}">
								<CheckBox IsChecked="{Binding IsRead}"
													Content="{loc:Loc env.read}"/>
								<CheckBox IsChecked="{Binding IsWrite}"
													Content="{loc:Loc env.write}"/>
								<CheckBox IsChecked="{Binding IsExecute}"
													Content="{loc:Loc env.execute}"/>

								<!-- Access denied hint -->
								<TextBlock Text="{loc:Loc env.access_denied}"
													 IsEnabled="{Binding IsEnabled}"
													 IsVisible="{Binding IsAccessDenied}"
													 FontStyle="Italic"
													 Opacity="0.6"
													 Foreground="{DynamicResource ErrorBrush}"
													 VerticalAlignment="Center"
													 ClipToBounds="False"/>
							</StackPanel>

						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- ============================================================ -->
		<!-- ADDITIONAL ENVIRONMENT SETTINGS -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
								 Text="{loc:Loc env.additional_settings}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static local:InheritanceLevelItem.AllProfile}"
								SelectedItem="{Binding SelectedAdditionalSettingsInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="local:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>
		</Grid>

		<ItemsControl ItemsSource="{Binding AdditionalEnvironmentSettings}">

			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Vertical" Spacing="8"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Vertical" Spacing="8">

						<!-- Separator -->
						<Rectangle Height="1"
											 Fill="{DynamicResource DefaultForeground}"
											 Opacity="0.2"/>

						<ContentControl Content="{Binding Content}"/>

						<!-- Environment check -->
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Command="{Binding CheckCommand}"
											IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBooleanConverter}}"
											VerticalAlignment="Top"
											Padding="10,4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<ico:VisualIcon Kind="CheckDecagram"
																		Width="16"
																		Height="16"/>
									<TextBlock Text="{loc:Loc env.check_configuration}"
														 VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<ctrl:ProgressRing IsIndeterminate="True"
																 IsVisible="{Binding IsChecking}"/>

							<TextBlock Text="{Binding CheckResultText}"
												 TextWrapping="Wrap"
												 VerticalAlignment="Center"
												 Foreground="{DynamicResource SuccessBrush}"
												 IsVisible="{Binding IsCheckSuccessful}"/>

							<TextBlock Text="{Binding CheckResultText}"
												 TextWrapping="Wrap"
												 VerticalAlignment="Center"
												 Foreground="{DynamicResource ErrorBrush}"
												 IsVisible="{Binding IsCheckFailed}"/>
						</StackPanel>

					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>

		</ItemsControl>
		

	</StackPanel>

</UserControl>
