<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
			 xmlns:local="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:users="using:LLMDesktopAssistant.Users"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.Settings.ChatUserSettingsView"
			 x:DataType="local:ChatUserSettingsViewModel"
			 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- ============================================================ -->
		<!-- HEADER + ADD -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.chat.users}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<Button Grid.Column="1"
					Command="{Binding AddCommand}"
					Classes="Primary">
				<StackPanel Orientation="Horizontal" Spacing="4">
					<ico:VisualIcon Kind="AddCircle" Width="14" Height="14"/>
					<TextBlock Text="{loc:Loc common.add}"/>
				</StackPanel>
			</Button>

		</Grid>

		<TextBlock Text="{loc:Loc settings.chat.users.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<!-- ============================================================ -->
		<!-- USER CARDS -->
		<!-- ============================================================ -->
		<ItemsControl ItemsSource="{Binding Users}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="users:UserInformation">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8"
							Margin="0,0,0,8">
						<Grid RowDefinitions="Auto,Auto"
							  ColumnDefinitions="Auto,*,Auto,Auto"
							  ColumnSpacing="6">

							<!-- Row 0: Avatar icon | Name + Login | Edit | Delete -->
							<ico:VisualIcon Grid.Row="0" Grid.Column="0"
											  Kind="AccountCircle"
											  Foreground="{DynamicResource PrimaryAccentBrush}"
											  Width="22" Height="22"
											  VerticalAlignment="Center"/>

							<StackPanel Grid.Row="0" Grid.Column="1"
										VerticalAlignment="Center">
								<TextBlock Text="{Binding Name}"
										   FontWeight="Bold"
										   TextTrimming="CharacterEllipsis"
										   ToolTip.Tip="{Binding Name}"/>
								<TextBlock Text="{Binding Login}"
										   Opacity="0.6"
										   FontSize="11"
										   TextTrimming="CharacterEllipsis"
										   ToolTip.Tip="{Binding Login}"/>
							</StackPanel>

							<Button Grid.Row="0" Grid.Column="2"
									Command="{Binding #VMRoot.DataContext.EditCommand}"
									CommandParameter="{Binding}"
									Classes="IconButton"
									VerticalAlignment="Center"
									ToolTip.Tip="{loc:Loc common.edit}">
								<ico:VisualIcon Kind="Edit"/>
							</Button>

							<Button Grid.Row="0" Grid.Column="3"
									Command="{Binding #VMRoot.DataContext.DeleteCommand}"
									CommandParameter="{Binding}"
									Classes="IconButton"
									VerticalAlignment="Center"
									ToolTip.Tip="{loc:Loc common.delete}">
								<ico:VisualIcon Kind="Delete"/>
							</Button>

							<!-- Row 1: Description -->
							<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
									   Text="{Binding Description}"
									   Opacity="0.6"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Margin="0,2,0,0"
									   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</StackPanel>

</UserControl>
