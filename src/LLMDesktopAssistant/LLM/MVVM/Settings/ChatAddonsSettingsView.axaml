<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:settings="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.ChatAddonsSettingsView"
			 x:DataType="local:ChatAddonsSettingsViewModel"
			 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- ============================================================ -->
		<!-- SEARCH FOLDERS                                               -->
		<!-- ============================================================ -->
		<TextBlock Text="{loc:Loc addon.settings.search_folders}"
				   FontSize="{DynamicResource FontSizeL}"
				   FontWeight="Bold"/>

		<TextBlock Text="{loc:Loc addon.settings.search_folders.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding SearchFolders}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Border Background="{DynamicResource SecondaryAccentBrush}"
							CornerRadius="4"
							Padding="8,3"
							Margin="0,2,4,2">
						<TextBlock Text="{Binding}"
								   FontFamily="Consolas"
								   FontSize="12"/>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL SEARCH FOLDERS (GLOBAL)                           -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.additional_search_folders}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<Button Grid.Column="1"
					Command="{Binding AddGlobalSearchFolderCommand}"
					Classes="IconButton"
					VerticalAlignment="Center"
					ToolTip.Tip="{loc:Loc common.add}">
				<ico:VisualIcon Kind="Plus"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.additional_search_folders.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding GlobalAdditionalSearchFolders}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Grid ColumnDefinitions="*,Auto" Margin="0,2">
						<TextBox Grid.Column="0"
								 Text="{Binding Mode=TwoWay}"
								 PlaceholderText="{loc:Loc addon.settings.search_folder.placeholder}"
								 FontFamily="Consolas"
								 VerticalContentAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding #VMRoot.DataContext.RemoveGlobalSearchFolderCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc common.remove}">
							<ico:VisualIcon Kind="Close"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- WORKING DIRECTORIES                                          -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.workdirs}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedWorkingDirectoriesInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.workdirs.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<CheckBox IsChecked="{Binding EffectiveFetchFromAllWorkingDirectories}"
				  Content="{loc:Loc addon.settings.fetch_all}"/>

		<TextBlock Text="{loc:Loc addon.settings.fetch_all.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"
				   Margin="24,0,0,0"/>

		<CheckBox IsChecked="{Binding EffectiveUseWorkingDirectoriesAsPacks}"
				  Content="{loc:Loc addon.settings.use_workdirs_as_packs}"/>

		<TextBlock Text="{loc:Loc addon.settings.use_workdirs_as_packs.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"
				   Margin="24,0,0,0"/>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL PACK PATHS                                        -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.additional_pack_paths}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedPackPathsInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.additional_pack_paths.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<Grid ColumnDefinitions="*,Auto,Auto">
			<Button Grid.Column="1"
					Command="{Binding AddPackPathCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc common.add}">
				<ico:VisualIcon Kind="Plus"/>
			</Button>

			<Button Grid.Column="2"
					Command="{Binding BrowsePackPathCommand}"
					CommandParameter="{x:Null}"
					Classes="IconButton"
					Margin="4,0,0,0"
					ToolTip.Tip="{loc:Loc addon.settings.select_pack_folder}">
				<ico:VisualIcon Kind="FolderOpen"/>
			</Button>
		</Grid>

		<ItemsControl ItemsSource="{Binding EffectiveAdditionalPackPaths}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
						<TextBox Grid.Column="0"
								 Text="{Binding Mode=TwoWay}"
								 PlaceholderText="{loc:Loc addon.settings.additional_pack_paths.placeholder}"
								 VerticalContentAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding #VMRoot.DataContext.BrowsePackPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc env.browse}">
							<ico:VisualIcon Kind="FolderOpen"/>
						</Button>

						<Button Grid.Column="2"
								Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0"
								ToolTip.Tip="{loc:Loc env.open_in_explorer}">
							<ico:VisualIcon Kind="OpenInNew"/>
						</Button>

						<Button Grid.Column="3"
								Command="{Binding #VMRoot.DataContext.RemovePackPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0,0,0">
							<ico:VisualIcon Kind="Close"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL SOURCES PER TYPE                                  -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.addon_sources}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedAddonSourcesInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.addon_sources.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<TextBlock Text="{loc:Loc addon.settings.addon_sources.empty}"
				   Opacity="0.5"
				   TextWrapping="Wrap"
				   IsVisible="{Binding AddonSourceItems.Count, Converter={StaticResource InverseBooleanConverter}}"/>

		<ItemsControl ItemsSource="{Binding AddonSourceItems}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Vertical" Spacing="8"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:AddonSourceItemViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8"
									x:Name="VMItem"
									x:DataType="local:AddonSourceItemViewModel">
						<StackPanel Spacing="4">

							<TextBlock Text="{Binding Name}"
											   FontWeight="Bold"
												 FontSize="17"/>

							<TextBlock Text="{Binding Description}"
									   Opacity="0.7"
									   TextWrapping="Wrap"
									   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

							<Grid ColumnDefinitions="*,Auto,Auto"
								  Margin="0,8,0,0">
								<StackPanel Grid.Column="0"
											Spacing="0">
									<TextBlock Text="{loc:Loc addon.settings.addon_sources.directories}"
											   FontWeight="SemiBold"/>
									<TextBlock Text="{loc:Loc addon.settings.addon_sources.directories.hint}"
											   Opacity="0.55"
											   FontSize="11"
											   TextWrapping="Wrap"/>
								</StackPanel>

								<Button Grid.Column="1"
										Command="{Binding AddDirectoryCommand}"
										Classes="IconButton"
										VerticalAlignment="Top"
										ToolTip.Tip="{loc:Loc common.add}">
									<ico:VisualIcon Kind="Plus"/>
								</Button>

								<Button Grid.Column="2"
										Command="{Binding BrowseDirectoryCommand}"
										CommandParameter="{x:Null}"
										Classes="IconButton"
										VerticalAlignment="Top"
										Margin="4,0,0,0"
										ToolTip.Tip="{loc:Loc addon.settings.select_directory}">
									<ico:VisualIcon Kind="FolderPlus"/>
								</Button>
							</Grid>

							<ItemsControl ItemsSource="{Binding Directories}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
											<TextBox Grid.Column="0"
													 Text="{Binding Mode=TwoWay}"
													 PlaceholderText="{loc:Loc addon.settings.directory.placeholder}"
													 VerticalContentAlignment="Center"/>

											<Button Grid.Column="1"
													Command="{Binding #VMItem.DataContext.BrowseDirectoryCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="4,0,0,0"
													ToolTip.Tip="{loc:Loc env.browse}">
												<ico:VisualIcon Kind="FolderOpen"/>
											</Button>

											<Button Grid.Column="2"
													Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="2,0,0,0"
													ToolTip.Tip="{loc:Loc env.open_in_explorer}">
												<ico:VisualIcon Kind="OpenInNew"/>
											</Button>

											<Button Grid.Column="3"
													Command="{Binding #VMItem.DataContext.RemoveDirectoryCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="2,0,0,0"
													ToolTip.Tip="{loc:Loc common.remove}">
												<ico:VisualIcon Kind="Close"/>
											</Button>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Grid ColumnDefinitions="*,Auto,Auto"
								  Margin="0,8,0,0">
								<StackPanel Grid.Column="0"
											Spacing="0">
									<TextBlock Text="{loc:Loc addon.settings.addon_sources.files}"
											   FontWeight="SemiBold"/>
									<TextBlock Text="{loc:Loc addon.settings.addon_sources.files.hint}"
											   Opacity="0.55"
											   FontSize="11"
											   TextWrapping="Wrap"/>
								</StackPanel>

								<Button Grid.Column="1"
										Command="{Binding AddFileCommand}"
										Classes="IconButton"
										VerticalAlignment="Top"
										ToolTip.Tip="{loc:Loc common.add}">
									<ico:VisualIcon Kind="Plus"/>
								</Button>

								<Button Grid.Column="2"
										Command="{Binding BrowseFileCommand}"
										CommandParameter="{x:Null}"
										Classes="IconButton"
										VerticalAlignment="Top"
										Margin="4,0,0,0"
										ToolTip.Tip="{loc:Loc addon.settings.select_file}">
									<ico:VisualIcon Kind="FilePlus"/>
								</Button>
							</Grid>

							<ItemsControl ItemsSource="{Binding Files}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
											<TextBox Grid.Column="0"
													 Text="{Binding Mode=TwoWay}"
													 PlaceholderText="{loc:Loc addon.settings.file.placeholder}"
													 VerticalContentAlignment="Center"/>

											<Button Grid.Column="1"
													Command="{Binding #VMItem.DataContext.BrowseFileCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="4,0,0,0"
													ToolTip.Tip="{loc:Loc env.browse}">
												<ico:VisualIcon Kind="FolderOpen"/>
											</Button>

											<Button Grid.Column="2"
													Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="2,0,0,0"
													ToolTip.Tip="{loc:Loc env.open_in_explorer}">
												<ico:VisualIcon Kind="OpenInNew"/>
											</Button>

											<Button Grid.Column="3"
													Command="{Binding #VMItem.DataContext.RemoveFileCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="2,0,0,0"
													ToolTip.Tip="{loc:Loc common.remove}">
												<ico:VisualIcon Kind="Close"/>
											</Button>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDON PACKS                                                  -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.packs}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedPacksInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.packs.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<CheckBox IsChecked="{Binding EnablePacksByDefault}"
				  Content="{loc:Loc addon.settings.enable_packs_by_default}"/>

		<TextBlock Text="{loc:Loc addon.settings.enable_packs_by_default.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"
				   Margin="24,0,0,0"/>

		<Grid ColumnDefinitions="*,Auto">
			<Button Grid.Column="1"
					Command="{Binding RefreshPacksCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc addon.settings.packs.refresh}">
				<ico:VisualIcon Kind="Refresh"/>
			</Button>
		</Grid>

		<Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
			<TextBox Grid.Column="0"
					 Text="{Binding SearchText, Mode=TwoWay}"
					 PlaceholderText="{loc:Loc addon.settings.packs.search.placeholder}"/>
			<ComboBox Grid.Column="1"
					  ItemsSource="{Binding PackFilters}"
					  SelectedItem="{Binding SelectedPackFilter}"
					  Margin="8,0,0,0"
					  MinWidth="170">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="local:AddonPackFilterItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.packs.empty}"
				   Opacity="0.5"
				   TextWrapping="Wrap"
				   IsVisible="{Binding HasPacks, Converter={StaticResource InverseBooleanConverter}}"/>

		<ItemsControl ItemsSource="{Binding Packs}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Vertical" Spacing="6"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:AddonPackItemViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,6">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<CheckBox Grid.Column="0"
									  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
									  IsVisible="{Binding IsConfigurable}"
									  VerticalAlignment="Center"
									  Margin="0,0,8,0"/>

							<StackPanel Grid.Column="1"
										Spacing="2">
								<TextBlock Text="{Binding Name}"
										   FontWeight="Bold"/>
								<Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
									<Button Grid.Column="0"
											Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
											CommandParameter="{Binding Path}"
											Classes="MiniIconButton"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc env.open_in_explorer}">
										<ico:VisualIcon Kind="OpenInNew"/>
									</Button>
									<TextBlock Grid.Column="1"
													   Text="{Binding Path}"
													   FontFamily="Consolas"
													   FontSize="11"
													   Opacity="0.7"
														 VerticalAlignment="Center"
													   TextWrapping="Wrap"/>
								</Grid>
								
								<TextBlock Text="{Binding Description}"
										   Opacity="0.7"
										   TextWrapping="Wrap"
										   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>
							</StackPanel>

							<StackPanel Grid.Column="2"
										Spacing="2"
										HorizontalAlignment="Right">
								<TextBlock Text="{Binding SourceDisplay}"
												   Opacity="0.6"
												   FontSize="11"/>
								<TextBlock Text="{loc:Loc addon.settings.pack.manifest_invalid}"
										   Foreground="{DynamicResource DangerBrush}"
										   FontSize="11"
										   HorizontalAlignment="Right"
										   IsVisible="{Binding IsManifestInvalid}"/>
							</StackPanel>
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</StackPanel>

</UserControl>
