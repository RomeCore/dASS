<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:cards="using:LLMDesktopAssistant.Addons.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.ChatSkillsSettingsView"
			 x:DataType="local:ChatSkillsSettingsViewModel"
			 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- Available skills header -->
		<Grid ColumnDefinitions="*,Auto,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.skills.available}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<Button Grid.Column="1"
					Command="{Binding CreateSkillCommand}"
					Classes="IconButton"
					Margin="0,0,4,0"
					ToolTip.Tip="{loc:Loc settings.skills.create}">
				<ico:VisualIcon Kind="FilePlusOutline"/>
			</Button>

			<Button Grid.Column="2"
					Command="{Binding List.RefreshCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc settings.skills.refresh}">
				<ico:VisualIcon Kind="Refresh"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc settings.skills.available.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<!-- Search + list -->
		<cards:AddonListView DataContext="{Binding List}"/>

	</StackPanel>

</UserControl>
