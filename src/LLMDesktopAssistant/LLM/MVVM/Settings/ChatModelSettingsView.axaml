<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:ctrl="clr-namespace:LLMDesktopAssistant.Controls"
			 x:Class="LLMDesktopAssistant.LLM.Settings.ChatModelSettingsView"
			 x:DataType="local:ChatModelSettingsViewModel">

	<StackPanel Orientation="Vertical" Margin="8" Spacing="8">

		<!-- ============================================================ -->
		<!-- MODELS -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.chat.models}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static local:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedSelectionInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="local:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc settings.chat.models.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"
				   Margin="0,0,0,8"/>

		<TextBlock Text="{loc:Loc settings.chat.model.chat.hint}"
				   Margin="0,2"/>
		<ctrl:ModelSelectorControl SelectedModel="{Binding EffectiveSelection.ChatModel, Mode=TwoWay}"/>

		<TextBlock Text="{loc:Loc settings.chat.model.router.hint}"
				   Margin="0,2"/>
		<ctrl:ModelSelectorControl SelectedModel="{Binding EffectiveSelection.AgenticRouterModel, Mode=TwoWay}"/>

		<TextBlock Text="{loc:Loc settings.chat.model.tools.hint}"
				   Margin="0,2"/>
		<ctrl:ModelSelectorControl SelectedModel="{Binding EffectiveSelection.AgenticToolsModel, Mode=TwoWay}"/>

		<TextBlock Text="{loc:Loc settings.chat.model.vision.hint}"
				   Margin="0,2"/>
		<ctrl:ModelSelectorControl SelectedModel="{Binding EffectiveSelection.VisionModel, Mode=TwoWay}"/>

	</StackPanel>

</UserControl>
