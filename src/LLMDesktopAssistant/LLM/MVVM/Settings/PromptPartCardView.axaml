<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:ctrls="using:LLMDesktopAssistant.Controls"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.PromptPartCardView"
			 x:DataType="local:PromptPartCardViewModel">

	<UserControl.Styles>

		<Style Selector="Border.Chip">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TextBlock.ChipText">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Opacity" Value="0.8"/>
		</Style>

		<Style Selector="Border.ChipRed">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="BorderBrush" Value="#B71C1C"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Border.ChipGreen">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="BorderBrush" Value="#2E7D32"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.ChipButton">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.ChipButton:pointerover">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

	</UserControl.Styles>

	<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
					BorderThickness="1"
					CornerRadius="4"
					Padding="8">

		<StackPanel Orientation="Vertical" Spacing="4">

			<!-- ============================================================ -->
			<!-- Row 0: Selection | Kind | Name | Selected | Broken           -->
			<!-- ============================================================ -->
			<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">

				<!-- Multi-selection checkbox (components) -->
				<CheckBox Grid.Column="0"
								  IsChecked="{Binding IsSelected, Mode=TwoWay}"
								  IsVisible="{Binding IsRadio, Converter={StaticResource InverseBooleanConverter}}"
								  VerticalAlignment="Center"/>

				<!-- Single-selection radio button (slot elements) -->
				<Button Grid.Column="0"
								Classes="IconButton"
								Command="{Binding SelectCommand}"
								ToolTip.Tip="{loc:Loc prompt.card.use}"
								IsVisible="{Binding IsRadio}"
								VerticalAlignment="Center">
					<ico:VisualIcon Kind="{Binding SelectionIcon}" Width="18" Height="18"/>
				</Button>

				<!-- Kind Chip -->
				<Border Grid.Column="1" Classes="Chip" Margin="6,0,4,0" IsVisible="{Binding HasKind}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:VisualIcon Kind="{Binding KindIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{loc:Loc {Binding KindNameKey}}"/>
					</StackPanel>
				</Border>

				<!-- Name -->
				<TextBlock Grid.Column="2"
								   Text="{Binding Name}"
								   FontWeight="Bold"
								   Margin="4,0,8,0"
								   VerticalAlignment="Center"
								   TextTrimming="CharacterEllipsis"/>

				<!-- Selected Chip -->
				<Border Grid.Column="3" Classes="ChipGreen"
								IsVisible="{Binding IsSelected}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:VisualIcon Kind="Check" Width="12" Height="12" Foreground="#4CAF50" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{loc:Loc prompt.card.selected}" Foreground="#4CAF50"/>
					</StackPanel>
				</Border>

				<!-- Broken Chip -->
				<Border Grid.Column="4" Classes="ChipRed"
								IsVisible="{Binding IsBroken}"
								ToolTip.Tip="{Binding Error}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:VisualIcon Kind="AlertCircle" Width="12" Height="12" Foreground="#FF5252" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{loc:Loc prompt.card.broken}" Foreground="#FF5252"/>
					</StackPanel>
				</Border>

			</Grid>

			<!-- ============================================================ -->
			<!-- Row 1: Description                                           -->
			<!-- ============================================================ -->
			<TextBlock Text="{Binding Description}"
							   TextWrapping="Wrap"
							   Opacity="0.7"
							   FontSize="12"
							   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

			<!-- ============================================================ -->
			<!-- Row 2: Chips: source, category, language                     -->
			<!-- ============================================================ -->
			<WrapPanel>

				<Button Classes="ChipButton"
								Command="{Binding FilterByCategoryCommand}"
								CommandParameter="{Binding Category}"
								ToolTip.Tip="{loc:Loc prompt.search.placeholder}"
								IsVisible="{Binding HasCategory}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:VisualIcon Kind="TagOutline" Width="12" Height="12" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{Binding Category}"/>
					</StackPanel>
				</Button>

				<Border Classes="Chip" ToolTip.Tip="{loc:Loc prompt.metadata.language}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:VisualIcon Kind="Language" Width="12" Height="12" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{Binding LocalizedForName}"
									   IsVisible="{Binding LocalizedForName, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>
						<TextBlock Classes="ChipText" Text="→"
									   IsVisible="{Binding LocalizedForName, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>
						<TextBlock Classes="ChipText" Text="{Binding LanguageName}"/>
					</StackPanel>
				</Border>

				<!-- Source indicator -->
				<StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="4,0,0,0">
					<ico:VisualIcon Kind="{Binding SourceIcon}" Width="12" Height="12" Opacity="0.5" VerticalAlignment="Center"/>
					<TextBlock Text="{loc:Loc {Binding SourceNameKey}}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
				</StackPanel>

			</WrapPanel>

			<!-- ============================================================ -->
			<!-- Row 3: Diagnostic Chips                                      -->
			<!-- ============================================================ -->
			<StackPanel Orientation="Horizontal" Spacing="4"
									IsVisible="{Binding HasDiagnostics}">
				<ItemsControl ItemsSource="{Binding DiagnosticFlags}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:PromptPartDiagnosticFlagInfo">
							<Border Classes="Chip" ToolTip.Tip="{loc:Loc {Binding DescriptionKey}}">
								<StackPanel Orientation="Horizontal" Spacing="3">
									<ico:VisualIcon Kind="{Binding Icon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding Color}"/>
									<TextBlock Classes="ChipText" Foreground="{Binding Color}" Text="{loc:Loc {Binding DisplayNameKey}}"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<!-- ============================================================ -->
			<!-- Row 4: Actions                                               -->
			<!-- ============================================================ -->
			<Grid ColumnDefinitions="*,Auto">

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">

					<!-- TODO: prompt part management dialogs are not implemented yet.
						 These buttons are placeholders and will be enabled once the
						 editing/management dialogs are ready. -->
					<Button Command="{Binding EditCommand}"
							ToolTip.Tip="{loc:Loc prompt.todo}"
							Padding="4" IsEnabled="False">
						<ico:VisualIcon Kind="Pencil" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding OpenFileCommand}"
							ToolTip.Tip="{loc:Loc prompt.todo}"
							Padding="4" IsEnabled="False">
						<ico:VisualIcon Kind="OpenInNew" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding ShowInExplorerCommand}"
							ToolTip.Tip="{loc:Loc prompt.todo}"
							Padding="4" IsEnabled="False">
						<ico:VisualIcon Kind="FolderOpen" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding DuplicateCommand}"
							ToolTip.Tip="{loc:Loc prompt.todo}"
							Padding="4" IsEnabled="False">
						<ico:VisualIcon Kind="ContentCopy" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding DeleteCommand}"
							ToolTip.Tip="{loc:Loc prompt.todo}"
							Padding="4" IsEnabled="False">
						<ico:VisualIcon Kind="Delete" Width="14" Height="14"/>
					</Button>

					<ToggleButton Command="{Binding ToggleParametersCommand}"
								  IsChecked="{Binding IsParametersVisible, Mode=OneWay}"
								  ToolTip.Tip="{loc:Loc prompt.card.parameters}"
								  Padding="4"
								  IsVisible="{Binding CanShowParameters}">
						<ico:VisualIcon Kind="Tune" Width="14" Height="14"/>
					</ToggleButton>

					<ToggleButton Command="{Binding ToggleDetailsCommand}"
								  IsChecked="{Binding IsDetailsVisible, Mode=OneWay}"
								  ToolTip.Tip="{loc:Loc prompt.card.details}"
								  Padding="4">
						<ico:VisualIcon Kind="CardAccountDetailsOutline" Width="14" Height="14"/>
					</ToggleButton>

				</StackPanel>

			</Grid>

			<!-- ============================================================ -->
			<!-- Row 5: Parameters content                                    -->
			<!-- ============================================================ -->
			<Border Background="#11000000"
							CornerRadius="4"
							Padding="8"
							IsVisible="{Binding IsParametersVisible}">
				<ctrls:ParameterEditorControl Schema="{Binding Part.ParameterSchema}"
													  Value="{Binding Selection.Parameters}"/>
			</Border>

			<!-- ============================================================ -->
			<!-- Row 6: Details content                                       -->
			<!-- ============================================================ -->
			<StackPanel Spacing="8"
									IsVisible="{Binding IsDetailsVisible}">

				<!-- Template body -->
				<StackPanel Spacing="2" IsVisible="{Binding HasTemplateBody}">
					<TextBlock Text="{loc:Loc prompt.card.template_body}"
									   FontWeight="SemiBold"
									   Opacity="0.8"
									   FontSize="12"/>
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8">
						<ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
							<TextBlock Text="{Binding TemplateBody}"
											   FontFamily="Cascadia Mono,Consolas,monospace"
											   FontSize="11"
											   Opacity="0.8"
											   TextWrapping="Wrap"/>
						</ScrollViewer>
					</Border>
				</StackPanel>

				<!-- Metadata -->
				<StackPanel Spacing="2" IsVisible="{Binding MetadataItems.Count}">
					<TextBlock Text="{loc:Loc prompt.card.metadata}"
									   FontWeight="SemiBold"
									   Opacity="0.8"
									   FontSize="12"/>
					<ItemsControl ItemsSource="{Binding MetadataItems}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:PromptPartMetadataItem">
								<Grid ColumnDefinitions="Auto,*" Margin="0,1">
									<TextBlock Grid.Column="0"
													   Text="{loc:Loc {Binding Key}}"
													   FontWeight="SemiBold"
													   Opacity="0.8"
													   Margin="0,0,8,0"/>
									<TextBlock Grid.Column="1"
													   Text="{Binding Value}"
													   Opacity="0.7"
													   TextWrapping="Wrap"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

			</StackPanel>

		</StackPanel>

	</Border>

</UserControl>
