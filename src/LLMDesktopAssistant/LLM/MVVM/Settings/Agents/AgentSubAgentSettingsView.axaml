<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:cards="using:LLMDesktopAssistant.Addons.MVVM"
			 xmlns:settings="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentSubAgentSettingsView"
			 x:DataType="local:AgentSubAgentSettingsViewModel">

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable sub-agents checkbox -->
		<CheckBox IsChecked="{Binding SubAgentSettings.EnableSubAgents}"
				  Content="{loc:Loc settings.sub_agents.enable}"/>

		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.agent.sub_agents.sub_agent_list}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllAgent}"
					  SelectedItem="{Binding SelectedSubAgentChangesInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc settings.agent.sub_agents.sub_agent_list.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"/>

		<CheckBox IsChecked="{Binding EffectiveSubAgentset.EnabledByDefault, Mode=TwoWay}"
				  Content="{loc:Loc subagent.sub_agents_enabled_by_default}"/>

		<TextBlock Text="{loc:Loc subagent.sub_agents_enabled_by_default.hint}"
				   Opacity="0.5"
				   FontSize="11"
				   Margin="24,0,0,4"
				   TextWrapping="Wrap"/>

		<CheckBox IsChecked="{Binding EffectiveSubAgentset.HiddenByDefault, Mode=TwoWay}"
				  Content="{loc:Loc subagent.sub_agents_hidden_by_default}"/>

		<TextBlock Text="{loc:Loc subagent.sub_agents_hidden_by_default.hint}"
				   Opacity="0.5"
				   FontSize="11"
				   Margin="24,0,0,4"
				   TextWrapping="Wrap"/>

		<!-- Search + list -->
		<ContentControl IsEnabled="{Binding SubAgentSettings.EnableSubAgents}">
			<cards:AddonListView DataContext="{Binding List}"/>
		</ContentControl>

	</StackPanel>

</UserControl>
