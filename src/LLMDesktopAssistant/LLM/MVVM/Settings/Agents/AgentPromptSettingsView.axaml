<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:card="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:ctrls="using:LLMDesktopAssistant.Controls"
			 xmlns:set="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="850"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentPromptSettingsView"
			 x:DataType="local:AgentPromptSettingsViewModel">

	<StackPanel Margin="8" Spacing="8">

		<!-- Preview Toggle -->
		<StackPanel Orientation="Horizontal"
					Spacing="6"
					Margin="0,0,0,4">

			<ToggleButton Command="{Binding TogglePreviewCommand}"
						  ToolTip.Tip="{loc:Loc prompt.preview.toggle}"
						  IsChecked="{Binding IsPreviewVisible, Mode=OneWay}">

				<StackPanel Orientation="Horizontal" Spacing="8">

					<ico:VisualIcon Kind="Eye" Width="18" Height="18"/>

					<TextBlock Text="{loc:Loc prompt.preview.header}"
							   FontWeight="Bold"
							   VerticalAlignment="Center"/>

				</StackPanel>

			</ToggleButton>

		</StackPanel>

		<!-- Preview Content -->
		<TextBox IsVisible="{Binding IsPreviewVisible}"
				 Text="{Binding SystemPromptPreview}"
				 IsReadOnly="True"
				 AcceptsReturn="True"
				 TextWrapping="Wrap"
				 FontFamily="Cascadia Code,Consolas,monospace"
				 FontSize="12"
				 MinHeight="60"
				 MaxHeight="450"
				 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   IsVisible="{Binding IsPreviewVisible}"/>

		<!-- ============================================================ -->
		<!-- PROMPT LIBRARY SEARCH / PICKER                               -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6">

			<Grid ColumnDefinitions="*,Auto">

				<TextBox Grid.Column="0"
						 Text="{Binding SearchText, Mode=TwoWay}"
						 PlaceholderText="{loc:Loc prompt.search.placeholder}">

					<TextBox.InnerLeftContent>
						<ico:VisualIcon Kind="TextBoxSearch"
										  Width="16" Height="16"
										  Margin="6,0"
										  VerticalAlignment="Center"
										  Opacity="0.5"/>
					</TextBox.InnerLeftContent>

				</TextBox>

				<ComboBox Grid.Column="1"
						  ItemsSource="{Binding TypeFilters}"
						  SelectedItem="{Binding SelectedTypeFilter}"
						  MinWidth="130"
						  Margin="6,0,0,0"
						  VerticalAlignment="Center">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="local:PromptPartTypeFilterItem">
							<TextBlock Text="{loc:Loc {Binding DisplayNameKey}}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>
			
			<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
					BorderThickness="1"
					CornerRadius="4">
				<ScrollViewer MaxHeight="500"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<StackPanel Spacing="6">
						
						<!-- Empty state -->
						<TextBlock Text="{loc:Loc prompt.empty}"
											 Opacity="0.5"
											 Margin="12"
											 TextWrapping="Wrap"
											 IsVisible="{Binding IsSearchEmpty}"/>

						<ItemsControl ItemsSource="{Binding SearchResults}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Vertical" Spacing="8"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="card:PromptPartCardViewModel">
									<card:PromptPartCardView/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

					</StackPanel>
				</ScrollViewer>
			</Border>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,2"/>

		<!-- ============================================================ -->
		<!-- SYSTEM PROMPT SECTION                                        -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6">

			<Grid ColumnDefinitions="*,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.system_prompt}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedSystemPromptInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<CheckBox IsChecked="{Binding SystemPromptSection.UseCustom, Mode=TwoWay}"
					  Content="{loc:Loc prompt.use_custom_system_prompt}"/>

			<TextBox IsVisible="{Binding SystemPromptSection.IsCustom}"
					 Text="{Binding SystemPromptSection.CustomText, Mode=TwoWay}"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 MinHeight="80"
					 MaxHeight="200"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 PlaceholderText="{loc:Loc prompt.system_prompt.placeholder}"/>

			<StackPanel Spacing="6" IsVisible="{Binding SystemPromptSection.IsPreset}">

				<Grid ColumnDefinitions="*,Auto">

					<ComboBox Grid.Column="0"
							  ItemsSource="{Binding SystemPromptSection.Options}"
							  SelectedItem="{Binding SystemPromptSection.SelectedOption}"
							  PlaceholderText="{loc:Loc prompt.select_system_prompt}"
							  HorizontalAlignment="Stretch">

						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="local:PromptPartOptionViewModel">
								<TextBlock Text="{Binding Name}"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>

					</ComboBox>

					<Button Grid.Column="1"
							Classes="IconButton"
							Command="{Binding SystemPromptSection.ClearCommand}"
							ToolTip.Tip="{loc:Loc prompt.system_prompt.clear}"
							Margin="4,0,0,0"
							VerticalAlignment="Center">

						<ico:VisualIcon Kind="Remove"/>

					</Button>

				</Grid>

				<ctrls:ParameterEditorControl Schema="{Binding SystemPromptSection.SelectedOption.Element.ParameterSchema}"
														Value="{Binding SystemPromptSection.Settings.Parameters}"
														IsVisible="{Binding SystemPromptSection.HasParameters}"/>

			</StackPanel>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,4"/>

		<!-- ============================================================ -->
		<!-- COMPONENTS SECTION                                           -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6">

			<Grid ColumnDefinitions="*,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.components}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedComponentsInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<TextBlock Text="{loc:Loc prompt.components.hint}"
					   Opacity="0.6"
					   TextWrapping="Wrap"/>

			<TreeView ItemsSource="{Binding ComponentCategories}"
					  BorderThickness="0">

				<TreeView.DataTemplates>

					<TreeDataTemplate DataType="local:ComponentCategoryViewModel"
									  ItemsSource="{Binding Components}">

						<TextBlock Text="{Binding CategoryName}"
								   FontWeight="Bold"
								   Margin="0,2"/>

					</TreeDataTemplate>

					<DataTemplate DataType="local:ComponentItemViewModel">

						<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
								  Content="{Binding Name}"
								  Margin="16,1,0,1"/>

					</DataTemplate>

				</TreeView.DataTemplates>

			</TreeView>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,4"/>

		<!-- ============================================================ -->
		<!-- PERSONA SECTION                                              -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6">

			<Grid ColumnDefinitions="*,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.persona}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedPersonaInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<!-- Nickname -->
			<TextBlock Text="{loc:Loc prompt.assistant_nickname.hint}"
					   Opacity="0.6"/>

			<TextBox Text="{Binding PersonaSection.Settings.Nickname, Mode=TwoWay}"
					 TextWrapping="NoWrap"
					 PlaceholderText="{loc:Loc prompt.user_nickname.placeholder}"/>

			<CheckBox IsChecked="{Binding PersonaSection.UseCustom, Mode=TwoWay}"
					  Content="{loc:Loc prompt.use_custom_persona}"/>

			<TextBox IsVisible="{Binding PersonaSection.IsCustom}"
					 Text="{Binding PersonaSection.CustomText, Mode=TwoWay}"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 MinHeight="100"
					 MaxHeight="200"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 PlaceholderText="{loc:Loc prompt.custom_persona.placeholder}"/>

			<StackPanel Spacing="6" IsVisible="{Binding PersonaSection.IsPreset}">

				<Grid ColumnDefinitions="*,Auto">

					<ComboBox Grid.Column="0"
							  ItemsSource="{Binding PersonaSection.Options}"
							  SelectedItem="{Binding PersonaSection.SelectedOption}"
							  PlaceholderText="{loc:Loc prompt.select_persona}"
							  HorizontalAlignment="Stretch">

						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="local:PromptPartOptionViewModel">
								<TextBlock Text="{Binding Name}"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>

					</ComboBox>

					<Button Grid.Column="1"
							Classes="IconButton"
							Command="{Binding PersonaSection.ClearCommand}"
							ToolTip.Tip="{loc:Loc prompt.persona.clear}"
							Margin="4,0,0,0"
							VerticalAlignment="Center">

						<ico:VisualIcon Kind="Remove"/>

					</Button>

				</Grid>

				<ctrls:ParameterEditorControl Schema="{Binding PersonaSection.SelectedOption.Element.ParameterSchema}"
														Value="{Binding PersonaSection.Settings.Parameters}"
														IsVisible="{Binding PersonaSection.HasParameters}"/>

			</StackPanel>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,4"/>

		<!-- ============================================================ -->
		<!-- SPECIALIZATION SECTION                                       -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6">

			<Grid ColumnDefinitions="*,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.specialization}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedSpecializationInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<TextBlock Text="{loc:Loc prompt.specialization.hint}"
					   Opacity="0.6"
					   TextWrapping="Wrap"/>

			<CheckBox IsChecked="{Binding SpecializationSection.UseCustom, Mode=TwoWay}"
					  Content="{loc:Loc prompt.use_custom_specialization}"/>

			<TextBox IsVisible="{Binding SpecializationSection.IsCustom}"
					 Text="{Binding SpecializationSection.CustomText, Mode=TwoWay}"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 MinHeight="100"
					 MaxHeight="200"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 PlaceholderText="{loc:Loc prompt.custom_specialization.placeholder}"/>

			<StackPanel Spacing="6" IsVisible="{Binding SpecializationSection.IsPreset}">

				<Grid ColumnDefinitions="*,Auto">

					<ComboBox Grid.Column="0"
							  ItemsSource="{Binding SpecializationSection.Options}"
							  SelectedItem="{Binding SpecializationSection.SelectedOption}"
							  PlaceholderText="{loc:Loc prompt.select_specialization}"
							  HorizontalAlignment="Stretch">

						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="local:PromptPartOptionViewModel">
								<TextBlock Text="{Binding Name}"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>

					</ComboBox>

					<Button Grid.Column="1"
							Classes="IconButton"
							Command="{Binding SpecializationSection.ClearCommand}"
							ToolTip.Tip="{loc:Loc prompt.specialization.clear}"
							Margin="4,0,0,0"
							VerticalAlignment="Center">

						<ico:VisualIcon Kind="Remove"/>

					</Button>

				</Grid>

				<ctrls:ParameterEditorControl Schema="{Binding SpecializationSection.SelectedOption.Element.ParameterSchema}"
														Value="{Binding SpecializationSection.Settings.Parameters}"
														IsVisible="{Binding SpecializationSection.HasParameters}"/>

			</StackPanel>

		</StackPanel>

	</StackPanel>

</UserControl>
