<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:set="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentMemorySettingsView"
			 x:DataType="local:AgentMemorySettingsViewModel"
			 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable memory checkbox -->
		<CheckBox IsChecked="{Binding MemorySettings.EnableMemory}"
							Content="{loc:Loc settings.agent.memory.enable}"/>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<!-- ============================================================ -->
		<!-- ATTACHED MEMORY BLOCKS -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
								 Text="{loc:Loc settings.agent.memory.blocks}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
								SelectedItem="{Binding SelectedBlocksInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<TextBlock Text="{loc:Loc settings.agent.memory.blocks.hint}"
							Opacity="0.6"
							TextWrapping="Wrap"/>

		<!-- Add / attach existing block -->
		<Grid ColumnDefinitions="Auto,*,Auto"
					IsEnabled="{Binding MemorySettings.EnableMemory}">

			<Button Grid.Column="0"
							Command="{Binding AddBlockCommand}"
							Content="{loc:Loc settings.agent.memory.add_block}"/>

			<ComboBox Grid.Column="1"
								Margin="8,0"
								MinWidth="150"
								VerticalAlignment="Center"
								HorizontalAlignment="Right"
								PlaceholderText="{loc:Loc settings.agent.memory.attach.placeholder}"
								ItemsSource="{Binding AvailableBlockIds}"
								SelectedItem="{Binding SelectedAvailableBlockId}">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="local:MemoryBlockIdItemViewModel">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="{Binding Name}"/>
							<TextBlock Text="{Binding Id}"
													 Opacity="0.5"
													 FontSize="11"
													 VerticalAlignment="Center"/>
						</StackPanel>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

			<Button Grid.Column="2"
							Command="{Binding AttachBlockCommand}"
							Content="{loc:Loc settings.agent.memory.attach}"/>

		</Grid>

		<!-- Attached blocks as cards -->
		<ItemsControl ItemsSource="{Binding BlockItems}"
							IsEnabled="{Binding MemorySettings.EnableMemory}">

			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:MemoryBlockAttachmentItemViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8"
									Margin="0,0,0,8">
						<Grid RowDefinitions="Auto,Auto,Auto"
									ColumnDefinitions="Auto,*,Auto,Auto,Auto"
									ColumnSpacing="6">

							<!-- Row 0: Enabled | Name (id) | Mode | Edit | Remove -->
							<CheckBox Grid.Row="0" Grid.Column="0"
												IsChecked="{Binding Enabled, Mode=TwoWay}"
												VerticalAlignment="Center"/>

							<StackPanel Grid.Row="0" Grid.Column="1"
													VerticalAlignment="Center">
								<TextBlock Text="{Binding Name}"
													 FontWeight="Bold"
													 TextTrimming="CharacterEllipsis"
													 ToolTip.Tip="{Binding Name}"/>
								<TextBlock Text="{Binding BlockId}"
													 Opacity="0.5"
													 FontSize="11"
													 TextTrimming="CharacterEllipsis"
													 ToolTip.Tip="{Binding BlockId}"/>
							</StackPanel>

							<ComboBox Grid.Row="0" Grid.Column="2"
												SelectedItem="{Binding Mode, Mode=TwoWay}"
												ItemsSource="{Binding ModeList}"
												MinWidth="110"
												VerticalAlignment="Center">

								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="local:MemoryBlockAttachmentModeItem">
										<TextBlock Text="{Binding DisplayName}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>

							</ComboBox>

							<Button Grid.Row="0" Grid.Column="3"
											Command="{Binding #VMRoot.DataContext.EditBlockCommand}"
											CommandParameter="{Binding}"
											Classes="IconButton"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc settings.agent.memory.edit}">

								<ico:VisualIcon Kind="Edit"/>
							</Button>

							<Button Grid.Row="0" Grid.Column="4"
											Command="{Binding RemoveCommand}"
											Classes="IconButton"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc settings.agent.memory.remove}">

								<ico:VisualIcon Kind="Delete"/>
							</Button>

							<!-- Row 1: Description -->
							<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
												 Text="{Binding Description}"
												 Opacity="0.6"
												 FontSize="12"
												 TextWrapping="Wrap"
												 Margin="0,2,0,0"
												 IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

							<!-- Row 2: Invalid settings warning -->
							<TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
												 Text="{Binding InvalidSettingsMessage}"
												 Foreground="{DynamicResource WarningBrush}"
												 FontSize="12"
												 TextWrapping="Wrap"
												 Margin="0,2,0,0"
												 IsVisible="{Binding HasInvalidSettings}"/>

						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>

		</ItemsControl>

	</StackPanel>

</UserControl>
