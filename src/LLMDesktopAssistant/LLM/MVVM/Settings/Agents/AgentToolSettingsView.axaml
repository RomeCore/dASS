<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:sett="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:set="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:appset="using:LLMDesktopAssistant.Settings"
			 xmlns:llmsg="using:LLMDesktopAssistant.LLM.MVVM.Messages"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						  xmlns:cards="using:LLMDesktopAssistant.Addons.MVVM"
			 xmlns:flui="using:FluentAvalonia.UI"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentToolSettingsView"
			 x:DataType="local:AgentToolSettingsViewModel">

	<UserControl.Styles>
		<Style Selector="ToggleButton.MaskToggle">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Style Selector="^ > ico|MaterialIcon">
				<Setter Property="Width" Value="24"/>
				<Setter Property="Height" Value="24"/>
			</Style>
		</Style>

		<Style Selector="ToggleButton.MaskToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#22FFFFFF"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="ToggleButton.MaskToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#5522AA44"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="ToggleButton.MaskToggle:unchecked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#55AA2244"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="ToggleButton.MaskToggle:indeterminate /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
	</UserControl.Styles>

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable tools checkbox -->
		<CheckBox IsChecked="{Binding ToolSettings.EnableTools}"
							Content="{loc:Loc settings.tools.enable}"/>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<!-- ============================================================ -->
		<!-- BEHAVIOUR POLICY -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
								 Text="{loc:Loc settings.agent.tools.behaviour_policy}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
								SelectedItem="{Binding SelectedPolicyInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<ItemsControl ItemsSource="{Binding PolicyMaskCategoryItems}"
									IsEnabled="{Binding ToolSettings.EnableTools}">

			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel ItemSpacing="8" LineSpacing="8"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:ToolBehaviourCategoryViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8">
						<StackPanel Orientation="Vertical" Spacing="6">
							
							<TextBlock Text="{loc:Loc {Binding Title}}"
											   TextTrimming="CharacterEllipsis"
											   VerticalAlignment="Center"/>

							<ItemsControl ItemsSource="{Binding Toggles}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="4"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ToolBehaviourMaskItem">
										<ToggleButton Classes="MaskToggle"
																	IsThreeState="True"
																	IsChecked="{Binding IsChecked, Mode=TwoWay}"
																	IsEnabled="{Binding !IsNone}"
																	ToolTip.ShowOnDisabled="True">
											<ToolTip.Tip>
												<StackPanel Orientation="Vertical" Spacing="4">
													<TextBlock Text="{loc:Loc {Binding DisplayName}}"
																		 FontSize="{DynamicResource FontSizeM}"
																		 FontWeight="SemiBold"/>
													<TextBlock Text="{loc:Loc {Binding Description}}"/>
													<TextBlock Text="{loc:Loc {Binding StateName}}"
																		 Foreground="{Binding StateColor}"
																		 FontSize="11"/>
												</StackPanel>
											</ToolTip.Tip>
											<ico:MaterialIcon Kind="{Binding Icon}"
																				Foreground="{Binding Color}"/>
										</ToggleButton>
									</DataTemplate>
								</ItemsControl.ItemTemplate>

							</ItemsControl>

						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<!-- ============================================================ -->
		<!-- TOOLSET -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
								 Text="{loc:Loc tool.settings}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
								SelectedItem="{Binding SelectedToolsetInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<CheckBox IsChecked="{Binding UseCustomToolset}"
							Content="{loc:Loc toolset.use_custom}"
							IsEnabled="{Binding ToolSettings.EnableTools}"/>

		<TextBlock Text="{loc:Loc toolset.use_custom.hint}"
							Opacity="0.6"
							TextWrapping="Wrap"
							IsEnabled="{Binding ToolSettings.EnableTools}"/>

		<!-- Shared toolset name editor -->
		<StackPanel Orientation="Horizontal"
								Spacing="4"
								IsVisible="{Binding !UseCustomToolset}"
								IsEnabled="{Binding ToolSettings.EnableTools}">

			<TextBlock Text="{loc:Loc toolset.shared}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"
								 Margin="0,0,4,0"/>

			<StackPanel Orientation="Horizontal"
									Spacing="4"
									IsVisible="{Binding !IsEditingId}">

				<ComboBox MinWidth="150"
									VerticalAlignment="Center"
									SelectedItem="{Binding SelectedToolsetId}"
									ItemsSource="{Binding ToolsetIds}">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="appset:SettingsIdItemViewModel">
							<TextBlock Text="{Binding DisplayId}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

				<Button Command="{Binding CreateNewIdCommand}"
								Classes="IconButton"
								ToolTip.Tip="{loc:Loc toolset.create}">

					<ico:MaterialIcon Kind="Plus"/>
				</Button>

				<Button Command="{Binding RenameIdCommand}"
								Classes="IconButton"
								ToolTip.Tip="{loc:Loc toolset.rename}">

					<ico:MaterialIcon Kind="Edit"/>
				</Button>

				<Button Command="{Binding RemoveIdCommand}"
								Classes="IconButton"
								ToolTip.Tip="{loc:Loc toolset.remove}">

					<ico:MaterialIcon Kind="Remove"/>
				</Button>

			</StackPanel>

			<StackPanel Orientation="Horizontal"
									Spacing="4"
									IsVisible="{Binding IsEditingId}">

				<TextBox MinWidth="150"
								 VerticalAlignment="Center"
								 Text="{Binding NewId}"/>

				<Button Command="{Binding ConfirmEditIdCommand}"
								Classes="IconButton">

					<ico:MaterialIcon Kind="Check"/>
				</Button>

				<Button Command="{Binding CancelEditIdCommand}"
								Classes="IconButton">

					<ico:MaterialIcon Kind="Cancel"/>
				</Button>

			</StackPanel>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<CheckBox IsChecked="{Binding EffectiveToolsetConfiguration.EnabledByDefault, Mode=TwoWay}"
							Content="{loc:Loc toolset.tools_enabled_by_default}"/>

		<TextBlock Text="{loc:Loc toolset.tools_enabled_by_default.hint}"
							 Opacity="0.5"
							 FontSize="11"
							 Margin="24,0,0,4"
							 TextWrapping="Wrap"/>
		
		<CheckBox IsChecked="{Binding EffectiveToolsetConfiguration.HiddenByDefault, Mode=TwoWay}"
							Content="{loc:Loc toolset.tools_hidden_by_default}"/>

		<TextBlock Text="{loc:Loc toolset.tools_hidden_by_default.hint}"
							 Opacity="0.5"
							 FontSize="11"
							 Margin="24,0,0,4"
							 TextWrapping="Wrap"/>

		<Grid ColumnDefinitions="Auto,*"
					Margin="0,4,0,0">

			<TextBlock Grid.Column="0"
								 Text="{loc:Loc toolset.default_approval_level}"
								 VerticalAlignment="Center"
								 Margin="0,0,8,0"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{Binding DefaultApprovalLevelList}"
								SelectedItem="{Binding DefaultApprovalLevel, Mode=TwoWay}"
								MinWidth="200"
								HorizontalAlignment="Left">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="sett:ToolApprovalLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<!-- Tool list (the unified addon list: search, grouping modes and cards) -->
		<ContentControl IsEnabled="{Binding ToolSettings.EnableTools}">
			<cards:AddonListView DataContext="{Binding List}"/>
		</ContentControl>

	</StackPanel>

</UserControl>
