<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="clr-namespace:LLMDesktopAssistant.LLM.MVVM"
			 xmlns:loc="clr-namespace:LLMDesktopAssistant.Localization"
			 xmlns:beh="clr-namespace:LLMDesktopAssistant.Controls.Behaviours"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatView"
			 x:DataType="local:ChatViewModel">
	
	<Grid RowDefinitions="*,Auto">

		<!-- Messages Area -->
		<Panel Grid.Row="0">

			<!-- Agent Tasks button (top-right, mirrors ScrollToBottomButton) -->
			<Button x:Name="AgentTasksButton"
							Classes="BigIconButton"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Margin="32,16"
							ClipToBounds="False"
							ZIndex="10">

				<Panel>
					<ico:MaterialIcon Kind="{Binding AgentTaskIcon}"
									  Width="32" Height="32"/>

					<!-- Running task count badge -->
					<Border IsVisible="{Binding HasRunningTasks}"
							Background="#F44336"
							CornerRadius="9"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Padding="5,1"
							Margin="0,-6,-6,0"
							ZIndex="1">
						<TextBlock Text="{Binding RunningTaskCount}"
								   FontSize="10"
								   Foreground="White"
								   FontWeight="Bold"/>
					</Border>
				</Panel>

				<!-- Agent Tasks Popup -->
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedRight"
									HorizontalOffset="-16"
									VerticalOffset="4">
						
						<StackPanel Spacing="4" Orientation="Vertical">
							<StackPanel Orientation="Horizontal"
													Spacing="8"
													Margin="0,0,0,8">
								<ico:MaterialIcon Kind="TimerSandComplete"
																	Width="18" Height="18"
																	VerticalAlignment="Center"/>
								<TextBlock Text="{loc:Loc task.title}"
													 FontSize="15" FontWeight="Bold"
													 VerticalAlignment="Center"/>
							</StackPanel>
							<ScrollViewer MaxHeight="450">
								<ContentControl Content="{Binding AgentTaskList}"/>
							</ScrollViewer>
						</StackPanel>

					</Flyout>
				</Button.Flyout>
			</Button>

			<ScrollViewer x:Name="MessagesScrollViewer"
										ScrollChanged="MessagesScrollViewer_ScrollChanged"
										VerticalScrollBarVisibility="Visible"
										AllowAutoHide="False"
										BringIntoViewOnFocusChange="False"
										beh:ScrollViewerBehavior.AutoScrollEnabled="True">

				<StackPanel>
					<ContentControl Content="{Binding MessageSequence}"/>
					<ContentControl Content="{Binding ChatStatus}"/>
				</StackPanel>
			</ScrollViewer>

			<Button x:Name="ScrollToBottomButton"
							Classes="BigIconButton"
							Click="ScrollToBottomButton_Click"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Margin="32,16">
				<ico:MaterialIcon Kind="ArrowDown"/>
			</Button>

		</Panel>

		<!-- Input Area -->
		<Border Grid.Row="1"
						Padding="16,8"
						BorderBrush="{DynamicResource PrimaryAccentBrush}"
						BorderThickness="0,1,0,0">

			<ContentControl Content="{Binding ChatBottomPanel}"/>
		</Border>
	</Grid>
	
</UserControl>
