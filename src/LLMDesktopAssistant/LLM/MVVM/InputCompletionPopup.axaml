<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:llm="using:LLMDesktopAssistant.LLM.MVVM"
			 xmlns:ic="using:LLMDesktopAssistant.InputCompletion"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:conv="using:Avalonia.Data.Converters"
			 mc:Ignorable="d" d:DesignWidth="420"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.InputCompletionPopup"
			 x:DataType="llm:InputCompletionViewModel">

	<Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
			BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6"
			Padding="2"
			MinWidth="280"
			MaxWidth="520">
		<StackPanel>

			<TextBlock Text="{loc:Loc {Binding State.Title}}"
					   IsVisible="{Binding State.Title, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
					   FontWeight="SemiBold"
					   Margin="8,6,8,2"/>

			<ListBox ItemsSource="{Binding Items}"
					 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
					 Focusable="False"
					 Background="Transparent"
					 BorderThickness="0"
					 MaxHeight="220"
					 ScrollViewer.VerticalScrollBarVisibility="Auto">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Focusable" Value="False"/>
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="ic:InputCompletionItem">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<TextBlock Grid.Column="0"
									   Text="•"
									   Margin="0,0,6,0"
									   Foreground="#FFA500"
									   IsVisible="{Binding IsDefeated}"
									   ToolTip.Tip="{loc:Loc command.completion.defeated}"/>
							<TextBlock Grid.Column="1"
									   Text="{Binding DisplayText}"
									   TextTrimming="CharacterEllipsis"/>
							<TextBlock Grid.Column="2"
									   Text="{loc:Loc {Binding Description}}"
									   IsVisible="{Binding Description, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
									   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									   Margin="12,0,0,0"
									   TextTrimming="CharacterEllipsis"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<TextBlock Text="{loc:Loc command.completion.no_matches}"
					   IsVisible="{Binding IsStateOnly}"
					   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
					   Margin="8,6"/>

		</StackPanel>
	</Border>

</UserControl>
