<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:llm="using:LLMDesktopAssistant.LLM.MVVM"
			 xmlns:ic="using:LLMDesktopAssistant.InputCompletion"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 mc:Ignorable="d" d:DesignWidth="420"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.InputCompletionPopup"
			 x:DataType="llm:InputCompletionViewModel">

	<UserControl.Styles>
		<!-- The picker is a plain stack, so the selected row carries its own flag. -->
		<Style Selector="Border.selected">
			<Setter Property="Background" Value="{DynamicResource InputCompletionPopupSelectedBrush}"/>
		</Style>

		<!-- The argument the caret currently sits in. -->
		<Style Selector="TextBlock.current">
			<Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
	</UserControl.Styles>

	<!--
		The popup's chrome: a very dark, slightly purple surface with a lighter frame and a soft shadow, so it reads as
		something floating above the input rather than as another panel. The colours are theme resources (see
		Styles/Theme/InputCompletionTheme.axaml) and the placement above the input is the view's job (UserInputView).
	-->
	<Border Background="{DynamicResource InputCompletionPopupBackgroundBrush}"
			BorderBrush="{DynamicResource InputCompletionPopupBorderBrush}"
			BorderThickness="1"
			CornerRadius="10"
			BoxShadow="0 8 24 #4c000000"
			Padding="4"
			MinWidth="280"
			MaxWidth="520">
		<StackPanel>

			<!-- What the caret's region is: the command being typed, or the resolved command. -->
			<Grid ColumnDefinitions="Auto,*" Margin="8,6,8,2">
				<ico:VisualIcon Grid.Column="0"
								Kind="{Binding Icon}"
								Width="14" Height="14"
								VerticalAlignment="Top"
								Margin="0,2,6,0"/>
				<StackPanel Grid.Column="1">
					<TextBlock Text="{loc:Loc {Binding State.Title}}"
							   IsVisible="{Binding State.Title, Converter={StaticResource NotnullToBooleanConverter}}"
							   FontWeight="SemiBold"/>
					<TextBlock Text="{loc:Loc {Binding State.Description}}"
							   IsVisible="{Binding State.Description, Converter={StaticResource NotnullToBooleanConverter}}"
							   FontSize="12" Opacity="0.7"
							   TextWrapping="Wrap" MaxLines="3"/>
				</StackPanel>
			</Grid>

			<!-- The context block: the argument under the caret, and the arguments the command declares. -->
			<TextBlock Text="{loc:Loc {Binding State.ContextTitle}}"
					   IsVisible="{Binding State.ContextTitle, Converter={StaticResource NotnullToBooleanConverter}}"
					   FontSize="12" FontWeight="SemiBold" Opacity="0.85"
					   Margin="8,6,8,0"/>
			<TextBlock Text="{loc:Loc {Binding State.ContextDescription}}"
					   IsVisible="{Binding State.ContextDescription, Converter={StaticResource NotnullToBooleanConverter}}"
					   FontSize="11" Opacity="0.7"
					   TextWrapping="Wrap" MaxLines="3"
					   Margin="8,0,8,0"/>
			<ItemsControl ItemsSource="{Binding State.ContextItems}"
						  Margin="0,2,0,0">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="ic:InputCompletionContextItem">
						<Grid ColumnDefinitions="Auto,*,Auto"
							  Margin="8,1">
							<ico:VisualIcon Grid.Column="0"
											Kind="Tune"
											Width="12" Height="12" Opacity="0.6"
											VerticalAlignment="Center"
											Margin="0,0,6,0"/>
							<TextBlock Grid.Column="1"
									   Classes.current="{Binding IsCurrent}"
									   Text="{loc:Loc {Binding Name}}"
									   FontSize="12"
									   TextTrimming="CharacterEllipsis"/>
							<TextBlock Grid.Column="2"
									   Text="{loc:Loc command.completion.required}"
									   IsVisible="{Binding IsRequired}"
									   FontSize="11" Opacity="0.6"
									   VerticalAlignment="Center"
									   Margin="8,0,0,0"/>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- The picker: the continuations an accept applies. -->
			<ScrollViewer x:Name="PickerList"
						  MaxHeight="240"
						  VerticalScrollBarVisibility="Auto"
						  Margin="0,2,0,0">
				<ItemsControl ItemsSource="{Binding Rows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="llm:InputCompletionRow">
							<Border Classes.selected="{Binding IsSelected}"
									CornerRadius="4"
									Margin="2,0"
									Padding="4,2">
								<Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
									<ico:VisualIcon Grid.Column="0"
													Kind="{Binding Icon}"
													Width="13" Height="13"
													VerticalAlignment="Center"
													Margin="0,0,6,0"/>
									<TextBlock Grid.Column="1"
											   Text="•"
											   IsVisible="{Binding Item.IsDefeated}"
											   ToolTip.Tip="{loc:Loc command.completion.defeated}"
											   Margin="0,0,6,0"/>
									<TextBlock Grid.Column="2"
											   Text="{Binding Item.DisplayText}"
											   TextTrimming="CharacterEllipsis"/>
									<TextBlock Grid.Column="2" Grid.Row="1"
											   Text="{loc:Loc {Binding Item.Description}}"
											   IsVisible="{Binding Item.Description, Converter={StaticResource NotnullToBooleanConverter}}"
											   FontSize="11" Opacity="0.7"
											   TextWrapping="Wrap" MaxLines="3"
											   TextTrimming="CharacterEllipsis"/>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<TextBlock Text="{loc:Loc command.completion.no_matches}"
					   IsVisible="{Binding ShowNoMatches}"
					   Margin="8,6"/>

			<!-- The keys the popup owns. -->
			<Border Height="1"
					Background="{DynamicResource InputCompletionPopupBorderBrush}"
					Opacity="0.6"
					Margin="4,4,4,0"/>
			<TextBlock Text="{loc:Loc command.completion.hint}"
					   FontSize="11" Opacity="0.55"
					   Margin="8,4,8,2"/>

		</StackPanel>
	</Border>

</UserControl>
