<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Attachments"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
			 xmlns:flui="using:FluentAvalonia.UI"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Attachments.AttachmentsManagerView"
			 x:DataType="local:AttachmentsManagerViewModel">

	<Grid Margin="10"
			  MinWidth="400" MinHeight="250"
			  Background="Transparent"
				RowDefinitions="auto,auto,*">

		<!-- Header -->
		<DockPanel Grid.Row="0"
							 Margin="0,0,0,10">

			<ico:VisualIcon Kind="Paperclip" Width="24" Height="24"
											Foreground="{DynamicResource TextSecondary}"/>

			<TextBlock Text="{loc:Loc attachment.manager.title}"
								 Margin="8,0,0,0"
								 FontWeight="SemiBold"
								 FontSize="{DynamicResource FontSizeXl}"
								 VerticalAlignment="Center"/>
			
			<Button DockPanel.Dock="Right"
							Classes="icon"
							IsVisible="{Binding OpenedInDialog}"
							VerticalAlignment="Center"
							HorizontalAlignment="Right"
							Command="{Binding CloseDialogCommand}">
			
				<ico:VisualIcon Kind="Close"/>

			</Button>

		</DockPanel>

		<Grid Margin="0,0,0,10"
					Grid.Row="1"
					ColumnDefinitions="*,auto,auto">

			<TextBox x:Name="UrlInputBox"
							 Grid.Column="0"
							 Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}"
							 PlaceholderText="{loc:Loc attachment.url.hint}"
							 UseFloatingPlaceholder="True"
							 VerticalContentAlignment="Center"
							 KeyDown="OnUrlInputKeyDown"/>

			<Button Grid.Column="1"
							Margin="8,0,0,0"
							Command="{Binding AddUrlCommand}"
							Classes="icon large"
							ToolTip.Tip="{loc:Loc attachment.add_url.hint}">

				<ico:VisualIcon Kind="Link" />
			</Button>

			<Button Grid.Column="2"
							Margin="8,0,0,0"
							Command="{Binding AttachFilesCommand}"
							Classes="icon large"
							ToolTip.Tip="{loc:Loc attachment.attach_files.hint}">

				<ico:VisualIcon Kind="FolderOpen" />
			</Button>
		</Grid>

		<ItemsControl Grid.Row="2" 
								  ItemsSource="{Binding Drafts}">

			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>

					<Border Margin="0,0,0,8"
									Padding="12,10"
									Background="{DynamicResource CardBackground}"
									BorderBrush="{DynamicResource BorderSubtle}"
									BorderThickness="1"
									CornerRadius="{DynamicResource RadiusM}">

						<StackPanel>

							<TextBlock Text="{Binding Title}"
												 FontWeight="SemiBold"
												 TextTrimming="CharacterEllipsis"/>

							<CheckBox IsChecked="{Binding CopyToWorkingDirectory}"
												Content="{loc:Loc attachment.copy_to_working_directory}"
												Margin="0,5,0,0"/>

							<CheckBox IsChecked="{Binding ApplyNative}"
												Content="{loc:Loc attachment.apply_native}"
												Margin="0,3,0,0"/>

							<Button Content="{loc:Loc attachment.apply}"
											Command="{Binding ApplyCommand}"
											HorizontalAlignment="Right"
											Margin="0,10,0,0"/>

						</StackPanel>

					</Border>

				</DataTemplate>
			</ItemsControl.ItemTemplate>

		</ItemsControl>

		<Border x:Name="DropOverlay"
						Grid.Row="1"
						Grid.RowSpan="2"
						Background="{DynamicResource PrimarySubtle}"
						BorderBrush="{DynamicResource PrimaryBorder}"
						BorderThickness="2"
						CornerRadius="{DynamicResource RadiusM}"
						IsVisible="False"
						IsHitTestVisible="False">

			<TextBlock Text="{loc:Loc attachment.drop_files_here}"
								 HorizontalAlignment="Center"
								 VerticalAlignment="Center"
								 FontSize="{DynamicResource FontSizeL}"
								 Foreground="{DynamicResource PrimaryBase}"/>
		</Border>

	</Grid>

</UserControl>
