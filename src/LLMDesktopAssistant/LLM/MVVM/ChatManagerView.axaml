<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:scroll="using:LLMDesktopAssistant.Controls.Scrolling"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatManagerView"
			 x:DataType="local:ChatManagerViewModel"
			 x:Name="VMRoot">

	<UserControl.Styles>
		<!-- Chat tabs fill the whole ListBoxItem area (the base theme adds a large padding) -->
		<Style Selector="ListBox.ChatTabsListBox > ListBoxItem">
			<Setter Property="Padding" Value="0"/>
		</Style>
	</UserControl.Styles>

	<SplitView x:Name="ChatSplitView"
						 PanePlacement="Right"
						 CompactPaneLength="0"
						 OpenPaneLength="470">
	
		<SplitView.Pane>
			
			<DockPanel>

				<StackPanel Orientation="Horizontal"
										Margin="8"
										DockPanel.Dock="Top">

					<TextBlock Text="{loc:Loc chat.list.title}"
										 Foreground="{DynamicResource DefaultForeground}"
										 FontSize="18"
										 VerticalAlignment="Center"
										 Margin="8"/>

				</StackPanel>

				<!-- Sidebar: list of all available chats (no edit controls) -->
				<scroll:SmoothScrollViewer Margin="8"
																	 VerticalScrollBarVisibility="Auto">

					<scroll:SmoothScrollViewer.Styles>

						<!-- A chat entry is a surface, not a themed button: only the hover and press tints show. -->
						<Style Selector="Button.ChatListRow">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
							<Setter Property="Padding" Value="0"/>
							<Setter Property="HorizontalAlignment" Value="Stretch"/>
							<Setter Property="VerticalAlignment" Value="Stretch"/>
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						</Style>
						<Style Selector="Button.ChatListRow:pointerover">
							<Setter Property="Background" Value="#16FFFFFF"/>
						</Style>
						<Style Selector="Button.ChatListRow:pressed">
							<Setter Property="Background" Value="#26FFFFFF"/>
						</Style>

						<!--
							The chips of a chat entry are lighter than a message's, which sit in a pill of their own. The
							override lives inside this list on purpose: a scope on the view would reach the chat as well.
						-->
						<Style Selector="Border.messagePartChip" x:CompileBindings="False">
							<Setter Property="Background" Value="#00000000"/>
							<Setter Property="CornerRadius" Value="6"/>
							<Setter Property="Padding" Value="4,0"/>
							<Setter Property="BorderBrush" Value="{Binding ChipColor, Converter={StaticResource ColorToBrushConverter}, ConverterParameter=0.35}"/>
						</Style>
						<Style Selector="Border.messagePartChip TextBlock">
							<Setter Property="FontSize" Value="10"/>
							<Setter Property="Opacity" Value="0.85"/>
						</Style>
						<Style Selector="Border.messagePartChip ico|VisualIcon">
							<Setter Property="Width" Value="11"/>
							<Setter Property="Height" Value="11"/>
						</Style>

						<!-- One line of chips: a wrapped second line would change the height of the entry. -->
						<Style Selector="ContentControl.ChatListChips ItemsControl">
							<Setter Property="ItemsPanel">
								<Setter.Value>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</Setter.Value>
							</Setter>
						</Style>

					</scroll:SmoothScrollViewer.Styles>

					<ItemsControl ItemsSource="{Binding AvailableChats}">

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<VirtualizingStackPanel/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>

								<Panel IsVisible="{Binding !IsTemporary}"
											 Height="62"
											 Margin="0,0,0,2">

									<!-- The row itself. Disabled while the chat is already open in a tab, and the only thing that opens it. -->
									<Button Classes="ChatListRow"
													Command="{Binding OpenCommand}"
													IsEnabled="{Binding !IsSelected}">
										<Button.Template>
											<ControlTemplate>
												<Border Background="{TemplateBinding Background}"
																CornerRadius="6">
													<ContentPresenter Content="{TemplateBinding Content}"/>
												</Border>
											</ControlTemplate>
										</Button.Template>
									</Button>

									<!-- Chrome above the button: never hit-testable, so the click falls through to it. -->
									<Grid Margin="8,6"
												ColumnDefinitions="Auto,*"
												Opacity="{Binding ContentOpacity}"
												IsHitTestVisible="False">

										<Border Width="8" Height="8"
														CornerRadius="4"
														Background="{Binding TopicColorHex}"
														VerticalAlignment="Top"
														Margin="0,5,6,0"/>
								
										<StackPanel Grid.Column="1" Spacing="1">

											<TextBlock Text="{Binding Title}"
																 FontSize="14"
																 TextWrapping="NoWrap"
																 TextTrimming="CharacterEllipsis"/>

											<TextBlock Text="{Binding Topic}"
																 IsVisible="{Binding Topic, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
																 Foreground="{Binding TopicColorHex}"
																 FontSize="11"
																 Opacity="0.8"
																 TextWrapping="NoWrap"
																 TextTrimming="CharacterEllipsis"/>

											<TextBlock Text="{loc:Loc chat.no_topic}"
																 IsVisible="{Binding Topic, Converter={StaticResource StringNonEmptyToBooleanConverterInverted}}"
																 Foreground="{Binding TopicColorHex}"
																 FontSize="11"
																 Opacity="0.8"
																 TextWrapping="NoWrap"
																 TextTrimming="CharacterEllipsis"/>

										</StackPanel>

									</Grid>

									<!-- The chat's own parts: real chips, hit-testable, above the row button -->
									<ContentControl Classes="ChatListChips"
															Content="{Binding Parts}"
															Opacity="{Binding ContentOpacity}"
															HorizontalAlignment="Left"
															VerticalAlignment="Bottom"
															Margin="22,0,8,5"
															ClipToBounds="True"/>

									<Label Content="{Binding LastModifiedAt}"
												 HorizontalAlignment="Right"
												 VerticalAlignment="Bottom"
												 Margin="0,0,8,4"
												 Opacity="0.5"
												 FontSize="11"/>

									<StackPanel Orientation="Horizontal"
													HorizontalAlignment="Right"
													VerticalAlignment="Top"
													Margin="0,4,4,0"
													Spacing="4">

										<Button Command="{Binding OpenInNewTabCommand}"
														IsEnabled="{Binding CanAct}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.open_in_new_tab}">
											<ico:VisualIcon Kind="TabPlus"/>
										</Button>

										<Button Command="{Binding DeleteCommand}"
														IsEnabled="{Binding CanAct}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc common.delete}">
											<ico:VisualIcon Kind="Delete"/>
										</Button>

									</StackPanel>

								</Panel>

							</DataTemplate>
						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</scroll:SmoothScrollViewer>

			</DockPanel>

		</SplitView.Pane>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition/>
			</Grid.RowDefinitions>

			<!-- TOP BAR with tabs & buttons -->
			<DockPanel Background="{DynamicResource TopBarBackground}">

				<StackPanel DockPanel.Dock="Right"
										HorizontalAlignment="Right"
										Orientation="Horizontal"
										Margin="10" Spacing="5">
					
					<Button Command="{Binding CreateChatCommand}"
									Classes="IconButton"
									ToolTip.Tip="{loc:Loc chat.new}">
						<ico:VisualIcon Kind="MessagePlus"/>
					</Button>
					
					<Button Command="{Binding CreateTemporaryChatCommand}"
									Classes="IconButton"
									ToolTip.Tip="{loc:Loc chat.new_temporary}">
						<ico:VisualIcon Kind="MessageFlash"/>
					</Button>
					
					<ToggleButton IsChecked="{Binding #ChatSplitView.IsPaneOpen}"
											  Classes="IconButton">
						<ico:VisualIcon Kind="Forum"/>
					</ToggleButton>

				</StackPanel>

				<!-- Opened chats tabs with inline rename & AI rename -->
				<ListBox ItemsSource="{Binding OpenedChats}"
								 SelectedItem="{Binding SelectedChat}"
								 Classes="ChatTabsListBox"
								 DockPanel.Dock="Left">
					
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>

					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="local:OpenedChatViewModel">
							
							<Border CornerRadius="6"
											Padding="10"
											Background="{Binding StatusColorHex}">
								
								<Border.Transitions>
									<Transitions>
										<BrushTransition Property="Background" Duration="0:0:0.4"/>
									</Transitions>
								</Border.Transitions>
							
								<StackPanel Orientation="Horizontal"
														VerticalAlignment="Center"
														Spacing="4">
									
									<!-- Display mode -->
									<StackPanel Orientation="Horizontal" Spacing="4"
															IsVisible="{Binding !IsEditing}">
										
										<StackPanel Orientation="Vertical"
																VerticalAlignment="Center">
											
											<StackPanel Orientation="Horizontal"
																	Spacing="4">
												
												<ico:VisualIcon Kind="{Binding StatusIcon}"
																					Width="14" Height="14"
																					VerticalAlignment="Center"
																					IsVisible="{Binding HasStatus}"/>
												
												<TextBlock Text="{Binding SelectedAvailable.Title}"
																	 FontSize="14"
																	 PointerPressed="TabTitleTextBlock_PointerPressed"
																	 IsHitTestVisible="{Binding $parent[ListBoxItem].IsSelected}"
																	 Cursor="Hand"/>
												
											</StackPanel>
											
											<StackPanel Orientation="Horizontal" Spacing="4">
												
												<TextBlock Text="{Binding SelectedAvailable.Topic}"
																	 IsVisible="{Binding SelectedAvailable.Topic, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
																	 Foreground="{Binding SelectedAvailable.TopicColorHex}"
																	 FontSize="11"
																	 PointerPressed="TabTopicTextBlock_PointerPressed"
																	 IsHitTestVisible="{Binding $parent[ListBoxItem].IsSelected}"
																	 Cursor="Hand"/>
											
												<TextBlock Text="{loc:Loc chat.no_topic}"
																	 IsVisible="{Binding SelectedAvailable.Topic, Converter={StaticResource StringNonEmptyToBooleanConverterInverted}}"
																	 Foreground="{Binding SelectedAvailable.TopicColorHex}"
																	 FontSize="11"
																	 PointerPressed="TabTopicTextBlock_PointerPressed"
																	 IsHitTestVisible="{Binding $parent[ListBoxItem].IsSelected}"
																	 Cursor="Hand"/>
											
												<TextBlock Text="{loc:Loc chat.temporary}"
																	 IsVisible="{Binding SelectedAvailable.IsTemporary}"
																	 FontStyle="Italic"
																	 Foreground="#AA888888"
																	 FontSize="11"/>
											
											</StackPanel>

										</StackPanel>

										<Button Command="{Binding RenameWithAICommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename_with_ai}">
											<ico:VisualIcon Kind="AutoFix"/>
										</Button>
										
										<Button Command="{Binding CloseChatCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc common.close}">
											<ico:VisualIcon Kind="Close"/>
										</Button>

									</StackPanel>
									
									<!-- Title edit mode -->
									<StackPanel Orientation="Horizontal" Spacing="4"
															IsVisible="{Binding IsEditingTitle}">
										
										<TextBox Text="{Binding EditTitleText, Mode=TwoWay}"
														 FontSize="14"
														 MinWidth="80"
														 MaxWidth="200"
														 AcceptsReturn="False"
														 KeyDown="TabTitleTextBox_KeyDown"/>
										
										<Button Command="{Binding CommitEditTitleCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.save}">
											<ico:VisualIcon Kind="Check"/>
										</Button>
										
										<Button Command="{Binding CancelEditTitleCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.cancel}">
											<ico:VisualIcon Kind="Close"/>
										</Button>
									</StackPanel>
									
									<!-- Topic editing mode -->
									<StackPanel Orientation="Horizontal" Spacing="4"
															IsVisible="{Binding IsEditingTopic}">
										
										<TextBox Text="{Binding EditTopicText, Mode=TwoWay}"
														 FontSize="14"
														 MinWidth="80"
														 MaxWidth="200"
														 AcceptsReturn="False"
														 KeyDown="TabTopicTextBox_KeyDown"/>
										
										<Button Command="{Binding CommitEditTopicCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.save}">
											<ico:VisualIcon Kind="Check"/>
										</Button>
										
										<Button Command="{Binding CancelEditTopicCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.cancel}">
											<ico:VisualIcon Kind="Close"/>
										</Button>
									</StackPanel>

								</StackPanel>
								
							</Border>
							
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>
				
			</DockPanel>

			<!-- CHAT -->
			<ItemsControl Grid.Row="1"
										ItemsSource="{Binding OpenedChats}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<Panel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ContentControl Content="{Binding CurrentChat}"
														IsVisible="{Binding IsSelected}"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>

	</SplitView>

</UserControl>
