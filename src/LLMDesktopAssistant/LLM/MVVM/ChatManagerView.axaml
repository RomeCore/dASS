<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:beh="using:LLMDesktopAssistant.Controls.Behaviours"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatManagerView"
			 x:DataType="local:ChatManagerViewModel"
			 x:Name="VMRoot">

	<UserControl.Styles>
		<!-- Chat tabs fill the whole ListBoxItem area (the base theme adds a large padding) -->
		<Style Selector="ListBox.ChatTabsListBox > ListBoxItem">
			<Setter Property="Padding" Value="0"/>
		</Style>
	</UserControl.Styles>

	<SplitView x:Name="ChatSplitView"
						 PanePlacement="Right"
						 CompactPaneLength="0"
						 OpenPaneLength="470">
	
		<SplitView.Pane>
			
			<DockPanel>

				<StackPanel Orientation="Horizontal"
										Margin="8"
										DockPanel.Dock="Top">

					<TextBlock Text="{loc:Loc chat.list.title}"
										 Foreground="{DynamicResource DefaultForeground}"
										 FontSize="18"
										 VerticalAlignment="Center"
										 Margin="8"/>

				</StackPanel>

				<!-- Sidebar: list of all available chats (no edit controls) -->
				<ListBox ItemsSource="{Binding AvailableChats}"
								 SelectedItem="{Binding SelectedChat.SelectedAvailable}"
								 Margin="8">

					<ListBox.ItemTemplate>
						<DataTemplate>
							
							<DockPanel beh:ListBoxItemBehaviour.IsParentListBoxItemEnabled="{Binding !IsSelected}"
												 beh:ListBoxItemBehaviour.IsParentListBoxItemVisible="{Binding !IsTemporary}">

								<StackPanel VerticalAlignment="Center"
														DockPanel.Dock="Right">
									
									<Label Content="{Binding LastModifiedAt}"
												 Opacity="0.5"
												 FontSize="11"/>

									<StackPanel Orientation="Horizontal"
															HorizontalAlignment="Right"
															Spacing="4">
										
										<Button Command="{Binding OpenInNewTabCommand}"
														IsEnabled="{Binding !IsTemporary}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.open_in_new_tab}">
											<ico:VisualIcon Kind="TabPlus"/>
										</Button>
										
										<Button Command="{Binding DeleteCommand}"
														IsEnabled="{Binding !IsTemporary}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc common.delete}">
											<ico:VisualIcon Kind="Delete"/>
										</Button>
										
									</StackPanel>

								</StackPanel>

								<Border Width="8" Height="8"
												CornerRadius="4"
												Background="{Binding TopicColorHex}"
												VerticalAlignment="Center"
												Margin="0,0,6,0"
												DockPanel.Dock="Left"
												ToolTip.Tip="{Binding Topic}"/>
								
								<StackPanel VerticalAlignment="Center">
									
									<TextBlock Text="{Binding Title}"
														 FontSize="14"
														 TextWrapping="NoWrap"
														 TextTrimming="CharacterEllipsis"/>
									
									<TextBlock Text="{Binding Topic}"
															IsVisible="{Binding Topic, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
															Foreground="{Binding TopicColorHex}"
															FontSize="11"
															Opacity="0.8"
															VerticalAlignment="Center"
															TextWrapping="NoWrap"
															TextTrimming="CharacterEllipsis"/>
								
									<TextBlock Text="{loc:Loc chat.no_topic}"
															IsVisible="{Binding Topic, Converter={StaticResource StringNonEmptyToBooleanConverterInverted}}"
															Foreground="{Binding TopicColorHex}"
															FontSize="11"
															Opacity="0.8"
															VerticalAlignment="Center"
															TextWrapping="NoWrap"
															TextTrimming="CharacterEllipsis"/>
								
								</StackPanel>
								
							</DockPanel>
							
						</DataTemplate>
					</ListBox.ItemTemplate>
					
				</ListBox>
				
			</DockPanel>

		</SplitView.Pane>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition/>
			</Grid.RowDefinitions>

			<!-- TOP BAR with tabs & buttons -->
			<DockPanel Background="{DynamicResource TopBarBackground}">

				<StackPanel DockPanel.Dock="Right"
										HorizontalAlignment="Right"
										Orientation="Horizontal"
										Margin="10" Spacing="5">
					
					<Button Command="{Binding CreateChatCommand}"
									Classes="IconButton"
									ToolTip.Tip="{loc:Loc chat.new}">
						<ico:VisualIcon Kind="MessagePlus"/>
					</Button>
					
					<Button Command="{Binding CreateTemporaryChatCommand}"
									Classes="IconButton"
									ToolTip.Tip="{loc:Loc chat.new_temporary}">
						<ico:VisualIcon Kind="MessageFlash"/>
					</Button>
					
					<ToggleButton IsChecked="{Binding #ChatSplitView.IsPaneOpen}"
											  Classes="IconButton">
						<ico:VisualIcon Kind="Forum"/>
					</ToggleButton>

				</StackPanel>

				<!-- Opened chats tabs with inline rename & AI rename -->
				<ListBox ItemsSource="{Binding OpenedChats}"
								 SelectedItem="{Binding SelectedChat}"
								 Classes="ChatTabsListBox"
								 DockPanel.Dock="Left">
					
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>

					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="local:OpenedChatViewModel">
							
							<Border CornerRadius="6"
											Padding="10"
											Background="{Binding StatusColorHex}">
								
								<Border.Transitions>
									<Transitions>
										<BrushTransition Property="Background" Duration="0:0:0.4"/>
									</Transitions>
								</Border.Transitions>
							
								<StackPanel Orientation="Horizontal"
														VerticalAlignment="Center"
														Spacing="4">
									
									<!-- Display mode -->
									<StackPanel Orientation="Horizontal" Spacing="4"
															IsVisible="{Binding !IsEditing}">
										
										<StackPanel Orientation="Vertical"
																VerticalAlignment="Center">
											
											<StackPanel Orientation="Horizontal"
																	Spacing="4">
												
												<ico:VisualIcon Kind="{Binding StatusIcon}"
																					Width="14" Height="14"
																					VerticalAlignment="Center"
																					IsVisible="{Binding HasStatus}"/>
												
												<TextBlock Text="{Binding SelectedAvailable.Title}"
																	 FontSize="14"
																	 PointerPressed="TabTitleTextBlock_PointerPressed"
																	 IsHitTestVisible="{Binding $parent[ListBoxItem].IsSelected}"
																	 Cursor="Hand"/>
												
											</StackPanel>
											
											<StackPanel Orientation="Horizontal" Spacing="4">
												
												<TextBlock Text="{Binding SelectedAvailable.Topic}"
																	 IsVisible="{Binding SelectedAvailable.Topic, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
																	 Foreground="{Binding SelectedAvailable.TopicColorHex}"
																	 FontSize="11"
																	 PointerPressed="TabTopicTextBlock_PointerPressed"
																	 IsHitTestVisible="{Binding $parent[ListBoxItem].IsSelected}"
																	 Cursor="Hand"/>
											
												<TextBlock Text="{loc:Loc chat.no_topic}"
																	 IsVisible="{Binding SelectedAvailable.Topic, Converter={StaticResource StringNonEmptyToBooleanConverterInverted}}"
																	 Foreground="{Binding SelectedAvailable.TopicColorHex}"
																	 FontSize="11"
																	 PointerPressed="TabTopicTextBlock_PointerPressed"
																	 IsHitTestVisible="{Binding $parent[ListBoxItem].IsSelected}"
																	 Cursor="Hand"/>
											
												<TextBlock Text="{loc:Loc chat.temporary}"
																	 IsVisible="{Binding SelectedAvailable.IsTemporary}"
																	 FontStyle="Italic"
																	 Foreground="#AA888888"
																	 FontSize="11"/>
											
											</StackPanel>

										</StackPanel>

										<Button Command="{Binding RenameWithAICommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename_with_ai}">
											<ico:VisualIcon Kind="AutoFix"/>
										</Button>
										
										<Button Command="{Binding CloseChatCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc common.close}">
											<ico:VisualIcon Kind="Close"/>
										</Button>

									</StackPanel>
									
									<!-- Title edit mode -->
									<StackPanel Orientation="Horizontal" Spacing="4"
															IsVisible="{Binding IsEditingTitle}">
										
										<TextBox Text="{Binding EditTitleText, Mode=TwoWay}"
														 FontSize="14"
														 MinWidth="80"
														 MaxWidth="200"
														 AcceptsReturn="False"
														 KeyDown="TabTitleTextBox_KeyDown"/>
										
										<Button Command="{Binding CommitEditTitleCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.save}">
											<ico:VisualIcon Kind="Check"/>
										</Button>
										
										<Button Command="{Binding CancelEditTitleCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.cancel}">
											<ico:VisualIcon Kind="Close"/>
										</Button>
									</StackPanel>
									
									<!-- Topic editing mode -->
									<StackPanel Orientation="Horizontal" Spacing="4"
															IsVisible="{Binding IsEditingTopic}">
										
										<TextBox Text="{Binding EditTopicText, Mode=TwoWay}"
														 FontSize="14"
														 MinWidth="80"
														 MaxWidth="200"
														 AcceptsReturn="False"
														 KeyDown="TabTopicTextBox_KeyDown"/>
										
										<Button Command="{Binding CommitEditTopicCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.save}">
											<ico:VisualIcon Kind="Check"/>
										</Button>
										
										<Button Command="{Binding CancelEditTopicCommand}"
														Classes="SmallIconButton"
														ToolTip.Tip="{loc:Loc chat.rename.cancel}">
											<ico:VisualIcon Kind="Close"/>
										</Button>
									</StackPanel>

								</StackPanel>
								
							</Border>
							
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>
				
			</DockPanel>

			<!-- CHAT -->
			<ItemsControl Grid.Row="1"
										ItemsSource="{Binding OpenedChats}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<Panel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ContentControl Content="{Binding CurrentChat}"
														IsVisible="{Binding IsSelected}"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>

	</SplitView>

</UserControl>
