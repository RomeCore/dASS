<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:add="using:LLMDesktopAssistant.LLM.MVVM.Additional"
						 xmlns:scroll="using:LLMDesktopAssistant.Controls.Scrolling"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatManagerView"
						 x:DataType="local:ChatManagerViewModel">

	<UserControl.Styles>

		<!-- An open chat is a list row too, so the selection pill is the one the theme already draws. -->
		<Style Selector="ListBox.chats ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0,0,0,2" />
			<Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>

		<Style Selector="TextBlock.listCaption">
			<Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
			<Setter Property="Margin" Value="4,8,0,4" />
		</Style>

		<!-- A switch reveals the conversation that just became active; nothing is rebuilt. -->
		<Style Selector="ContentControl.chatPage.active">
			<Style.Animations>
				<Animation Duration="0:0:0.48"
									 Easing="CubicEaseOut"
									 FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- One line of chips: a wrapped second line would change the height of the entry. -->
		<Style Selector="ContentControl.chatListChips ItemsControl">
			<Setter Property="ItemsPanel">
				<Setter.Value>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="SplitView.chatListSplit">
			<Style Selector="^ /template/ Rectangle#LightDismissLayer">
				<Setter Property="Transitions">
					<Transitions>
						<DoubleTransition Property="Opacity"
															Easing="{StaticResource EasingStandard}"
															Duration="{StaticResource DurationFast}"/>
					</Transitions>
				</Setter>
			</Style>
			<Style Selector="^ /template/ Rectangle#LightDismissLayer">
				<Setter Property="Fill" Value="{DynamicResource Scrim}"/>
				<Setter Property="Opacity" Value="0"/>
			</Style>
			<Style Selector="^:open /template/ Rectangle#LightDismissLayer">
				<Setter Property="Opacity" Value="1"/>
			</Style>
		</Style>

	</UserControl.Styles>

	<!--
		The list is an overlay sidebar: it slides over the conversation instead of taking a column from
		it, and a click outside closes it.
	-->
	<SplitView x:Name="ChatSplitView"
						 Classes="chatListSplit"
						 DisplayMode="Overlay"
						 PanePlacement="Left"
						 OpenPaneLength="480"
						 IsPaneOpen="{Binding IsChatListVisible, Mode=TwoWay}">

		<SplitView.Pane>

			<Border Background="{DynamicResource PanelBackground}"
							BorderBrush="{DynamicResource BorderSubtle}"
							BorderThickness="0,0,1,0">

				<DockPanel LastChildFill="True">

					<Grid DockPanel.Dock="Top"
								Margin="12,10,8,4"
								ColumnDefinitions="*,Auto">

						<TextBlock Text="{loc:Loc chat.list.title}"
											 FontSize="{DynamicResource FontSizeM}"
											 FontWeight="SemiBold"
											 Foreground="{DynamicResource TextPrimary}"
											 VerticalAlignment="Center" />

						<StackPanel Grid.Column="1"
												Orientation="Horizontal"
												Spacing="4">

							<Button Classes="icon"
											Command="{Binding CreateTemporaryChatCommand}"
											ToolTip.Tip="{loc:Loc chat.new_temporary}">
								<ico:VisualIcon Kind="MessageFlash" />
							</Button>

							<Button Classes="icon"
											Command="{Binding CreateChatCommand}"
											ToolTip.Tip="{loc:Loc chat.new}">
								<ico:VisualIcon Kind="MessagePlus" />
							</Button>

							<Button Classes="icon"
											Command="{Binding ToggleChatListCommand}"
											ToolTip.Tip="{loc:Loc chat.list.collapse}">
								<ico:VisualIcon Kind="ChevronLeft" />
							</Button>

						</StackPanel>

					</Grid>

					<Grid DockPanel.Dock="Top"
								Margin="8,0,8,6"
								ColumnSpacing="4"
								ColumnDefinitions="*,Auto">
						
						<TextBox Text="{Binding SearchText, Mode=TwoWay}"
										 PlaceholderText="{loc:Loc chat.list.search}"
										 FontSize="{DynamicResource FontSizeS}">
							<TextBox.InnerLeftContent>
								<ico:VisualIcon Kind="Search" Width="16" Height="16" Margin="6,0,2,0" />
							</TextBox.InnerLeftContent>
						</TextBox>

						<ToggleButton Grid.Column="1"
													Classes="icon"
													IsChecked="{Binding FilterFavoritesOnly}"
													ToolTip.Tip="{loc:Loc chat.list.filter_favorites}">
							<ico:VisualIcon Kind="Star" Width="16" Height="16" />
						</ToggleButton>

					</Grid>

					<ListBox Classes="chats"
									 ItemsSource="{Binding ChatListEntries}"
									 SelectedItem="{Binding SelectedChat}"
									 ScrollViewer.BringIntoViewOnFocusChange="False"
									 Padding="6,0">
						
						<ListBox.ItemContainerTheme>
							<ControlTheme TargetType="ListBoxItem"
														BasedOn="{StaticResource {x:Type ListBoxItem}}"
														x:DataType="local:ChatListBaseEntry">
								<Setter Property="IsEnabled" Value="{Binding CanBeSelected}" />
							</ControlTheme>
						</ListBox.ItemContainerTheme>

						<ListBox.Styles>
							
							<!--
								The chips of a chat entry are lighter than a message's, which sit in a pill of their own. The
								override lives inside this list on purpose: a scope on the view would reach the chat as well.
							-->
							<Style Selector="Border.messagePartChip" x:DataType="add:AdditionalMessagePart">
								<Setter Property="Background" Value="#00000000" />
								<Setter Property="CornerRadius" Value="6" />
								<Setter Property="Padding" Value="4,0" />
								<Setter Property="BorderBrush" Value="{Binding ChipColor, Converter={StaticResource ColorToBrushConverter}, ConverterParameter=0.35}" />
							</Style>

							<Style Selector="Border.messagePartChip TextBlock">
								<Setter Property="FontSize" Value="10" />
								<Setter Property="Opacity" Value="0.85" />
							</Style>

							<Style Selector="Border.messagePartChip ico|VisualIcon">
								<Setter Property="Width" Value="11" />
								<Setter Property="Height" Value="11" />
							</Style>

						</ListBox.Styles>

						<ListBox.DataTemplates>

							<DataTemplate x:DataType="local:ChatListCaptionEntry">
								<TextBlock Classes="listCaption"
													 Text="{loc:Loc {Binding Caption}}"/>
							</DataTemplate>

							<DataTemplate x:DataType="local:ChatListBaseEntry">
								
								<Grid Margin="8,6,14,6"
											ColumnDefinitions="Auto,*,Auto"
											RowDefinitions="Auto,Auto,Auto">

									<Panel Grid.Column="0"
												 Grid.RowSpan="3"
												 Width="10" Height="10"
												 Margin="0,4,6,0"
												 VerticalAlignment="Top">

										<ico:VisualIcon Kind="{Binding Opened.StatusIcon}"
																		IsVisible="{Binding Opened.HasStatus}"/>
										
										<Grid ColumnDefinitions="*,*"
													IsVisible="{Binding !Opened.HasStatus}">

											<Border Grid.Column="0"
															CornerRadius="5,0,0,5"
															Background="{Binding Available.TopicColorHex}" />

											<Border Grid.Column="1"
															CornerRadius="0,5,5,0"
															Background="{Binding Available.SubTopicColorHex}" />

										</Grid>

									</Panel>

									<TextBlock Grid.Column="1"
														 Grid.Row="0"
														 Text="{Binding Available.Title}"
														 FontSize="{DynamicResource FontSizeM}"
														 Foreground="{DynamicResource TextPrimary}"
														 TextWrapping="NoWrap"
														 TextTrimming="CharacterEllipsis"
														 ToolTip.Tip="{Binding Available.Title}"/>

									<Grid Grid.Column="1"
												Grid.ColumnSpan="2"
												Grid.Row="1"
												ColumnDefinitions="*,Auto">
										
										<Grid ColumnDefinitions="Auto,Auto,*"
													IsVisible="{Binding Available.Topic, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
													Background="Transparent"
													ToolTip.Tip="{Binding Available.CombinedTopic}">

											<TextBlock Text="{Binding Available.Topic}"
																 FontSize="{DynamicResource FontSizeXs}"
																 Foreground="{Binding Available.TopicColorHex}" />

											<TextBlock Grid.Column="1"
																 Text="·"
																 Margin="4,0"
																 FontSize="{DynamicResource FontSizeXs}"
																 Foreground="{DynamicResource TextTertiary}"
																 IsVisible="{Binding Available.SubTopic, Converter={StaticResource StringNonEmptyToBooleanConverter}}" />

											<TextBlock Grid.Column="2"
																 Text="{Binding Available.SubTopic}"
																 FontSize="{DynamicResource FontSizeXs}"
																 Foreground="{Binding Available.SubTopicColorHex}"
																 TextWrapping="NoWrap"
																 TextTrimming="CharacterEllipsis" />

										</Grid>

										<TextBlock Text="{loc:Loc chat.no_topic}"
															 IsVisible="{Binding Available.Topic, Converter={StaticResource StringNonEmptyToBooleanConverterInverted}}"
															 FontSize="{DynamicResource FontSizeXs}"
															 Foreground="{DynamicResource TextTertiary}"
															 TextWrapping="NoWrap"
															 TextTrimming="CharacterEllipsis" />
										
										<StackPanel Grid.Column="1"
																Spacing="4"
																Orientation="Horizontal">
											
											<ico:VisualIcon Kind="Flash"
																			IsVisible="{Binding Available.IsTemporary}"
																			Width="10" Height="10"
																			ToolTip.Tip="{loc:Loc chat.list.temporary}"
																			Background="Transparent" />
										
											<ico:VisualIcon Kind="Close"
																			IsVisible="{Binding Available.WillBeDeleted}"
																			Width="10" Height="10"
																			ToolTip.Tip="{loc:Loc chat.list.will_be_deleted}"
																			Background="Transparent" />
										
											<ico:VisualIcon Kind="MessageProcessing"
																			IsVisible="{Binding Available.HasUserInputDraft}"
																			Width="10" Height="10"
																			ToolTip.Tip="{loc:Loc chat.list.has_user_input_draft}"
																			Background="Transparent" />
										
											<TextBlock ToolTip.Tip="{loc:Loc chat.list.message_count}"
																 FontSize="{DynamicResource FontSizeXs}"
																 Foreground="{DynamicResource TextTertiary}"
																 Text="{Binding Available.AllMessageCountFormatted}"
																 Background="Transparent" />

											<TextBlock Text="{Binding Available.LastModifiedLabel}"
																 ToolTip.Tip="{Binding Available.LastModifiedDetailedLabel}"
																 FontSize="{DynamicResource FontSizeXs}"
																 Foreground="{DynamicResource TextTertiary}"
																 Background="Transparent" />

										</StackPanel>

									</Grid>

									<ContentControl Grid.Column="1"
																	Grid.Row="2"
																	Classes="chatListChips"
																	Content="{Binding Available.Parts}"
																	Margin="0,2,0,0"
																	HorizontalAlignment="Left"
																	ClipToBounds="True" />

									<StackPanel Grid.Column="2"
															Orientation="Horizontal"
															Spacing="2"
															HorizontalAlignment="Right"
															VerticalAlignment="Top">
										
										<ItemsControl ItemsSource="{Binding Commands}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal"
																			Spacing="2"/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Button Classes="icon mini"
																	Command="{Binding Command}"
																	ToolTip.Tip="{loc:Loc {Binding ToolTip}}">
														<ico:VisualIcon Kind="{Binding Icon}" />
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<ToggleButton Classes="icon mini"
																	IsChecked="{Binding Available.Favorite}"
																	ToolTip.Tip="{loc:Loc chat.list.favorite}">
											<ico:VisualIcon Kind="Star" />
										</ToggleButton>

										<ToggleButton Classes="icon mini"
																	IsChecked="{Binding Available.Pinned}"
																	IsEnabled="{Binding Available.CanChangePinnedState}"
																	ToolTip.Tip="{loc:Loc chat.list.pin}">
											<ico:VisualIcon Kind="Pin" />
										</ToggleButton>

									</StackPanel>

								</Grid>

							</DataTemplate>
							
						</ListBox.DataTemplates>
					</ListBox>

				</DockPanel>

			</Border>

		</SplitView.Pane>

		<!-- ===================== the conversation ===================== -->
		<Panel>

			<ItemsControl ItemsSource="{Binding OpenedChats}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<Panel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="local:OpenedChatViewModel">
						<ContentControl Content="{Binding CurrentChat}"
														IsVisible="{Binding IsSelected}"
														Classes="chatPage"
														Classes.active="{Binding IsSelected}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</Panel>

	</SplitView>

</UserControl>
