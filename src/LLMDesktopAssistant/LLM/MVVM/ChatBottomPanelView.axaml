<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatBottomPanelView"
						 x:DataType="local:ChatBottomPanelViewModel">

	<Grid RowDefinitions="Auto,Auto,Auto,Auto"
				Background="Transparent">

		<!-- Rail (above the input): chat additional data that asked for the top strip. -->
		<ContentControl Grid.Row="0"
										Content="{Binding TopRail}"
										IsVisible="{Binding TopRail.HasItems}"
										Margin="0,0,0,6"/>

		<!-- User input -->
		<ContentControl Grid.Row="1" Content="{Binding UserInput}"/>

		<!-- Rail (below the input): chat additional data that asked for the bottom strip. -->
		<ContentControl Grid.Row="2"
										Content="{Binding BottomRail}"
										IsVisible="{Binding BottomRail.HasItems}"
										Margin="0,6,0,0"/>

		<!-- Toolbars -->
		<Grid Grid.Row="3"
					Margin="0,6,0,0"
					ColumnDefinitions="Auto,*,Auto">

			<ContentControl Grid.Column="0" Content="{Binding LeftToolBar}"/>
			<ContentControl Grid.Column="2" Content="{Binding RightToolBar}"/>

		</Grid>

	</Grid>

</UserControl>
