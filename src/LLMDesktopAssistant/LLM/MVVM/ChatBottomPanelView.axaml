<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatBottomPanelView"
						 x:DataType="local:ChatBottomPanelViewModel">

	<!--
		One card for the whole composer: the rails, the chips of the input state, the field and the toolbar share
		this surface, so the input needs no frame of its own and the toolbars stop floating on the window.
	-->
	<Border Classes="composerCard">

		<Grid RowDefinitions="Auto,Auto,Auto,Auto">

			<!-- Rail (above the input): chat additional data that asked for the top strip. -->
			<ContentControl Grid.Row="0"
											Content="{Binding TopRail}"
											IsVisible="{Binding TopRail.HasItems}"
											Margin="0,0,0,4"/>

			<!-- User input -->
			<ContentControl Grid.Row="1" Content="{Binding UserInput}"/>

			<!-- Rail (below the input): chat additional data that asked for the bottom strip. -->
			<ContentControl Grid.Row="2"
											Content="{Binding BottomRail}"
											IsVisible="{Binding BottomRail.HasItems}"
											Margin="0,4,0,0"/>

			<!-- Toolbars -->
			<Grid Grid.Row="3"
						Margin="0,4,0,0"
						ColumnDefinitions="Auto,*,Auto">

				<ContentControl Grid.Column="0" Content="{Binding LeftToolBar}"/>
				<ContentControl Grid.Column="2" Content="{Binding RightToolBar}"/>

			</Grid>

		</Grid>

	</Border>

</UserControl>
