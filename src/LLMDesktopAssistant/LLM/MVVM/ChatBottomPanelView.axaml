<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatBottomPanelView"
			 x:DataType="local:ChatBottomPanelViewModel">

	<Grid RowDefinitions="Auto,Auto"
		  Background="Transparent">

		<!-- User input -->
		<ContentControl Grid.Row="0" Content="{Binding UserInput}"/>

		<!-- Toolbars -->
		<Grid Grid.Row="1"
			  Margin="0,6,0,0"
			  ColumnDefinitions="Auto,*,Auto">

			<ContentControl Grid.Column="0" Content="{Binding LeftToolBar}"/>
			<ContentControl Grid.Column="2" Content="{Binding RightToolBar}"/>

		</Grid>

	</Grid>

</UserControl>
