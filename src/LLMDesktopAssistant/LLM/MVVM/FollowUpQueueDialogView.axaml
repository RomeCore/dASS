<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:loc="clr-namespace:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 xmlns:mvvm="using:LLMDesktopAssistant.LLM.MVVM"
			 mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="360"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.FollowUpQueueDialogView"
			 x:DataType="mvvm:FollowUpQueueDialogViewModel">

	<Border Background="{DynamicResource CardBackground}"
			BorderBrush="{DynamicResource CardBorderBrush}"
			BorderThickness="1"
			CornerRadius="8"
			Padding="16"
			Margin="4"
			MinWidth="360"
			MaxWidth="640">

		<StackPanel Orientation="Vertical" Spacing="12">

			<TextBlock Text="{Binding Title}"
					   FontSize="16"
					   FontWeight="Bold"
					   TextWrapping="Wrap"/>

			<TextBlock Text="{Binding EmptyText}"
					   FontSize="13"
					   Opacity="0.7"
					   IsVisible="{Binding !HasEntries}"/>

			<ScrollViewer MaxHeight="360" IsVisible="{Binding HasEntries}">
				<ItemsControl ItemsSource="{Binding Entries}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="mvvm:FollowUpQueueItemViewModel">

							<Border BorderBrush="{DynamicResource CardBorderBrush}"
									BorderThickness="0,0,0,1"
									Padding="0,8">

								<Grid ColumnDefinitions="*,Auto">

									<StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
										<TextBlock Text="{Binding Preview}"
												   FontSize="13"
												   TextWrapping="Wrap"/>

										<StackPanel Orientation="Horizontal" Spacing="8">
											<TextBlock Text="{Binding Sender}" FontSize="11" Opacity="0.6"/>
											<TextBlock Text="{Binding Level}" FontSize="11" Opacity="0.6"/>
											<TextBlock Text="{Binding CreatedAt}" FontSize="11" Opacity="0.4"/>
										</StackPanel>
									</StackPanel>

									<Button Grid.Column="1"
											Command="{Binding RemoveCommand}"
											Background="Transparent"
											BorderThickness="0"
											Padding="6"
											VerticalAlignment="Center"
											ToolTip.Tip="{loc:Loc chat.follow_up.item.remove}">
										<ico:VisualIcon Kind="Close" Width="12" Height="12"/>
									</Button>

								</Grid>
							</Border>

						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<Button Content="{loc:Loc chat.follow_up.close}"
					Command="{Binding CloseCommand}"
					Classes="secondary"
					HorizontalAlignment="Right"
					MinWidth="80"/>

		</StackPanel>

	</Border>

</UserControl>
