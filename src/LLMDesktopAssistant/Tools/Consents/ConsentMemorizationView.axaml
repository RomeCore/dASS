<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
			 xmlns:consents="using:LLMDesktopAssistant.Tools.Consents"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.Tools.Consents.ConsentMemorizationView"
			 x:DataType="consents:ConsentMemorizationViewModel">

	<Grid Margin="12"
		  MinWidth="480" MinHeight="280"
		  Background="Transparent"
		  RowDefinitions="Auto,*,Auto">

		<!-- Header -->
		<DockPanel Grid.Row="0" Margin="0,0,0,10">

			<ico:VisualIcon Kind="BookmarkMultipleOutline" FontSize="28" VerticalAlignment="Center"/>

			<TextBlock Text="{loc:Loc tool.call.remember.manager.title}"
					   Margin="8,0,0,0"
					   FontWeight="Bold"
					   FontSize="20"
					   VerticalAlignment="Center"/>

			<Button DockPanel.Dock="Right"
					Classes="IconButton"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Command="{Binding CloseCommand}">

				<ico:VisualIcon Kind="Close"/>

			</Button>

		</DockPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

			<StackPanel Spacing="12">

				<!-- Empty state -->
				<TextBlock Text="{loc:Loc tool.call.remember.manager.empty}"
						   Opacity="0.6"
						   IsVisible="{Binding IsEmpty}"
						   Margin="4,20"
						   HorizontalAlignment="Center"/>

				<!-- Session memorized -->
				<StackPanel Spacing="6" IsVisible="{Binding HasSessionItems}">

					<Grid ColumnDefinitions="*,Auto">

						<TextBlock Grid.Column="0"
								   Text="{loc:Loc tool.call.remember.manager.session}"
								   FontWeight="Bold"
								   FontSize="15"
								   VerticalAlignment="Center"/>

						<Button Grid.Column="1"
								Classes="SmallIconButton"
								Command="{Binding ClearSessionCommand}"
								ToolTip.Tip="{loc:Loc tool.call.remember.manager.forget_all}">
							<ico:VisualIcon Kind="DeleteSweepOutline"/>
						</Button>

					</Grid>

					<ItemsControl ItemsSource="{Binding SessionItems}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="4"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="consents:MemorizedConsentItemViewModel">
								<Border Background="#14000000" CornerRadius="6" Padding="10,6">
									<Grid ColumnDefinitions="Auto,*,Auto">

										<ico:VisualIcon Grid.Column="0"
														  Kind="{Binding DecisionIcon}"
														  Width="16" Height="16"
														  VerticalAlignment="Center"
														  Foreground="{Binding DecisionBrush}"/>

										<StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
											<TextBlock Text="{Binding ToolName}"
													   FontWeight="Medium"
													   TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding DecisionText}"
													   Opacity="0.7"
													   FontSize="12"/>
											<TextBlock Text="{Binding Notes}"
													   IsVisible="{Binding HasNotes}"
													   Opacity="0.5"
													   FontSize="12"
													   TextWrapping="Wrap"/>
										</StackPanel>

										<Button Grid.Column="2"
												Classes="SmallIconButton"
												Command="{Binding ForgetCommand}"
												ToolTip.Tip="{loc:Loc tool.call.remember.manager.forget}"
												VerticalAlignment="Center">
											<ico:VisualIcon Kind="BookmarkRemoveOutline"/>
										</Button>

									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</StackPanel>

				<!-- Always memorized -->
				<StackPanel Spacing="6" IsVisible="{Binding HasAlwaysItems}">

					<TextBlock Text="{loc:Loc tool.call.remember.manager.always}"
							   FontWeight="Bold"
							   FontSize="15"/>

					<ItemsControl ItemsSource="{Binding AlwaysItems}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="4"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="consents:MemorizedAlwaysItemViewModel">
								<Border Background="#14000000" CornerRadius="6" Padding="10,6">
									<Grid ColumnDefinitions="Auto,*,Auto">

										<ico:VisualIcon Grid.Column="0"
														  Kind="{Binding DecisionIcon}"
														  Width="16" Height="16"
														  VerticalAlignment="Center"
														  Foreground="{Binding DecisionBrush}"/>

										<StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
											<TextBlock Text="{Binding ToolName}"
													   FontWeight="Medium"
													   TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding DecisionText}"
													   Opacity="0.7"
													   FontSize="12"/>
											<TextBlock Text="{Binding AgentName}"
													   Opacity="0.5"
													   FontSize="12"
													   TextTrimming="CharacterEllipsis"/>
										</StackPanel>

										<Button Grid.Column="2"
												Classes="SmallIconButton"
												Command="{Binding ForgetCommand}"
												ToolTip.Tip="{loc:Loc tool.call.remember.manager.forget}"
												VerticalAlignment="Center">
											<ico:VisualIcon Kind="BookmarkRemoveOutline"/>
										</Button>

									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</StackPanel>

			</StackPanel>

		</ScrollViewer>

	</Grid>

</UserControl>
