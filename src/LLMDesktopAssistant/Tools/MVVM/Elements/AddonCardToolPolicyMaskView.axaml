<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="30"
						 xmlns:vm="using:LLMDesktopAssistant.Tools.MVVM.Elements"
						 xmlns:ag="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 x:Class="LLMDesktopAssistant.Tools.MVVM.Elements.AddonCardToolPolicyMaskView"
						 x:DataType="vm:AddonCardToolPolicyMaskViewModel">

	<!-- The mask toggles bring their own styles: the view stays self-contained, wherever the card is hosted. -->
	<UserControl.Styles>

		<Style Selector="ToggleButton.MaskToggle.Small">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Style Selector="^ > ico|VisualIcon">
				<Setter Property="Width" Value="16"/>
				<Setter Property="Height" Value="16"/>
			</Style>
		</Style>

		<Style Selector="ToggleButton.MaskToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#22FFFFFF"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="ToggleButton.MaskToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#5522AA44"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="ToggleButton.MaskToggle:unchecked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#55AA2244"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="ToggleButton.MaskToggle:indeterminate /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

	</UserControl.Styles>

	<ItemsControl ItemsSource="{Binding Items}"
								VerticalAlignment="Center"
								IsEnabled="{Binding IsPolicyBased}">

		<ItemsControl.ItemsPanel>
			<ItemsPanelTemplate>
				<WrapPanel ItemSpacing="2" LineSpacing="2"/>
			</ItemsPanelTemplate>
		</ItemsControl.ItemsPanel>

		<ItemsControl.ItemTemplate>
			<DataTemplate x:DataType="ag:ToolBehaviourMaskItem">
				<ToggleButton Classes="MaskToggle Small"
											IsThreeState="True"
											IsChecked="{Binding IsChecked, Mode=TwoWay}"
											IsEnabled="{Binding !IsNone}"
											ToolTip.ShowOnDisabled="True">
					<ToolTip.Tip>
						<StackPanel Orientation="Vertical" Spacing="4">
							<TextBlock Text="{loc:Loc {Binding DisplayName}}"
												 FontSize="{DynamicResource FontSizeM}"
												 FontWeight="SemiBold"/>
							<TextBlock Text="{loc:Loc {Binding Description}}"/>
							<TextBlock Text="{loc:Loc {Binding StateName}}"
												 Foreground="{Binding StateColor}"
												 FontSize="11"/>
						</StackPanel>
					</ToolTip.Tip>
					<ico:VisualIcon Kind="{Binding Icon}"
														Foreground="{Binding Color}"/>
				</ToggleButton>
			</DataTemplate>
		</ItemsControl.ItemTemplate>

	</ItemsControl>

</UserControl>
