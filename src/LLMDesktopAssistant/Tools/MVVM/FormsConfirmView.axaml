<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
			 xmlns:local="using:LLMDesktopAssistant.Tools.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
			 x:Class="LLMDesktopAssistant.Tools.MVVM.FormsConfirmView"
			 x:DataType="local:FormsConfirmViewModel">

	<Border Background="{DynamicResource CardBackground}"
			BorderBrush="{DynamicResource CardBorderBrush}"
			HorizontalAlignment="Left"
			BorderThickness="1"
			CornerRadius="8"
			Padding="16"
			Margin="4"
			MinWidth="280"
			MaxWidth="520">

		<StackPanel Orientation="Vertical" Spacing="12">

			<!-- Title -->
			<TextBlock Text="{Binding Title}"
					   FontSize="16"
					   FontWeight="Bold"
					   TextWrapping="Wrap"/>

			<!-- Description -->
			<TextBlock Text="{Binding Description}"
					   FontSize="13"
					   TextWrapping="Wrap"
					   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
					   Opacity="0.8"/>

			<!-- Buttons -->
			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Left"
						Spacing="8"
						Margin="0,8,0,0">

				<!-- Cancel button -->
				<Button Content="{Binding CancelText}"
								Command="{Binding CancelCommand}"
								IsVisible="{Binding IsResultSet, Converter={StaticResource InverseBooleanConverter}}"
								Classes="Secondary"
								MinWidth="80"/>

				<!-- Confirm button -->
				<Panel IsVisible="{Binding IsResultSet, Converter={StaticResource InverseBooleanConverter}}">
					
					<Button Content="{Binding ConfirmText}"
									Command="{Binding ConfirmCommand}"
									IsVisible="{Binding IsDanger}"
									Foreground="#FF5733"
									MinWidth="80"/>
					
					<Button Content="{Binding ConfirmText}"
									Command="{Binding ConfirmCommand}"
									IsVisible="{Binding IsDanger, Converter={StaticResource InverseBooleanConverter}}"
									MinWidth="80"/>
					
				</Panel>

				<!-- Result (after selection) -->

				<Panel IsVisible="{Binding IsResultSet}">
				
					<StackPanel Orientation="Horizontal" Spacing="4"
											IsVisible="{Binding IsConfirmed}">

						<ico:VisualIcon Kind="CheckCircle"
											Width="20" Height="20"
											Foreground="{DynamicResource SuccessColor}"/>

						<TextBlock Text="{loc:Loc forms.confirm.confirmed}" FontSize="13" Opacity="0.7"/>

					</StackPanel>
					
					<StackPanel Orientation="Horizontal" Spacing="4"
											IsVisible="{Binding IsConfirmed, Converter={StaticResource InverseBooleanConverter}}">

						<ico:VisualIcon Kind="Cancel"
											Width="20" Height="20"
											Foreground="{DynamicResource CancelColor}"/>

						<TextBlock Text="{loc:Loc forms.confirm.canceled}" FontSize="13" Opacity="0.7"/>

					</StackPanel>
					
				</Panel>

			</StackPanel>

		</StackPanel>

	</Border>

</UserControl>
