<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.Settings.Application.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 x:Class="LLMDesktopAssistant.Settings.Application.MVVM.ApplicationAppearanceSettingsView"
			 x:DataType="local:ApplicationAppearanceSettingsViewModel">

	<StackPanel Margin="10" Spacing="8">

		<TextBlock Text="{loc:Loc appsettings.appearance.title}"
				   FontWeight="Bold"
				   FontSize="{DynamicResource FontSizeL}" />

		<CheckBox Content="{loc:Loc appsettings.appearance.show_splash}"
				  IsChecked="{Binding ShowSplash}"
				  HorizontalAlignment="Left" />

	</StackPanel>

</UserControl>
