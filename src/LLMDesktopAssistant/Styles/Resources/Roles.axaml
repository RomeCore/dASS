<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		The role table. This is the only place where a design decision about colour lives: which rung of
		which ramp a semantic name points at. Views reference the role keys and never the rungs, so the
		whole application follows a change made here.

		The rungs (Neutral100, Primary500, StatusErrorSubtleBrush, ...) are generated by PaletteProvider;
		the variant split below is the only branch in the whole colour system.
	-->

	<ResourceDictionary.ThemeDictionaries>

		<ResourceDictionary x:Key="Light">

			<!-- Surfaces -->
			<SolidColorBrush x:Key="WindowBackground" Color="{DynamicResource Neutral50}" />
			<SolidColorBrush x:Key="PanelBackground" Color="{DynamicResource Neutral100}" />
			<SolidColorBrush x:Key="CardBackground" Color="{DynamicResource Neutral0}" />
			<SolidColorBrush x:Key="PopupBackground" Color="{DynamicResource Neutral0}" />
			<SolidColorBrush x:Key="Scrim" Color="{DynamicResource Neutral1000}" Opacity="0.4" />

			<!-- Text -->
			<SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource Neutral1000}" />
			<SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource Neutral800}" />
			<SolidColorBrush x:Key="TextTertiary" Color="{DynamicResource Neutral600}" />
			<SolidColorBrush x:Key="TextDisabled" Color="{DynamicResource Neutral400}" />

			<!-- Lines -->
			<SolidColorBrush x:Key="BorderSubtle" Color="{DynamicResource Neutral200}" />
			<SolidColorBrush x:Key="BorderDefault" Color="{DynamicResource Neutral300}" />
			<SolidColorBrush x:Key="BorderStrong" Color="{DynamicResource Neutral400}" />

			<!-- Control surfaces -->
			<SolidColorBrush x:Key="ControlBackground" Color="{DynamicResource Neutral0}" />
			<SolidColorBrush x:Key="ControlBackgroundHover" Color="{DynamicResource Neutral100}" />
			<SolidColorBrush x:Key="ControlBackgroundPressed" Color="{DynamicResource Neutral200}" />
			<SolidColorBrush x:Key="ControlBackgroundDisabled" Color="{DynamicResource Neutral100}" />

			<!-- Selection and focus -->
			<SolidColorBrush x:Key="SelectionBackground" Color="{DynamicResource Primary100}" />
			<SolidColorBrush x:Key="SelectionForeground" Color="{DynamicResource Neutral1000}" />
			<SolidColorBrush x:Key="FocusRing" Color="{DynamicResource Primary500}" />

			<!-- Primary family -->
			<SolidColorBrush x:Key="PrimaryBase" Color="{DynamicResource Primary600}" />
			<SolidColorBrush x:Key="PrimaryHover" Color="{DynamicResource Primary700}" />
			<SolidColorBrush x:Key="PrimaryPressed" Color="{DynamicResource Primary800}" />
			<SolidColorBrush x:Key="PrimarySubtle" Color="{DynamicResource Primary100}" />
			<SolidColorBrush x:Key="PrimaryBorder" Color="{DynamicResource Primary300}" />
			<SolidColorBrush x:Key="TextOnPrimary" Color="{DynamicResource PrimaryOn}" />

			<!-- Accent family -->
			<SolidColorBrush x:Key="AccentBase" Color="{DynamicResource Accent600}" />
			<SolidColorBrush x:Key="AccentHover" Color="{DynamicResource Accent700}" />
			<SolidColorBrush x:Key="AccentPressed" Color="{DynamicResource Accent800}" />
			<SolidColorBrush x:Key="AccentSubtle" Color="{DynamicResource Accent100}" />
			<SolidColorBrush x:Key="AccentBorder" Color="{DynamicResource Accent300}" />
			<SolidColorBrush x:Key="TextOnAccent" Color="{DynamicResource AccentOn}" />

			<!-- Status families -->
			<SolidColorBrush x:Key="StatusSuccessBase" Color="{DynamicResource StatusSuccess500}" />
			<SolidColorBrush x:Key="StatusSuccessSubtle" Color="{DynamicResource StatusSuccessOverlay}" />
			<SolidColorBrush x:Key="StatusSuccessBorder" Color="{DynamicResource StatusSuccessLine}" />
			<SolidColorBrush x:Key="TextOnSuccess" Color="{DynamicResource StatusSuccessOn}" />

			<SolidColorBrush x:Key="StatusWarningBase" Color="{DynamicResource StatusWarning500}" />
			<SolidColorBrush x:Key="StatusWarningSubtle" Color="{DynamicResource StatusWarningOverlay}" />
			<SolidColorBrush x:Key="StatusWarningBorder" Color="{DynamicResource StatusWarningLine}" />
			<SolidColorBrush x:Key="TextOnWarning" Color="{DynamicResource StatusWarningOn}" />

			<SolidColorBrush x:Key="StatusErrorBase" Color="{DynamicResource StatusError500}" />
			<SolidColorBrush x:Key="StatusErrorSubtle" Color="{DynamicResource StatusErrorOverlay}" />
			<SolidColorBrush x:Key="StatusErrorBorder" Color="{DynamicResource StatusErrorLine}" />
			<SolidColorBrush x:Key="TextOnError" Color="{DynamicResource StatusErrorOn}" />

			<SolidColorBrush x:Key="StatusDangerBase" Color="{DynamicResource StatusDanger500}" />
			<SolidColorBrush x:Key="StatusDangerSubtle" Color="{DynamicResource StatusDangerOverlay}" />
			<SolidColorBrush x:Key="StatusDangerBorder" Color="{DynamicResource StatusDangerLine}" />
			<SolidColorBrush x:Key="TextOnDanger" Color="{DynamicResource StatusDangerOn}" />

			<SolidColorBrush x:Key="StatusInfoBase" Color="{DynamicResource StatusInfo500}" />
			<SolidColorBrush x:Key="StatusInfoSubtle" Color="{DynamicResource StatusInfoOverlay}" />
			<SolidColorBrush x:Key="StatusInfoBorder" Color="{DynamicResource StatusInfoLine}" />
			<SolidColorBrush x:Key="TextOnInfo" Color="{DynamicResource StatusInfoOn}" />

		</ResourceDictionary>

		<ResourceDictionary x:Key="Dark">

			<!-- Surfaces: the window is the darkest step, panels sit above it, cards above panels. -->
			<SolidColorBrush x:Key="WindowBackground" Color="{DynamicResource Neutral1000}" />
			<SolidColorBrush x:Key="PanelBackground" Color="{DynamicResource Neutral950}" />
			<SolidColorBrush x:Key="CardBackground" Color="{DynamicResource Neutral900}" />
			<SolidColorBrush x:Key="PopupBackground" Color="{DynamicResource Neutral900}" />
			<SolidColorBrush x:Key="Scrim" Color="{DynamicResource Neutral0}" Opacity="0.5" />

			<!-- Text -->
			<SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource Neutral100}" />
			<SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource Neutral300}" />
			<SolidColorBrush x:Key="TextTertiary" Color="{DynamicResource Neutral500}" />
			<SolidColorBrush x:Key="TextDisabled" Color="{DynamicResource Neutral700}" />

			<!-- Lines -->
			<SolidColorBrush x:Key="BorderSubtle" Color="{DynamicResource Neutral800}" />
			<SolidColorBrush x:Key="BorderDefault" Color="{DynamicResource Neutral700}" />
			<SolidColorBrush x:Key="BorderStrong" Color="{DynamicResource Neutral600}" />

			<!-- Control surfaces -->
			<SolidColorBrush x:Key="ControlBackground" Color="{DynamicResource Neutral900}" />
			<SolidColorBrush x:Key="ControlBackgroundHover" Color="{DynamicResource Neutral800}" />
			<SolidColorBrush x:Key="ControlBackgroundPressed" Color="{DynamicResource Neutral700}" />
			<SolidColorBrush x:Key="ControlBackgroundDisabled" Color="{DynamicResource Neutral950}" />

			<!-- Selection and focus -->
			<SolidColorBrush x:Key="SelectionBackground" Color="{DynamicResource Primary900}" />
			<SolidColorBrush x:Key="SelectionForeground" Color="{DynamicResource Neutral100}" />
			<SolidColorBrush x:Key="FocusRing" Color="{DynamicResource Primary400}" />

			<!-- Primary family: in the dark variant hover goes lighter, not darker. -->
			<SolidColorBrush x:Key="PrimaryBase" Color="{DynamicResource Primary500}" />
			<SolidColorBrush x:Key="PrimaryHover" Color="{DynamicResource Primary400}" />
			<SolidColorBrush x:Key="PrimaryPressed" Color="{DynamicResource Primary600}" />
			<SolidColorBrush x:Key="PrimarySubtle" Color="{DynamicResource Primary900}" />
			<SolidColorBrush x:Key="PrimaryBorder" Color="{DynamicResource Primary700}" />
			<SolidColorBrush x:Key="TextOnPrimary" Color="{DynamicResource PrimaryOn}" />

			<!-- Accent family -->
			<SolidColorBrush x:Key="AccentBase" Color="{DynamicResource Accent500}" />
			<SolidColorBrush x:Key="AccentHover" Color="{DynamicResource Accent400}" />
			<SolidColorBrush x:Key="AccentPressed" Color="{DynamicResource Accent600}" />
			<SolidColorBrush x:Key="AccentSubtle" Color="{DynamicResource Accent900}" />
			<SolidColorBrush x:Key="AccentBorder" Color="{DynamicResource Accent700}" />
			<SolidColorBrush x:Key="TextOnAccent" Color="{DynamicResource AccentOn}" />

			<!-- Status families -->
			<SolidColorBrush x:Key="StatusSuccessBase" Color="{DynamicResource StatusSuccess500}" />
			<SolidColorBrush x:Key="StatusSuccessSubtle" Color="{DynamicResource StatusSuccessOverlay}" />
			<SolidColorBrush x:Key="StatusSuccessBorder" Color="{DynamicResource StatusSuccessLine}" />
			<SolidColorBrush x:Key="TextOnSuccess" Color="{DynamicResource StatusSuccessOn}" />

			<SolidColorBrush x:Key="StatusWarningBase" Color="{DynamicResource StatusWarning500}" />
			<SolidColorBrush x:Key="StatusWarningSubtle" Color="{DynamicResource StatusWarningOverlay}" />
			<SolidColorBrush x:Key="StatusWarningBorder" Color="{DynamicResource StatusWarningLine}" />
			<SolidColorBrush x:Key="TextOnWarning" Color="{DynamicResource StatusWarningOn}" />

			<SolidColorBrush x:Key="StatusErrorBase" Color="{DynamicResource StatusError500}" />
			<SolidColorBrush x:Key="StatusErrorSubtle" Color="{DynamicResource StatusErrorOverlay}" />
			<SolidColorBrush x:Key="StatusErrorBorder" Color="{DynamicResource StatusErrorLine}" />
			<SolidColorBrush x:Key="TextOnError" Color="{DynamicResource StatusErrorOn}" />

			<SolidColorBrush x:Key="StatusDangerBase" Color="{DynamicResource StatusDanger500}" />
			<SolidColorBrush x:Key="StatusDangerSubtle" Color="{DynamicResource StatusDangerOverlay}" />
			<SolidColorBrush x:Key="StatusDangerBorder" Color="{DynamicResource StatusDangerLine}" />
			<SolidColorBrush x:Key="TextOnDanger" Color="{DynamicResource StatusDangerOn}" />

			<SolidColorBrush x:Key="StatusInfoBase" Color="{DynamicResource StatusInfo500}" />
			<SolidColorBrush x:Key="StatusInfoSubtle" Color="{DynamicResource StatusInfoOverlay}" />
			<SolidColorBrush x:Key="StatusInfoBorder" Color="{DynamicResource StatusInfoLine}" />
			<SolidColorBrush x:Key="TextOnInfo" Color="{DynamicResource StatusInfoOn}" />

		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
