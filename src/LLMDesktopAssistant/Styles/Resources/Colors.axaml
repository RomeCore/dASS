<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		The colours that are deliberately outside the palette. Everything that has a semantic name in
		Roles.axaml lives there; this file is only for surfaces whose look must not follow the theme.
	-->

	<!-- Terminal card: a terminal is dark in every app theme, so its palette is fixed rather than themed. -->
	<SolidColorBrush x:Key="TerminalBackground" Color="#FF1E1E1E" />
	<SolidColorBrush x:Key="TerminalForeground" Color="#FFD4D4D4" />
	<SolidColorBrush x:Key="TerminalBarBackground" Color="#FF252528" />
	<SolidColorBrush x:Key="TerminalBarForeground" Color="#FFB8B8C0" />
	<SolidColorBrush x:Key="TerminalBarBorderBrush" Color="#FF3A3A42" />
	<SolidColorBrush x:Key="TerminalCardBorderBrush" Color="#FF3A3A42" />

	<!-- Slash-command highlight palette (see SlashCommandHighlightPalette). Overridable per theme. -->
	<SolidColorBrush x:Key="SlashCommandKnownBrush" Color="#FF6BC1"/>
	<SolidColorBrush x:Key="SlashCommandUnknownBrush" Color="#F44747"/>
	<SolidColorBrush x:Key="SlashCommandAmbiguousBrush" Color="#FFA500"/>
	<SolidColorBrush x:Key="SlashCommandArgumentBrush" Color="#8C8C8C"/>
	<SolidColorBrush x:Key="SlashCommandArgumentKeyBrush" Color="#2ECC71"/>
	<SolidColorBrush x:Key="SlashCommandArgumentEqualsBrush" Color="#1E8E5A"/>
	<SolidColorBrush x:Key="SlashCommandQuoteBrush" Color="#B9B9CC"/>
	<SolidColorBrush x:Key="SlashCommandArgumentBackgroundBrush" Color="#268C8C8C"/>

</ResourceDictionary>
