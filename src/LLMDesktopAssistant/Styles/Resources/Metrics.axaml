<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:sys="using:System">

	<!--
		Static measurements. Everything that a template must not spell out on its own lives here: paddings,
		gaps, border widths and control heights. Values are constants, so this is a plain dictionary and
		not a generator.
	-->

	<x:Double x:Key="SpacingXs">2</x:Double>
	<x:Double x:Key="SpacingS">4</x:Double>
	<x:Double x:Key="SpacingM">8</x:Double>
	<x:Double x:Key="SpacingL">12</x:Double>
	<x:Double x:Key="SpacingXl">16</x:Double>
	<x:Double x:Key="Spacing2Xl">24</x:Double>

	<Thickness x:Key="PaddingXs">4,2</Thickness>
	<Thickness x:Key="PaddingS">8,4</Thickness>
	<Thickness x:Key="PaddingM">12,6</Thickness>
	<Thickness x:Key="PaddingL">16,8</Thickness>
	<Thickness x:Key="PaddingXl">24,12</Thickness>
	<Thickness x:Key="PaddingAllM">12</Thickness>

	<Thickness x:Key="BorderThickness">1</Thickness>
	<Thickness x:Key="BorderThicknessThick">2</Thickness>
	
	<x:Double x:Key="ControlHeightXs">18</x:Double>
	<x:Double x:Key="ControlHeightS">24</x:Double>
	<x:Double x:Key="ControlHeightM">32</x:Double>
	<x:Double x:Key="ControlHeightL">40</x:Double>

	<sys:TimeSpan x:Key="DurationFast">0:0:0.18</sys:TimeSpan>
	<sys:TimeSpan x:Key="DurationNormal">0:0:0.3</sys:TimeSpan>
	<sys:TimeSpan x:Key="DurationSlow">0:0:0.48</sys:TimeSpan>

</ResourceDictionary>
