<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
										xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
										mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
										x:Class="LLMDesktopAssistant.Styles.Resources">
	
  <ResourceDictionary.MergedDictionaries>
		<!-- Resources -->
		<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Resources/Common.axaml"/>
		<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Resources/Colors.axaml"/>
		<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Resources/InputCompletion.axaml"/>
		<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Resources/Markdown.axaml"/>
		
		<!-- Controls -->
		<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Controls/ProgressRing.axaml"/>
		<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Controls/HighlightTextBox.axaml"/>
		<ResourceInclude Source="avares://LLMDesktopAssistant/Styles/Controls/SmoothScrollViewer.axaml"/>
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
