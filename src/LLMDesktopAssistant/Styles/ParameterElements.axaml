<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">

	<Design.PreviewWith>
		<Border Padding="20">
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>

	<Style Selector="StackPanel.PromptParameterContainer">
		<Setter Property="Spacing" Value="4"/>
	</Style>

	<Style Selector="TextBox.PromptParameterTitleText">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="IsReadOnly" Value="True"/>
		<Setter Property="MinHeight" Value="0"/>
	</Style>

	<Style Selector="TextBox.PromptParameterDescriptionText">
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="Opacity" Value="0.6"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="IsReadOnly" Value="True"/>
		<Setter Property="MinHeight" Value="0"/>
	</Style>

	<Style Selector="Slider.PromptParameterSlider">
		<Setter Property="MinWidth" Value="200"/>
	</Style>

	<Style Selector="TextBlock.PromptParameterSliderValue">
		<Setter Property="MinWidth" Value="40"/>
		<Setter Property="TextAlignment" Value="Right"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Opacity" Value="0.8"/>
	</Style>

	<Style Selector="CheckBox.PromptParameterCheckbox">
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="ComboBox.PromptParameterComboBox">
		<Setter Property="MinWidth" Value="200"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
	</Style>

	<Style Selector="TextBox.PromptParameterTextBox">
		<Setter Property="MinWidth" Value="200"/>
	</Style>

	<Style Selector="TextBox.PromptParameterTextBoxMultiline">
		<Setter Property="MinHeight" Value="80"/>
	</Style>

</Styles>
