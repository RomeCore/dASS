<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:conv="clr-namespace:LLMDesktopAssistant.Converters">
	
	<conv:ToUnsetIfNullConverter x:Key="ToUnsetIfNullConverter"/>
	<conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
	<conv:AssistantMessageStateToBooleanConverter x:Key="AssistantMessageStateToBooleanConverter"/>
	<conv:StringNonEmptyToBooleanConverter x:Key="StringNonEmptyToBooleanConverter"/>
	<conv:StringNonEmptyToBooleanConverter Invert="True" x:Key="StringNonEmptyToBooleanConverterInverted"/>
	<conv:StringToNullIfEmptyConverter x:Key="StringToNullIfEmptyConverter"/>
	<conv:StringToNullIfWhiteSpaceConverter x:Key="StringToNullIfWhiteSpaceConverter"/>
	<conv:NotnullToBooleanConverter x:Key="NotnullToBooleanConverter"/>
	<conv:NotnullToBooleanConverter Invert="True" x:Key="NotnullToBooleanConverterInverted"/>
	<conv:EqualsConverter x:Key="EqualsConverter"/>
	<conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
	<conv:FallbackMultiConverter x:Key="FallbackMultiConverter"/>
	<conv:JsonToMarkdownConverter x:Key="JsonToMarkdownConverter"/>
	<conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
	
	<conv:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" FalseOpacity="0.0"/>
	<conv:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter_0_25" FalseOpacity="0.25"/>
	<conv:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter_0_4" FalseOpacity="0.4"/>
	<conv:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter_0_5" FalseOpacity="0.5"/>

	<conv:DiffLineBackgroundConverter x:Key="DiffLineBackgroundConverter"/>
	<conv:DiffLineForegroundConverter x:Key="DiffLineForegroundConverter"/>
	

</ResourceDictionary>