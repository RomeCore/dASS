<Styles xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:md="using:LiveMarkdown.Avalonia"
				xmlns:loc="using:LLMDesktopAssistant.Localization"
				xmlns:ctrls="using:LLMDesktopAssistant.Markdown.Controls"
				xmlns:nodes="using:LLMDesktopAssistant.Markdown.UINodes"
				xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">
	
	<Design.PreviewWith>
		<Border Padding="20">
		
		</Border>
	</Design.PreviewWith>

	<Style Selector="md|MarkdownRenderer">
		
		<Style Selector="^ StackPanel">
			<Setter Property="Spacing" Value="16"/>
		</Style>
		
	</Style>
	
	<!-- The library paints its own text selection in a fixed blue; the chat selection is a role like any other. -->
	<Style Selector="md|MarkdownTextBlock">
		<Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/>
		<Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionForeground}"/>
	</Style>

	<!--
		Inline code is a text run, not a control: the library colours it from a static Color resource, so a
		style here is the only way to keep the pill on the palette and following the seeds.
	-->
	<Style Selector="md|CodeInline">
		<Setter Property="Background" Value="{DynamicResource ControlTrack}"/>
		<Setter Property="Foreground" Value="{DynamicResource AccentBase}"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="Padding" Value="2,0"/>
	</Style>

	<Style Selector="ctrls|ExtendedCodeBlock">
		<Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
	</Style>

	<!-- Code block tab chip: a flat label, the active one filled -->
	<Style Selector="Button.CodeBlockTab">
		<Setter Property="Padding" Value="8,2"/>
		<Setter Property="MinHeight" Value="24"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
	</Style>

	<Style Selector="Button.CodeBlockTab /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>

	<Style Selector="Button.CodeBlockTab.Selected /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CodeBlockTabSelectedBackground}"/>
	</Style>

	<Style Selector="Button.CodeBlockTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CodeBlockTabSelectedBackground}"/>
	</Style>

	<!-- Quick Action Button -->
	<Style Selector="Button.QuickAction">
		<Setter Property="Template">
			<ControlTemplate>
				<StackPanel Orientation="Horizontal"
										Spacing="2">

					<ico:VisualIcon Kind="ArrowRightBottom"
														Width="16"
														Height="16"
														Margin="0"/>

					<md:MarkdownTextBlock Text="{TemplateBinding Content}"
																Cursor="Hand"
																Background="Transparent">
						<TextBlock.TextDecorations>
							<TextDecorationCollection>
								<TextDecoration Location="Underline" StrokeThickness="1" StrokeDashArray="2,2" />
							</TextDecorationCollection>
						</TextBlock.TextDecorations>
					</md:MarkdownTextBlock>

				</StackPanel>
			</ControlTemplate>
		</Setter>
	</Style>
	
	<!-- Quick Explanation Button -->
	<Style Selector="Button.QuickExplanation">
		<Setter Property="Template">
			<ControlTemplate>
				<md:MarkdownTextBlock Text="{TemplateBinding Content}"
															Cursor="Help"
															Background="Transparent">
					<TextBlock.TextDecorations>
						<TextDecorationCollection>
							<TextDecoration Location="Underline" StrokeThickness="1" StrokeDashArray="2,2" />
						</TextDecorationCollection>
					</TextBlock.TextDecorations>
				</md:MarkdownTextBlock>
			</ControlTemplate>
		</Setter>
		<Setter Property="Flyout">
			<Flyout>
				<TextBlock Text="{Binding $parent[Button].(nodes:QuickExplanationUiNode.QuickExplanation)}"
									 TextWrapping="Wrap"/>
			</Flyout>
		</Setter>
	</Style>


	<!-- GitHub-style Alerts -->
	<Style Selector="Border.AlertBlock">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="12,10"/>
		<Setter Property="Margin" Value="0,4"/>
	</Style>
	
	<Style Selector="StackPanel.AlertBlockRoot">
		<Setter Property="Spacing" Value="6"/>
	</Style>

	<Style Selector="StackPanel.AlertBlockHeader">
		<Setter Property="Spacing" Value="6"/>
	</Style>

	<Style Selector="StackPanel.AlertBlockBody">
		<Setter Property="Spacing" Value="8"/>
	</Style>

	<Style Selector="TextBlock.AlertBlockTitle">
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockNote">
		<Setter Property="Background" Value="{DynamicResource StatusInfoSubtle}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBorder}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockNote ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource StatusInfoBase}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockNote TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource StatusInfoBase}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.note}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockTip">
		<Setter Property="Background" Value="{DynamicResource StatusSuccessSubtle}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorder}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockTip ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource StatusSuccessBase}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockTip TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource StatusSuccessBase}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.tip}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockImportant">
		<Setter Property="Background" Value="{DynamicResource PrimarySubtle}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockImportant ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource PrimaryBase}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockImportant TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource PrimaryBase}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.important}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockWarning">
		<Setter Property="Background" Value="{DynamicResource StatusWarningSubtle}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBorder}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockWarning ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource StatusWarningBase}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockWarning TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource StatusWarningBase}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.warning}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockCaution">
		<Setter Property="Background" Value="{DynamicResource StatusDangerSubtle}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource StatusDangerBorder}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockCaution ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource StatusDangerBase}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockCaution TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource StatusDangerBase}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.caution}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockSuccess">
		<Setter Property="Background" Value="{DynamicResource StatusSuccessSubtle}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorder}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockSuccess ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource StatusSuccessBase}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockSuccess TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource StatusSuccessBase}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.success}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockError">
		<Setter Property="Background" Value="{DynamicResource StatusErrorSubtle}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorder}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockError ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource StatusErrorBase}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockError TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource StatusErrorBase}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.error}"/>
	</Style>

</Styles>
