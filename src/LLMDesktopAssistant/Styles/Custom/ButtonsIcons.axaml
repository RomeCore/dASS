<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">

	<!--
		The size ladder of an icon button. The base frame (`.icon`) lives in each control's ControlTheme;
		this file only adds the three size modifiers on top of it, because a nested child selector
		(`^ > VisualIcon`) cannot be expressed inside a ControlTheme.
	-->
	<Style Selector=":is(Control).icon">
		<Style Selector="^ ico|VisualIcon">
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
		</Style>

		<Style Selector="^.small">
			<Setter Property="Width" Value="{DynamicResource ControlHeightS}" />
			<Setter Property="Height" Value="{DynamicResource ControlHeightS}" />
			<Style Selector="^ ico|VisualIcon">
				<Setter Property="Width" Value="16" />
				<Setter Property="Height" Value="16" />
			</Style>
		</Style>

		<Style Selector="^.mini">
			<Setter Property="Width" Value="{DynamicResource ControlHeightXs}" />
			<Setter Property="Height" Value="{DynamicResource ControlHeightXs}" />
			<Style Selector="^ ico|VisualIcon">
				<Setter Property="Width" Value="14" />
				<Setter Property="Height" Value="14" />
			</Style>
		</Style>

		<Style Selector="^.large">
			<Setter Property="Width" Value="{DynamicResource ControlHeightL}" />
			<Setter Property="Height" Value="{DynamicResource ControlHeightL}" />
			<Style Selector="^ ico|VisualIcon">
				<Setter Property="Width" Value="32" />
				<Setter Property="Height" Value="32" />
			</Style>
		</Style>
	</Style>

</Styles>
