<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Primary accent (replaces SystemAccentColor) -->
	<Color x:Key="PrimaryAccent">#6C5CE7</Color>
	<SolidColorBrush x:Key="PrimaryAccentBrush"
									 Color="{StaticResource PrimaryAccent}" />

	<!-- Secondary / hover accent -->
	<Color x:Key="SecondaryAccent">#7C6CF7</Color>
	<SolidColorBrush x:Key="SecondaryAccentBrush"
									 Color="{StaticResource SecondaryAccent}" />
	
	<!-- Success -->
	<Color x:Key="SuccessColor">#2ECC71</Color>
	<SolidColorBrush x:Key="SuccessBrush"
									 Color="{StaticResource SuccessColor}" />

	<!-- Warning -->
	<Color x:Key="WarningColor">#D4A017</Color>
	<SolidColorBrush x:Key="WarningBrush"
									 Color="{StaticResource WarningColor}" />

	<!-- Terminal card: a terminal is dark in every app theme, so its palette is fixed rather than themed. -->
	<SolidColorBrush x:Key="TerminalBackground" Color="#FF1E1E1E" />
	<SolidColorBrush x:Key="TerminalForeground" Color="#FFD4D4D4" />
	<SolidColorBrush x:Key="TerminalBarBackground" Color="#FF252528" />
	<SolidColorBrush x:Key="TerminalBarForeground" Color="#FFB8B8C0" />
	<SolidColorBrush x:Key="TerminalBarBorderBrush" Color="#FF3A3A42" />
	<SolidColorBrush x:Key="TerminalCardBorderBrush" Color="#FF3A3A42" />

	<!-- Error / danger -->
	<Color x:Key="ErrorColor">#FF4444</Color>
	<SolidColorBrush x:Key="ErrorBrush"
									 Color="{StaticResource ErrorColor}" />
	<Color x:Key="DangerColor">#FF4444</Color>
	<SolidColorBrush x:Key="DangerBrush"
									 Color="{StaticResource DangerColor}" />

</ResourceDictionary>
