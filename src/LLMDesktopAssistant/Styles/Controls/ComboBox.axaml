<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
										xmlns:scroll="using:LLMDesktopAssistant.Controls.Scrolling">

	<!--
		A ComboBox is a field plus a chevron plus a popup. The popup is its own surface, not a recoloured
		field, and the chevron rotates through a transform transition rather than swapping glyphs.
	-->

	<ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="FontSize" Value="{DynamicResource FontSizeM}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="MaxDropDownHeight" Value="320" />
		<Setter Property="Template">
			<ControlTemplate>
				<DataValidationErrors>
					<Grid ColumnDefinitions="*,Auto">
						<Border Name="Background"
										Grid.ColumnSpan="2"
										Background="{TemplateBinding Background}"
										BorderBrush="{TemplateBinding BorderBrush}"
										BorderThickness="{TemplateBinding BorderThickness}"
										CornerRadius="{TemplateBinding CornerRadius}">
							<Border.Transitions>
								<Transitions>
									<BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
									<BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
								</Transitions>
							</Border.Transitions>
						</Border>

						<TextBlock Name="PlaceholderTextBlock"
											 Grid.Column="0"
											 Margin="{TemplateBinding Padding}"
											 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											 Text="{TemplateBinding PlaceholderText}"
											 Foreground="{DynamicResource TextTertiary}">
							<TextBlock.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
									<Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
								</MultiBinding>
							</TextBlock.IsVisible>
						</TextBlock>

						<ContentControl Name="ContentPresenter"
														Grid.Column="0"
														Content="{TemplateBinding SelectionBoxItem}"
														ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
														Margin="{TemplateBinding Padding}"
														VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
														HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
														IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />

						<TextBox Name="PART_EditableTextBox"
										 Grid.Column="0"
										 Classes="nochrome"
										 Margin="{TemplateBinding Padding}"
										 Padding="0"
										 Foreground="{TemplateBinding Foreground}"
										 Text="{TemplateBinding Text, Mode=TwoWay}"
										 PlaceholderText="{TemplateBinding PlaceholderText}"
										 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										 IsVisible="{TemplateBinding IsEditable}" />

						<ico:VisualIcon Name="DropDownGlyph"
													Grid.Column="1"
													Kind="ChevronDown"
													Width="14"
													Height="14"
													Margin="8,0,6,0"
													HorizontalAlignment="Center"
														VerticalAlignment="Center"
														IsHitTestVisible="False"
														Foreground="{DynamicResource TextTertiary}"
														RenderTransform="rotate(0deg)">
							<ico:VisualIcon.Transitions>
								<Transitions>
									<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
								</Transitions>
							</ico:VisualIcon.Transitions>
						</ico:VisualIcon>

						<Popup Name="PART_Popup"
									 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
									 MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
									 MaxHeight="{TemplateBinding MaxDropDownHeight}"
									 PlacementTarget="Background"
									 IsLightDismissEnabled="True"
									 InheritsTransform="True"
									 WindowManagerAddShadowHint="False">
							<Border Background="{DynamicResource PopupBackground}"
											BorderBrush="{DynamicResource BorderDefault}"
											BorderThickness="1"
											CornerRadius="{DynamicResource RadiusM}"
											Padding="4"
											BoxShadow="0 10 28 -6 #66000000"
											Margin="0,4,0,0">
								<scroll:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"
																					 VerticalScrollBarVisibility="Auto"
																					 IsScrollChainingEnabled="False"
																					 Step="{TemplateBinding (scroll:SmoothScrollViewer.Step)}"
																					 Duration="{TemplateBinding (scroll:SmoothScrollViewer.Duration)}">
									<ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
								</scroll:SmoothScrollViewer>
							</Border>
						</Popup>
					</Grid>
				</DataValidationErrors>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ Border#Background">
			<Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
		</Style>
		<Style Selector="^:pressed /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
		</Style>
		<Style Selector="^:focus /template/ Border#Background">
			<Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
		</Style>
		<Style Selector="^:dropdownopen /template/ ico|VisualIcon#DropDownGlyph">
			<Setter Property="RenderTransform" Value="rotate(180deg)" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<!--
			A field whose frame is drawn by its host: the segmented model selector puts two of these inside one
			Border, so the seams are hairlines of the host rather than two overlapping borders.
		-->
		<Style Selector="^.flat">
			<Setter Property="Background" Value="#00000000" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="^.flat /template/ Border#Background">
			<Setter Property="Background" Value="#00000000" />
		</Style>
		<Style Selector="^.flat:pointerover /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
		</Style>
		<Style Selector="^.flat:pressed /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
		</Style>

		<!--
			The same field read as an action: no frame, no chevron, the size of an icon button. The choice is
			stated by the icon it shows, so the list is the only place the words appear.
		-->
		<Style Selector="^.icon">
			<Setter Property="Background" Value="#00000000" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Width" Value="{DynamicResource ControlHeightM}" />
			<Setter Property="Height" Value="{DynamicResource ControlHeightM}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
		</Style>
		<Style Selector="^.icon /template/ Border#Background">
			<Setter Property="Background" Value="#00000000" />
		</Style>
		<Style Selector="^.icon /template/ ico|VisualIcon#DropDownGlyph">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="^.icon:pointerover /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
		</Style>
		<Style Selector="^.icon:pressed /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
		</Style>
		<Style Selector="^.icon:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		</Style>
	</ControlTheme>

</ResourceDictionary>
