<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">

	<!--
		The mark is a VisualIcon, not a hand-drawn path: a stroked path inside a Viewbox is clipped by
		the box it is measured in, and clipping the glyph is exactly what makes a check look broken.
	-->

	<ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="FontSize" Value="{DynamicResource FontSizeM}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="Auto,*" Background="#00000000">
					<Border Name="PART_Box"
									Width="18"
									Height="18"
									VerticalAlignment="Center"
									CornerRadius="{DynamicResource RadiusS}"
									Background="{DynamicResource PanelBackground}"
									BorderBrush="{DynamicResource BorderStrong}"
									BorderThickness="1">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
								<BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
							</Transitions>
						</Border.Transitions>
						<Panel>
							<ico:VisualIcon Name="PART_Check"
															Kind="Check"
															Width="12"
															Height="12"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Foreground="{DynamicResource TextOnPrimary}"
															Opacity="0"
															RenderTransform="scale(0.5)">
								<ico:VisualIcon.Transitions>
									<Transitions>
										<DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
										<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
									</Transitions>
								</ico:VisualIcon.Transitions>
							</ico:VisualIcon>
							<ico:VisualIcon Name="PART_Dash"
															Kind="Minus"
															Width="12"
															Height="12"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Foreground="{DynamicResource TextOnPrimary}"
															Opacity="0"
															RenderTransform="scale(0.5)">
								<ico:VisualIcon.Transitions>
									<Transitions>
										<DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
										<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
									</Transitions>
								</ico:VisualIcon.Transitions>
							</ico:VisualIcon>
						</Panel>
					</Border>
					<ContentPresenter Name="PART_ContentPresenter"
														Grid.Column="1"
														Background="#00000000"
														Content="{TemplateBinding Content}"
														ContentTemplate="{TemplateBinding ContentTemplate}"
														Margin="8,0,0,0"
														VerticalAlignment="Center"
														RecognizesAccessKey="True" />
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ Border#PART_Box">
			<Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
		</Style>
		<Style Selector="^:checked /template/ Border#PART_Box">
			<Setter Property="Background" Value="{DynamicResource PrimaryBase}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBase}" />
		</Style>
		<Style Selector="^:checked /template/ ico|VisualIcon#PART_Check">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="RenderTransform" Value="scale(1)" />
		</Style>
		<Style Selector="^:indeterminate /template/ Border#PART_Box">
			<Setter Property="Background" Value="{DynamicResource PrimarySubtle}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}" />
		</Style>
		<Style Selector="^:indeterminate /template/ ico|VisualIcon#PART_Dash">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="RenderTransform" Value="scale(1)" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Opacity" Value="0.45" />
		</Style>
	</ControlTheme>

</ResourceDictionary>
