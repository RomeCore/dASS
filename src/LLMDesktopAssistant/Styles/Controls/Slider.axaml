<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		The track is drawn by the Track's own buttons, the way the reference sliders do it: the decrease
		button is the filled half, the increase button the empty half, and the split is exactly where the
		thumb sits. That removes the separate background border, and with it any chance of the fill and
		the handle disagreeing.
	-->

	<ControlTheme x:Key="SliderTrackButton" TargetType="RepeatButton">
		<Setter Property="Background" Value="#00000000" />
		<!-- The legacy RepeatButton styles still apply app-wide; a track button must own its geometry. -->
		<Setter Property="Padding" Value="0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="RenderTransform" Value="none" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid>
					<Border Background="#00000000" Margin="0,-12" />
					<Border Background="{TemplateBinding Background}"
									Height="4"
									CornerRadius="{DynamicResource RadiusPill}"
									VerticalAlignment="Center" />
				</Grid>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid Height="32" Background="#00000000">
					<!--
						The Track takes the full height: its buttons are sized from `trackLength - thumbLength`, so a
						4px track would leave nothing for them (the thumb alone is 16px) and the track would vanish.
						The 4px bar is drawn inside each button, centred.
					-->
					<Track Name="PART_Track"
								 Minimum="{TemplateBinding Minimum}"
								 Maximum="{TemplateBinding Maximum}"
								 Value="{TemplateBinding Value}"
								 Orientation="{TemplateBinding Orientation}">
						<Track.DecreaseButton>
							<RepeatButton Name="PART_DecreaseButton"
														Theme="{StaticResource SliderTrackButton}"
														Background="{DynamicResource PrimaryBase}" />
						</Track.DecreaseButton>
						<Track.IncreaseButton>
							<RepeatButton Name="PART_IncreaseButton"
														Theme="{StaticResource SliderTrackButton}"
														Background="{DynamicResource ControlTrack}" />
						</Track.IncreaseButton>
						<Thumb Width="16"
									 Height="16"
									 VerticalAlignment="Center"
									 Background="{DynamicResource CardBackground}"
									 BorderBrush="{DynamicResource PrimaryBase}"
									 BorderThickness="2"
									 CornerRadius="8"
									 RenderTransform="scale(1)" />
					</Track>
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ Thumb">
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryHover}" />
		</Style>
		<Style Selector="^:pressed /template/ Thumb">
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryPressed}" />
			<Setter Property="RenderTransform" Value="scale(0.9)" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Opacity" Value="0.45" />
		</Style>
	</ControlTheme>

</ResourceDictionary>
