<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		The dot grows out of the ring instead of appearing: a scale from 0.3 to 1 reads as a selection,
		a fade alone reads as a repaint.
	-->

	<ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="FontSize" Value="{DynamicResource FontSizeM}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="Auto,*" Background="#00000000">
					<Border Name="PART_Ring"
									Width="18"
									Height="18"
									VerticalAlignment="Center"
									CornerRadius="9"
									Background="{DynamicResource PanelBackground}"
									BorderBrush="{DynamicResource BorderStrong}"
									BorderThickness="1">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
								<BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
							</Transitions>
						</Border.Transitions>
						<Ellipse Name="PART_Dot"
										 Width="8"
										 Height="8"
										 Fill="{DynamicResource PrimaryBase}"
										 HorizontalAlignment="Center"
										 VerticalAlignment="Center"
										 Opacity="0"
										 RenderTransform="scale(0.3)">
							<Ellipse.Transitions>
								<Transitions>
									<DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
									<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
								</Transitions>
							</Ellipse.Transitions>
						</Ellipse>
					</Border>
					<ContentPresenter Name="PART_ContentPresenter"
														Grid.Column="1"
														Background="#00000000"
														Content="{TemplateBinding Content}"
														ContentTemplate="{TemplateBinding ContentTemplate}"
														Margin="8,0,0,0"
														VerticalAlignment="Center"
														RecognizesAccessKey="True" />
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ Border#PART_Ring">
			<Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
		</Style>
		<Style Selector="^:checked /template/ Border#PART_Ring">
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBase}" />
		</Style>
		<Style Selector="^:checked /template/ Ellipse#PART_Dot">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="RenderTransform" Value="scale(1)" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Opacity" Value="0.45" />
		</Style>
	</ControlTheme>

</ResourceDictionary>
