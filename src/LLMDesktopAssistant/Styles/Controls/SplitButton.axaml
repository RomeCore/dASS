<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">

	<!--
		Two halves, one frame: the outer Border paints the surface and the hairline, each half is a
		borderless Button with its own translucent wash, and the separator is a 1px line. Avoiding per
		side corner and thickness converters keeps the theme free of Fluent helpers.
	-->

	<ControlTheme x:Key="SplitButtonPart" TargetType="Button">
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="Padding" Value="14,7" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}"
								CornerRadius="{TemplateBinding CornerRadius}">
					<Panel>
						<Border Name="PART_Wash"
										Background="{DynamicResource ControlBackgroundHover}"
										CornerRadius="{TemplateBinding CornerRadius}"
										Opacity="0"
										IsHitTestVisible="False">
							<Border.Transitions>
								<Transitions>
									<DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
								</Transitions>
							</Border.Transitions>
						</Border>
						<ContentPresenter Name="PART_Content"
															Background="#00000000"
															Content="{TemplateBinding Content}"
															Margin="{TemplateBinding Padding}"
															ContentTemplate="{TemplateBinding ContentTemplate}"
															HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
															VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
															Foreground="{TemplateBinding Foreground}" />
					</Panel>
				</Border>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ Border#PART_Wash">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="^:pressed /template/ Border#PART_Wash">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
		</Style>
		<Style Selector="^[Tag=checked] /template/ Border#PART_Wash">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Background" Value="{DynamicResource PrimarySubtle}" />
		</Style>
	</ControlTheme>

	<ControlTheme x:Key="{x:Type SplitButton}" TargetType="SplitButton">
		<Setter Property="Background" Value="{DynamicResource ControlBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
		<Setter Property="Padding" Value="14,7" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="FontSize" Value="{DynamicResource FontSizeM}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="*,Auto,Auto">
					<Border Name="PART_Root"
									Grid.ColumnSpan="3"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
								<BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
							</Transitions>
						</Border.Transitions>
					</Border>

					<Button Name="PART_PrimaryButton"
									Grid.Column="0"
									Theme="{StaticResource SplitButtonPart}"
									CornerRadius="{DynamicResource RadiusLeftM}"
									Padding="{TemplateBinding Padding}"
									Foreground="{TemplateBinding Foreground}"
									Content="{TemplateBinding Content}"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Command="{TemplateBinding Command}"
									CommandParameter="{TemplateBinding CommandParameter}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch" />

					<Border Name="SeparatorBorder"
									Grid.Column="1"
									Width="1"
									Margin="0,7"
									Background="{DynamicResource BorderSubtle}" />

					<Button Name="PART_SecondaryButton"
									Grid.Column="2"
									Theme="{StaticResource SplitButtonPart}"
									CornerRadius="{DynamicResource RadiusRightM}"
									Padding="10,0"
									Foreground="{DynamicResource TextSecondary}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch">
						<ico:VisualIcon Kind="ChevronDown" Width="12" Height="12" />
					</Button>
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ Border#PART_Root">
			<Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
		</Style>
		<Style Selector="^:checked /template/ Border#PART_Root">
			<Setter Property="Background" Value="{DynamicResource PrimarySubtle}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}" />
		</Style>
		<Style Selector="^:checked /template/ Button">
			<Setter Property="Tag" Value="checked" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Opacity" Value="0.4" />
		</Style>
	</ControlTheme>

</ResourceDictionary>
