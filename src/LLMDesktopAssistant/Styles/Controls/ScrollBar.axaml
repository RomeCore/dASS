<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		A faithful port of the stock ScrollBar template: the same three-row/column grid, the same line
		buttons occupying ScrollBarSize, the same Track in the middle and the same explicit thumb sizes.
		Only the brushes and the thumb's look are ours - the geometry is not a place to improvise.
	-->

	<x:Double x:Key="ScrollBarSize">10</x:Double>

	<!--
		The thumb control keeps the full ScrollBarSize in its cross axis, because Track computes its
		geometry from the thumb's bounds - a margin here would shift those bounds on every arrange and
		fight the drag. The thin look is drawn inside: a 6px bar centred in a 10px thumb.
	-->
	<ControlTheme x:Key="ScrollBarThumbVertical" TargetType="Thumb">
		<Setter Property="Background" Value="{DynamicResource BorderStrong}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}"
								Width="6"
								HorizontalAlignment="Center"
								CornerRadius="{DynamicResource RadiusPill}" />
			</ControlTemplate>
		</Setter>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
			</Transitions>
		</Setter>
		<Style Selector="^:pointerover">
			<Setter Property="Background" Value="{DynamicResource TextTertiary}" />
		</Style>
		<Style Selector="^:pressed">
			<Setter Property="Background" Value="{DynamicResource TextSecondary}" />
		</Style>
	</ControlTheme>

	<ControlTheme x:Key="ScrollBarThumbHorizontal" TargetType="Thumb">
		<Setter Property="Background" Value="{DynamicResource BorderStrong}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}"
								Height="6"
								VerticalAlignment="Center"
								CornerRadius="{DynamicResource RadiusPill}" />
			</ControlTemplate>
		</Setter>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
			</Transitions>
		</Setter>
		<Style Selector="^:pointerover">
			<Setter Property="Background" Value="{DynamicResource TextTertiary}" />
		</Style>
		<Style Selector="^:pressed">
			<Setter Property="Background" Value="{DynamicResource TextSecondary}" />
		</Style>
	</ControlTheme>

	<ControlTheme x:Key="ScrollBarPageButton" TargetType="RepeatButton">
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="RenderTransform" Value="none" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}" />
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="ScrollBarLineButton" TargetType="RepeatButton">
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="RenderTransform" Value="none" />
		<Setter Property="Opacity" Value="0" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}" />
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
		<Setter Property="MinWidth" Value="{StaticResource ScrollBarSize}" />
		<Setter Property="MinHeight" Value="{StaticResource ScrollBarSize}" />
		<Setter Property="Background" Value="#00000000" />

		<Style Selector="^:vertical">
			<Setter Property="Template">
				<ControlTemplate>
					<Grid>
						<Border Background="{TemplateBinding Background}" />
						<Grid RowDefinitions="Auto,*,Auto">
							<RepeatButton Name="PART_LineUpButton"
														Theme="{StaticResource ScrollBarLineButton}"
														Grid.Row="0"
														HorizontalAlignment="Center"
														MinWidth="{StaticResource ScrollBarSize}"
														Height="{StaticResource ScrollBarSize}" />

							<Track Grid.Row="1"
										 Minimum="{TemplateBinding Minimum}"
										 Maximum="{TemplateBinding Maximum}"
										 Value="{TemplateBinding Value, Mode=TwoWay}"
										 DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
										 ViewportSize="{TemplateBinding ViewportSize}"
										 Orientation="{TemplateBinding Orientation}"
										 IsDirectionReversed="True">
								<Track.DecreaseButton>
									<RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" />
								</Track.DecreaseButton>
								<Track.IncreaseButton>
									<RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" />
								</Track.IncreaseButton>
								<Thumb Theme="{StaticResource ScrollBarThumbVertical}"
													 Width="{StaticResource ScrollBarSize}"
													 MinHeight="24" />
							</Track>

							<RepeatButton Name="PART_LineDownButton"
														Theme="{StaticResource ScrollBarLineButton}"
														Grid.Row="2"
														HorizontalAlignment="Center"
														MinWidth="{StaticResource ScrollBarSize}"
														Height="{StaticResource ScrollBarSize}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="^:horizontal">
			<Setter Property="Template">
				<ControlTemplate>
					<Grid>
						<Border Background="{TemplateBinding Background}" />
						<Grid ColumnDefinitions="Auto,*,Auto">
							<RepeatButton Name="PART_LineUpButton"
														Theme="{StaticResource ScrollBarLineButton}"
														Grid.Column="0"
														VerticalAlignment="Center"
														MinHeight="{StaticResource ScrollBarSize}"
														Width="{StaticResource ScrollBarSize}" />

							<Track Grid.Column="1"
										 Minimum="{TemplateBinding Minimum}"
										 Maximum="{TemplateBinding Maximum}"
										 Value="{TemplateBinding Value, Mode=TwoWay}"
										 DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
										 ViewportSize="{TemplateBinding ViewportSize}"
										 Orientation="{TemplateBinding Orientation}">
								<Track.DecreaseButton>
									<RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" />
								</Track.DecreaseButton>
								<Track.IncreaseButton>
									<RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" />
								</Track.IncreaseButton>
								<Thumb Theme="{StaticResource ScrollBarThumbHorizontal}"
													 Height="{StaticResource ScrollBarSize}"
													 MinWidth="24" />
							</Track>

							<RepeatButton Name="PART_LineDownButton"
														Theme="{StaticResource ScrollBarLineButton}"
														Grid.Column="2"
														VerticalAlignment="Center"
														MinHeight="{StaticResource ScrollBarSize}"
														Width="{StaticResource ScrollBarSize}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>
	</ControlTheme>

</ResourceDictionary>
