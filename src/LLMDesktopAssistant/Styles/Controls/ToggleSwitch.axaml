<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		The knob glides because of KnobTransitions, a property of ToggleSwitch itself: the control moves
		Canvas.Left and the theme supplies the transition. Without the setter the knob teleports, so the
		theme is the only place this animation can live.
	-->

	<ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="FontSize" Value="{DynamicResource FontSizeM}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="KnobTransitions">
			<Transitions>
				<DoubleTransition Property="Canvas.Left" Duration="0:0:0.18" Easing="CubicEaseOut" />
			</Transitions>
		</Setter>
		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="Auto,Auto" Background="#00000000">
					<Border Name="PART_Track"
									Width="40"
									Height="22"
									VerticalAlignment="Center"
									CornerRadius="11"
									Background="{DynamicResource PanelBackground}"
									BorderBrush="{DynamicResource BorderStrong}"
									BorderThickness="1">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
								<BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
							</Transitions>
						</Border.Transitions>
					</Border>
					<Canvas Name="PART_SwitchKnob"
									Width="18"
									Height="18"
									Margin="2,0,0,0"
									HorizontalAlignment="Left"
									VerticalAlignment="Center">
						<Grid Name="PART_MovingKnobs" Width="18" Height="18">
							<Ellipse Width="14"
											 Height="14"
											 HorizontalAlignment="Center"
											 VerticalAlignment="Center"
											 Fill="{DynamicResource TextSecondary}">
								<Ellipse.Transitions>
									<Transitions>
										<BrushTransition Property="Fill" Duration="0:0:0.18" Easing="CubicEaseOut" />
									</Transitions>
								</Ellipse.Transitions>
							</Ellipse>
						</Grid>
					</Canvas>
					<ContentPresenter Name="PART_OnContentPresenter"
														Grid.Column="1"
														Background="#00000000"
														Content="{TemplateBinding OnContent}"
														ContentTemplate="{TemplateBinding OnContentTemplate}"
														Margin="10,0,0,0"
														VerticalAlignment="Center" />
					<ContentPresenter Name="PART_OffContentPresenter"
														Grid.Column="1"
														Background="#00000000"
														Content="{TemplateBinding OffContent}"
														ContentTemplate="{TemplateBinding OffContentTemplate}"
														Margin="10,0,0,0"
														VerticalAlignment="Center" />
				</Grid>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:checked /template/ Border#PART_Track">
			<Setter Property="Background" Value="{DynamicResource PrimaryBase}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBase}" />
		</Style>
		<Style Selector="^:checked /template/ Ellipse">
			<Setter Property="Fill" Value="{DynamicResource TextOnPrimary}" />
		</Style>
		<Style Selector="^:pointerover /template/ Border#PART_Track">
			<Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<!-- Both presenters live in the same cell; the state, not the section, decides which one shows. -->
		<Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="^:unchecked /template/ ContentPresenter#PART_OnContentPresenter">
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="^:unchecked /template/ ContentPresenter#PART_OffContentPresenter">
			<Setter Property="Opacity" Value="1" />
		</Style>
	</ControlTheme>

</ResourceDictionary>
