<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:conv="using:Avalonia.Controls.Converters"
										xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">

	<!--
		The chevron is its own keyed theme: the app-wide ToggleButton carries padding, a 32px box and a
		hover wash, none of which belongs inside a 18px indent slot. A rotated ChevronRight animates the
		expansion instead of swapping two glyphs.
	-->

	<ControlTheme x:Key="TreeViewChevron" TargetType="ToggleButton">
		<Setter Property="Width" Value="18" />
		<Setter Property="Height" Value="18" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="#00000000">
					<ico:VisualIcon Kind="ChevronRight"
													Width="12"
													Height="12"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Foreground="{DynamicResource TextTertiary}"
													RenderTransform="rotate(0deg)">
						<ico:VisualIcon.Transitions>
							<Transitions>
								<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
							</Transitions>
						</ico:VisualIcon.Transitions>
					</ico:VisualIcon>
				</Border>
			</ControlTemplate>
		</Setter>
		<Style Selector="^:checked /template/ ico|VisualIcon">
			<Setter Property="RenderTransform" Value="rotate(90deg)" />
		</Style>
		<Style Selector="^:pointerover /template/ ico|VisualIcon">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		</Style>
	</ControlTheme>

	<!--
		The row paints the surface, the header presenter stays transparent. Indentation comes from the
		control's Level through the stock converter - the theme must not compute it.
	-->

	<ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="Template">
			<ControlTemplate>
				<StackPanel>
					<Border Name="PART_Root"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="{TemplateBinding CornerRadius}"
									MinHeight="26"
									TemplatedControl.IsTemplateFocusTarget="True">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
							</Transitions>
						</Border.Transitions>
						<Grid Name="PART_Header" ColumnDefinitions="Auto,*">
							<Grid.Margin>
								<MultiBinding Converter="{x:Static conv:TreeViewItemIndentConverter.Instance}">
									<Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
									<DynamicResource ResourceKey="SpacingXl" />
								</MultiBinding>
							</Grid.Margin>
							<Panel Name="PART_ExpandCollapseChevronContainer"
										 Width="18"
										 Margin="0,0,4,0">
								<ToggleButton Name="PART_ExpandCollapseChevron"
															Theme="{StaticResource TreeViewChevron}"
															Focusable="False"
															IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
							</Panel>
							<ContentPresenter Name="PART_HeaderPresenter"
																Grid.Column="1"
																Focusable="False"
																Background="#00000000"
																Content="{TemplateBinding Header}"
																ContentTemplate="{TemplateBinding HeaderTemplate}"
																VerticalAlignment="Center"
																Margin="{TemplateBinding Padding}"
																Foreground="{TemplateBinding Foreground}" />
						</Grid>
					</Border>
					<ItemsPresenter Name="PART_ItemsPresenter"
													IsVisible="{TemplateBinding IsExpanded}"
													ItemsPanel="{TemplateBinding ItemsPanel}" />
				</StackPanel>
			</ControlTemplate>
		</Setter>

		<!-- The border, not the item, tracks the pointer: the child rows sit inside the item's bounds. -->
		<Style Selector="^ /template/ Border#PART_Root:pointerover">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
		</Style>
		<Style Selector="^:pressed /template/ Border#PART_Root:pointerover">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
		</Style>
		<Style Selector="^:selected /template/ Border#PART_Root">
			<Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
		</Style>
		<Style Selector="^:selected">
			<Setter Property="Foreground" Value="{DynamicResource SelectionForeground}" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="^:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
			<Setter Property="Width" Value="18" />
		</Style>
	</ControlTheme>

</ResourceDictionary>
