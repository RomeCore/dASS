<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		The spinner owns the frame, the field inside carries none: the text box is a nochrome TextBox
		whose padding is forwarded from the NumericUpDown.
	-->

	<ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
		<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
		<Setter Property="Padding" Value="10,6,4,6" />
		<Setter Property="FontSize" Value="{DynamicResource FontSizeM}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="Template">
			<ControlTemplate>
				<DataValidationErrors>
					<ButtonSpinner Name="PART_Spinner"
												 Background="{TemplateBinding Background}"
												 BorderBrush="{TemplateBinding BorderBrush}"
												 BorderThickness="{TemplateBinding BorderThickness}"
												 CornerRadius="{TemplateBinding CornerRadius}"
												 Padding="0"
												 IsTabStop="False"
												 HorizontalContentAlignment="Stretch"
												 VerticalContentAlignment="Stretch"
												 ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
												 ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
												 AllowSpin="{TemplateBinding AllowSpin}">
						<TextBox Name="PART_TextBox"
										 Classes="nochrome"
										 Padding="{TemplateBinding Padding}"
										 Foreground="{TemplateBinding Foreground}"
										 FontSize="{TemplateBinding FontSize}"
										 Text="{TemplateBinding Text, Mode=TwoWay}"
										 TextAlignment="{TemplateBinding TextAlignment}"
										 AcceptsReturn="False"
										 TextWrapping="NoWrap"
										 VerticalContentAlignment="Center" />
					</ButtonSpinner>
				</DataValidationErrors>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

</ResourceDictionary>
