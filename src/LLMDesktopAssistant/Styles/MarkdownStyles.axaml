<Styles xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:md="using:LiveMarkdown.Avalonia"
				xmlns:loc="using:LLMDesktopAssistant.Localization"
				xmlns:beh="using:LLMDesktopAssistant.Controls.Behaviours"
				xmlns:nodes="using:LLMDesktopAssistant.Markdown.UINodes"
				xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">
	
	<Design.PreviewWith>
		<Border Padding="20">
		
		</Border>
	</Design.PreviewWith>

	<Style Selector="md|MarkdownRenderer">
		
		<Style Selector="^ StackPanel">
			<Setter Property="Spacing" Value="16"/>
		</Style>
		
	</Style>
	
	<Style Selector="md|CodeBlock">

		<Setter Property="beh:MarkdownCodeBlockBehaviour.IsExtendedCodeBlock" Value="True"/>
		
		<Setter Property="Template">
			<ControlTemplate TargetType="md:CodeBlock">
				<StackPanel Orientation="Vertical" Spacing="0">

					<Border Background="{DynamicResource BorderColor}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1" CornerRadius="4,4,0,0">

						<DockPanel Margin="4,2" LastChildFill="True">

							<TextBlock x:Name="PART_LanguageTextBlock"
												 DockPanel.Dock="Left"
												 VerticalAlignment="Center"
												 Text="{TemplateBinding Language}"/>

							<StackPanel DockPanel.Dock="Right"
													HorizontalAlignment="Right"
													Orientation="Horizontal"
													Spacing="2">

								<ToggleButton x:Name="PART_ToggleTextWrapButton"
															Focusable="False"
															Classes="IconButton"
															IsChecked="{TemplateBinding IsCodeWrapped, Mode=TwoWay}">

									<ico:VisualIcon Kind="Wrap"/>
								</ToggleButton>

								<ItemsControl ItemsSource="{TemplateBinding (beh:MarkdownCodeBlockBehaviour.CodeBlockExtensions)}"
															x:CompileBindings="False">
									
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" Spacing="2"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>

									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Classes="IconButton"
															Focusable="False"
															Command="{Binding Command}"
															ToolTip.Tip="{loc:Loc {Binding Tooltip}}"
															IsVisible="{Binding IsButtonVisible}">

												<ico:VisualIcon Kind="{Binding Icon}"/>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>

								</ItemsControl>
								
							</StackPanel>
						</DockPanel>
					</Border>

					<Border Background="{DynamicResource SecondaryCardBackgroundColor}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1,0,1,1" CornerRadius="0,0,4,4">

						<ScrollViewer x:Name="PART_ScrollViewer"
													HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
													VerticalScrollBarVisibility="Auto">

							<md:MarkdownTextBlock x:Name="PART_CodeTextBlock" Margin="4"
																		FontFamily="{TemplateBinding FontFamily}"
																		TextWrapping="{TemplateBinding TextWrapping}"/>
						</ScrollViewer>

					</Border>
					
					<ItemsControl ItemsSource="{TemplateBinding (beh:MarkdownCodeBlockBehaviour.CodeBlockExtensions)}"
												x:CompileBindings="False">
									
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" Spacing="0"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<ContentControl Content="{Binding AdditionalViewModel}"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>
			</ControlTemplate>
		</Setter>

	</Style>

	<!-- Quick Action Button -->
	<Style Selector="Button.QuickAction">
		<Setter Property="Template">
			<ControlTemplate>
				<StackPanel Orientation="Horizontal"
										Spacing="2">

					<ico:VisualIcon Kind="ArrowRightBottom"
														Width="16"
														Height="16"
														Margin="0"/>

					<md:MarkdownTextBlock Text="{TemplateBinding Content}"
																Cursor="Hand"
																Background="Transparent">
						<TextBlock.TextDecorations>
							<TextDecorationCollection>
								<TextDecoration Location="Underline" StrokeThickness="1" StrokeDashArray="2,2" />
							</TextDecorationCollection>
						</TextBlock.TextDecorations>
					</md:MarkdownTextBlock>

				</StackPanel>
			</ControlTemplate>
		</Setter>
	</Style>
	
	<!-- Quick Explanation Button -->
	<Style Selector="Button.QuickExplanation">
		<Setter Property="Template">
			<ControlTemplate>
				<md:MarkdownTextBlock Text="{TemplateBinding Content}"
															Cursor="Help"
															Background="Transparent">
					<TextBlock.TextDecorations>
						<TextDecorationCollection>
							<TextDecoration Location="Underline" StrokeThickness="1" StrokeDashArray="2,2" />
						</TextDecorationCollection>
					</TextBlock.TextDecorations>
				</md:MarkdownTextBlock>
			</ControlTemplate>
		</Setter>
		<Setter Property="Flyout">
			<Flyout>
				<TextBlock Text="{Binding $parent[Button].(nodes:QuickExplanationUiNode.QuickExplanation)}"
									 TextWrapping="Wrap"/>
			</Flyout>
		</Setter>
	</Style>


	<!-- GitHub-style Alerts -->
	<Style Selector="Border.AlertBlock">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="12,10"/>
		<Setter Property="Margin" Value="0,4"/>
	</Style>
	
	<Style Selector="StackPanel.AlertBlockRoot">
		<Setter Property="Spacing" Value="6"/>
	</Style>

	<Style Selector="StackPanel.AlertBlockHeader">
		<Setter Property="Spacing" Value="6"/>
	</Style>

	<Style Selector="StackPanel.AlertBlockBody">
		<Setter Property="Spacing" Value="8"/>
	</Style>

	<Style Selector="TextBlock.AlertBlockTitle">
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeS}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockNote">
		<Setter Property="Background" Value="{DynamicResource AlertNoteBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AlertNoteBorderBrush}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockNote ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource AlertNoteColor}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockNote TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource AlertNoteColor}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.note}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockTip">
		<Setter Property="Background" Value="{DynamicResource AlertTipBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AlertTipBorderBrush}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockTip ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource AlertTipColor}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockTip TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource AlertTipColor}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.tip}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockImportant">
		<Setter Property="Background" Value="{DynamicResource AlertImportantBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AlertImportantBorderBrush}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockImportant ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource AlertImportantColor}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockImportant TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource AlertImportantColor}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.important}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockWarning">
		<Setter Property="Background" Value="{DynamicResource AlertWarningBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AlertWarningBorderBrush}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockWarning ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource AlertWarningColor}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockWarning TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource AlertWarningColor}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.warning}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockCaution">
		<Setter Property="Background" Value="{DynamicResource AlertCautionBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AlertCautionBorderBrush}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockCaution ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource AlertCautionColor}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockCaution TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource AlertCautionColor}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.caution}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockSuccess">
		<Setter Property="Background" Value="{DynamicResource AlertSuccessBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AlertSuccessBorderBrush}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockSuccess ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource AlertSuccessColor}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockSuccess TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource AlertSuccessColor}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.success}"/>
	</Style>

	<Style Selector="Border.AlertBlock.AlertBlockError">
		<Setter Property="Background" Value="{DynamicResource AlertErrorBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AlertErrorBorderBrush}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockError ico|VisualIcon">
		<Setter Property="Foreground" Value="{DynamicResource AlertErrorColor}"/>
	</Style>
	<Style Selector="Border.AlertBlock.AlertBlockError TextBlock.AlertBlockTitle">
		<Setter Property="Foreground" Value="{DynamicResource AlertErrorColor}"/>
		<Setter Property="Text" Value="{loc:Loc alert.title.error}"/>
	</Style>

</Styles>
