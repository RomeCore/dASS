<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ico="using:LLMDesktopAssistant.Controls.Icons">

	<!--
		A message part chip. The look lives here rather than in AdditionalMessagePartView because a local value in
		the view beats any style - and a surface that wants a lighter chip has to win over this one.
	-->
	<Style Selector="Border.messagePartChip" x:CompileBindings="False">
		<Setter Property="Background" Value="{DynamicResource MessageBackground}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush">
			<Setter.Value>
				<MultiBinding Converter="{StaticResource FallbackMultiConverter}">
					<Binding Path="ChipColor" Converter="{StaticResource ColorToBrushConverter}"/>
					<DynamicResource ResourceKey="DefaultForeground"/>
				</MultiBinding>
			</Setter.Value>
		</Setter>
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="6,3" />
	</Style>

	<Style Selector="Border.messagePartChip ico|VisualIcon" x:CompileBindings="False">
		<Setter Property="Foreground">
			<Setter.Value>
				<MultiBinding Converter="{StaticResource FallbackMultiConverter}">
					<Binding Path="ChipColor" Converter="{StaticResource ColorToBrushConverter}"/>
					<DynamicResource ResourceKey="DefaultForeground"/>
				</MultiBinding>
			</Setter.Value>
		</Setter>
		<Setter Property="Width" Value="14" />
		<Setter Property="Height" Value="14" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

</Styles>
