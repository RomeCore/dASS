// Слеш-команды: ошибки разбора аргументов.

%locale: ru-RU
%namespace: command

error.missing_argument: Не указан обязательный аргумент.
error.invalid_argument: Недопустимое значение аргумента.
error.too_many_arguments: Слишком много аргументов.
error.parse_error: Не удалось разобрать аргументы.
error.unknown: Неизвестная команда '{0}'.

// Имена аргументов (command.argument.*).
argument.wait: wait
argument.wait.description: Ждать ли завершения субагента перед продолжением.
argument.arguments: аргументы
argument.arguments.description: Аргументы команды.
argument.agent.message: сообщение
argument.agent.message.description: Сообщение, с которым запускается субагент.

// Команда навыка (command.skill.*).
skill.used: Использован навык '{0}'.

// Команда агента (command.agent.*) и её ошибки.
error.sub_agent_not_found: Субагент '{0}' не найден.
agent.result: Результат субагента '{0}'

// Автодополнение ввода (command.completion.*).
completion.no_matches: Нет подходящих команд.
completion.defeated: Перекрыта другой командой; уточните пространством имён.
completion.title.commands: Команды
completion.arguments: Аргументы
completion.required: обязательно
completion.hint: ↑↓ выбрать · Tab принять · Esc закрыть

// Native commands (command.addon_reload.*).
addon_reload.name: Перезагрузка аддонов
addon_reload.description: Перечитать аддон-паки и перезагрузить все менеджеры аддонов.
addon_reload.done: Аддоны перезагружены

// Call command (command.call.*, command.argument.call.*, command.error.agent_not_found).
call.name: Вызвать агента
call.description: Принудительно запустить конкретного чат-агента следующим ходом, минуя роутер.
argument.call.agent: агент
argument.call.agent.description: Имя чат-агента, которого нужно вызвать принудительно.
error.agent_not_found: Агент '{0}' не найден.
