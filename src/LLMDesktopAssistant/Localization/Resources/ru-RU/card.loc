commands.source.script: Скрипт
commands.source.skill: Навык
commands.source.subagent: Субагент
commands.source.tool: Инструмент

// =====================================================
// === Hooks                                        ===
// =====================================================
hooks.type: Тип хука (glob-шаблон)
hooks.target: Фильтр по цели хука (glob-шаблон)
