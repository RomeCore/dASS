// Slash commands: argument grammar errors.

%locale: 
%namespace: command

error.missing_argument: A required argument is missing.
error.invalid_argument: The argument value is not valid.
error.too_many_arguments: Too many arguments.
error.parse_error: The arguments could not be parsed.
error.unknown: Unknown command '{0}'.

// Argument names (command.argument.*).
argument.wait: wait
argument.wait.description: Whether to wait for the sub-agent to finish before continuing.
argument.skill.arguments: arguments
argument.skill.arguments.description: The skill's arguments; substituted into the skill body as ARGUMENTS.
argument.agent.message: message
argument.agent.message.description: The message the sub-agent is asked to work on.

// Skill command (command.skill.*).
skill.used: Used skill '{0}'.

// Agent command (command.agent.*) and its errors.
error.sub_agent_not_found: Sub-agent '{0}' was not found.
agent.result: Sub-agent '{0}' result

// Input completion (command.completion.*).
completion.no_matches: No matching commands.
completion.defeated: Shadowed by another command; add a namespace to select it.
