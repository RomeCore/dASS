// Agents: info, read permissions, exposure modes, selection.

%locale:
%namespace: appsettings

language.system: System
language.title: Language

web.fetch.title: Web-fetch
web.enable_browser: Enable browser fetching
web.enable_browser.hint: Allow pages to be loaded with a headless browser (renders JavaScript) when a higher fetch level is needed.
web.enable_stealth: Enable stealth browser fetching
web.enable_stealth.hint: Allow pages to be loaded with the stealth CloakBrowser. Evades advanced anti-bot systems (Cloudflare, reCAPTCHA v3, FingerprintJS).
web.default_fetch_level: Default fetch level
web.level.http: Plain HTTP request
web.level.browser: Headless browser
web.level.stealth: Stealth browser (CloakBrowser)
web.runtimes: Browser runtimes
web.playwright: Playwright
web.stealth: Stealth (CloakBrowser)
web.installed: Installed
web.not_installed: Not installed
web.install: Install

appearance.title: Appearance
appearance.show_splash: Show the startup splash screen
