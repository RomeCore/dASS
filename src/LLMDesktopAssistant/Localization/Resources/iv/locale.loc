// Default (neutral) locale - English.
// Structure: %locale - required, %namespace - optional prefix for all keys in this file.
// Single-line entry:  key: value
// Multiline entry:    key """
//                     value
//                     """
// Comments:           // full-line comments only

%locale:
%namespace: common

add: Add
approve: Approve
cancel: Cancel
close: Close
connect: Connect
default: Default
delete: Delete
disconnect: Disconnect
edit: Edit
enable: Enable
name: Name
ok: Ok
policy: Policy
remove: Remove
rename: Rename
duplicate: Duplicate
reset: Reset
code: Code
copy: Copy
split: Split view
wrap: Wrap
save: Save
diagram: Diagram
preview: Preview
search: Search
settings: Settings
help: Help
create: Create
error: Error
on: On
off: Off

