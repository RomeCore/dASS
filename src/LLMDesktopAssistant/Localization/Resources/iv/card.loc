// The unified addon card UI: everything the cards render.
// The 'card.*' keys are shared by the cards of every addon type, the per-type labels live under
// 'card.<addon type>.*' (see the 'card.skills.*' section below).

%locale: 
%namespace: card

// =====================================================
// === Shared                                       ===
// =====================================================
details: Details
category: Category
parameters: Parameters
parameters.toggle: Show parameters
body: Content
metadata: Metadata
metadata.author: Author
metadata.compatibility: Compatibility
metadata.license: License
metadata.version: Version
tag.filter: Filter by this tag
state.enabled: Toggle the enabled state
state.hidden: Toggle the shown state
source.unknown: Unknown
source.template: Template
source.pack: Addon pack
actions.open: Open file
actions.explorer: Show in explorer
actions.delete: Delete file
delete.title: Delete addon file?
delete.confirm: The file {0} will be permanently deleted. This action cannot be undone.

// =====================================================
// === Groups                                       ===
// =====================================================
grouping.flat: Flat list
grouping.category: By category
grouping.pack: By addon pack
group.count: {0} addons
group.visible_count: {0} of {1}
group.mixed: Mixed
group.uncategorized: Uncategorized
group.builtin: Built-in
group.enabled: Toggle the enabled state of the visible items
group.hidden: Toggle the hidden state of the visible items
group.expand: Expand or collapse the group

// =====================================================
// === Skills                                       ===
// =====================================================
skills.injection_mode.default: Name and description
skills.injection_mode.full: Full body
skills.tools.badge: {0} tools
skills.tools.allowed: Used without approval
skills.tools.available: Available while the skill is active
skills.tools.disallowed: Disallowed while the skill is active

// =====================================================
// === Sub-agents                                   ===
// =====================================================
sub_agents.tools.badge: {0} tools
sub_agents.skills.badge: {0} skills
sub_agents.sub_agents.badge: {0} sub-agents
sub_agents.memory_blocks.badge: {0} memory blocks
sub_agents.tools.allowed: Used without approval
sub_agents.tools.available: Available for the sub-agent
sub_agents.tools.disallowed: Disallowed for the sub-agent
sub_agents.skills: Available skills
sub_agents.sub_agents: Available sub-agents
sub_agents.memory_blocks: Memory blocks
sub_agents.links.skill: Skill {0} does not exist
sub_agents.links.sub_agent: Sub-agent {0} does not exist
sub_agents.links.memory_block: Memory block {0} does not exist

// =====================================================
// === Scripts                                      ===
// =====================================================
scripts.native: Native
scripts.namespace: Namespace
scripts.namespace.global: Global
scripts.manuals: Manuals

// =====================================================
// === Commands                                     ===
// =====================================================
commands.source: Command source
commands.source.unknown: Unknown
commands.source.native: Native
commands.source.script: Script
commands.source.skill: Skill
commands.source.subagent: Sub-agent
commands.source.tool: Tool

// =====================================================
// === Tools                                        ===
// =====================================================
tools.policy_mask: Policy mask
tools.specifiers: Specifiers
tools.specifiers.toggle: Show specifier rules
tools.specifiers.union_mode: Union mode
tools.specifiers.aggregation_mode: Aggregation mode
tools.specifiers.pattern: Pattern
tools.arguments: Tool arguments
tools.arguments.toggle: Show tool arguments
