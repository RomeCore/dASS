<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 d:DesignWidth="600" d:DesignHeight="300"
						 xmlns:local="using:LLMDesktopAssistant.Desktop.ToolModules.Terminal"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:LLMDesktopAssistant.Controls.Icons"
						 xmlns:term="using:LLMDesktopAssistant.Desktop.Execution.Terminals"
						 x:Class="LLMDesktopAssistant.Desktop.ToolModules.Terminal.TerminalAdditionalView"
						 x:DataType="local:TerminalAdditionalViewModel"
						 x:CompileBindings="True">

	<UserControl.Styles>

		<!--
			The card is a terminal, so it stays dark in every app theme: the palette is fixed, the frame is
			the same dark border the bar uses.
		-->
		<Style Selector="Border.terminalCard">
			<Setter Property="Background" Value="{DynamicResource TerminalBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource TerminalCardBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Margin" Value="4" />
			<Setter Property="ClipToBounds" Value="True" />
		</Style>

		<!-- Keyboard focus inside the terminal, and only there: the card accepts typing. -->
		<Style Selector="Border.terminalCard.focused">
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
			<Setter Property="BoxShadow" Value="0 0 6 0 #806C5CE7" />
		</Style>

		<Style Selector="Border.terminalBar">
			<Setter Property="Background" Value="{DynamicResource TerminalBarBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource TerminalBarBorderBrush}" />
			<Setter Property="BorderThickness" Value="0,1,0,0" />
			<Setter Property="CornerRadius" Value="0,0,6,6" />
			<Setter Property="Padding" Value="6,3" />
		</Style>

		<!-- The grip the user drags to change the terminal height. It is the only place that owns a
				 vertical drag: the terminal itself needs the pointer for selection. -->
		<Style Selector="Border.resizeGrip">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Border.resizeGrip:pointerover">
			<Setter Property="Background" Value="#406C5CE7" />
		</Style>

		<!-- Status dot: green while awaited, amber once left, grey when finished, red on failure. -->
		<Style Selector="Ellipse.statusDot">
			<Setter Property="Width" Value="7" />
			<Setter Property="Height" Value="7" />
			<Setter Property="Fill" Value="#FF8C8C94" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="Ellipse.statusDot.running">
			<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
		</Style>

		<Style Selector="Ellipse.statusDot.left">
			<Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
		</Style>

		<Style Selector="Ellipse.statusDot.failed">
			<Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
		</Style>

		<Style Selector="Button.terminalAction">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

	</UserControl.Styles>

	<Border x:Name="Card"
					Classes="terminalCard"
					Height="{Binding CardHeight}">

		<Grid RowDefinitions="*,Auto,Auto">

			<!-- Terminal control -->
			<Grid Grid.Row="0"
						IsVisible="{Binding !IsCollapsed}"
						ColumnDefinitions="*,Auto">

				<term:TerminalView x:Name="TerminalHost"
													 FontFamily="Cascadia Mono,Consolas,monospace"
													 FontSize="13"
													 Background="{DynamicResource TerminalBackground}"
													 Foreground="{DynamicResource TerminalForeground}"
													 BufferSize="5000" />

				<!-- Scrollback: one notch is one line, the thumb shows how much of the buffer is visible -->
				<ScrollBar x:Name="TerminalScrollBar"
									 Grid.Column="1"
									 Orientation="Vertical"
									 AllowAutoHide="False"
									 IsVisible="False" />

			</Grid>

			<!-- Drag this to resize: one notch of drag is one pixel of height -->
			<Border x:Name="ResizeGrip"
							Grid.Row="1"
							Classes="resizeGrip"
							Height="5"
							Cursor="SizeNorthSouth"
							IsVisible="{Binding !IsCollapsed}"
							ToolTip.Tip="{loc:Loc message.terminal.tooltip.resize}" />

			<!-- Bar: actions on the left, process status on the right -->
			<Border Grid.Row="2"
							Classes="terminalBar">

				<Grid ColumnDefinitions="Auto,*,Auto">

					<StackPanel Grid.Column="0"
											Orientation="Horizontal"
											Spacing="6"
											VerticalAlignment="Center">

						<!-- Fold/unfold, offered only once the process is over -->
						<StackPanel Orientation="Horizontal"
												Spacing="2"
												IsVisible="{Binding CanCollapse}">

							<Button Classes="IconButton"
											Command="{Binding ToggleCollapsedCommand}"
											IsVisible="{Binding IsCollapsed}"
											ToolTip.Tip="{loc:Loc message.terminal.tooltip.expand}">
								<ico:VisualIcon Kind="ChevronDown" />
							</Button>

							<Button Classes="IconButton"
											Command="{Binding ToggleCollapsedCommand}"
											IsVisible="{Binding !IsCollapsed}"
											ToolTip.Tip="{loc:Loc message.terminal.tooltip.collapse}">
								<ico:VisualIcon Kind="ChevronUp" />
							</Button>

						</StackPanel>

						<Button Classes="terminalAction danger"
										Content="{loc:Loc message.terminal.action.kill}"
										Command="{Binding KillCommand}"
										IsVisible="{Binding CanKill}" />

						<Button Classes="terminalAction secondary"
										Content="{loc:Loc message.terminal.action.leave}"
										Command="{Binding LeaveCommand}"
										IsVisible="{Binding CanLeave}" />

					</StackPanel>

					<StackPanel Grid.Column="2"
											Orientation="Horizontal"
											Spacing="6"
											VerticalAlignment="Center"
											ToolTip.Tip="{Binding ErrorMessage}">

						<Ellipse Classes="statusDot"
										 Classes.running="{Binding IsAwaiting}"
										 Classes.left="{Binding IsLeft}"
										 Classes.failed="{Binding IsFailed}" />

						<TextBlock Text="{loc:Loc {Binding StatusKey}}"
											 FontSize="11"
											 Foreground="{DynamicResource TerminalBarForeground}"
											 VerticalAlignment="Center"
											 TextTrimming="CharacterEllipsis" />

					</StackPanel>

				</Grid>

			</Border>

		</Grid>
	</Border>
</UserControl>
