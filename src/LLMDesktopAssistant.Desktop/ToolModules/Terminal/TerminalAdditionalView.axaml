<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.microsoft.com/winfx/markup-compatibility/2006"
						 d:DesignWidth="600" d:DesignHeight="300"
						 xmlns:local="using:LLMDesktopAssistant.Desktop.ToolModules.Terminal"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:add="using:LLMDesktopAssistant.LLM.MVVM.Additional"
						 xmlns:term="using:LLMDesktopAssistant.Desktop.Execution.Terminals"
						 x:Class="LLMDesktopAssistant.Desktop.ToolModules.Terminal.TerminalAdditionalView"
						 x:DataType="local:TerminalAdditionalViewModel"
						 x:CompileBindings="False">

	<Border BorderBrush="{DynamicResource CardBorderBrush}"
					BorderThickness="1"
					CornerRadius="6"
					Margin="4"
					Padding="0"
					HorizontalAlignment="{Binding DataContext.Alignment.Horizontal,
						RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type add:AdditionalChatDataCollectionView}}}"
					MaxHeight="450">

		<Grid RowDefinitions="*,Auto">

			<!-- Terminal Control -->
			<Grid ColumnDefinitions="*,Auto">

				<term:TerminalView x:Name="TerminalHost"
								   FontFamily="Cascadia Mono,Consolas,monospace"
								   FontSize="13"
								   Background="#1E1E1E"
								   Foreground="#D4D4D4"
								   BufferSize="5000"/>

				<!-- Scrollback: one notch is one line, the thumb shows how much of the buffer is visible -->
				<ScrollBar x:Name="TerminalScrollBar"
						   Grid.Column="1"
						   Orientation="Vertical"
						   AllowAutoHide="False"
						   IsVisible="False"/>

			</Grid>

			<!-- Footer with controls -->
			<Border Grid.Row="1"
							Background="{DynamicResource CardBackground}"
							Padding="8,4"
							CornerRadius="0,0,6,6">

				<StackPanel Orientation="Horizontal" Spacing="8">

					<Button Content="{loc:Loc common.cancel}"
									Command="{Binding CancelCommand}"
									IsVisible="{Binding IsRunning}"
									Classes="Secondary"
									FontSize="12"
									Padding="8,2"/>

				</StackPanel>

			</Border>

		</Grid>
	</Border>
</UserControl>
