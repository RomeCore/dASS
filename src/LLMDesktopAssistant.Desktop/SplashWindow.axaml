<Window xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:splash="using:LLMDesktopAssistant.Startup.Splash"
				x:Class="LLMDesktopAssistant.Desktop.SplashWindow"
				Width="400"
				Height="380"
				CanResize="False"
				ShowInTaskbar="False"
				WindowDecorations="None"
				Topmost="True"
				WindowStartupLocation="CenterScreen"
				Background="#1B1B1F">

	<splash:SplashView x:Name="SplashContent" />
</Window>
