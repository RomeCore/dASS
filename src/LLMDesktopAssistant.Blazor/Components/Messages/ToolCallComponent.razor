@using System.ComponentModel
@using LLMDesktopAssistant.LLM.Domain
@using LLMDesktopAssistant.LLM.MVVM.Messages
@using LLMDesktopAssistant.LLM.Services.Tools
@using LLMDesktopAssistant.Utils
@using Material.Icons

@implements IDisposable

@rendermode InteractiveServer

@inject IToolsetCacheService ToolsetCache

<div class="toolcall-item" data-status="@ToolCall.Status">
	<span class="toolcall-icon">
		@switch (ToolCall.Status)
		{
			case ToolStatus.Pending:
				<VisualIconComponent Kind="@MaterialIconKind.Wrench" Size="16" />
				break;
			case ToolStatus.Executing:
				<VisualIconComponent Kind="@MaterialIconKind.Wrench" Size="16" Color="#0078d4" />
				break;
			case ToolStatus.ExecutionInterrupted:
				<VisualIconComponent Kind="@MaterialIconKind.Wrench" Size="16" Color="#1976d2" />
				break;
			case ToolStatus.Success:
				<VisualIconComponent Kind="@MaterialIconKind.CheckCircle" Size="16" Color="#388e3c" />
				break;
			case ToolStatus.Error:
				<VisualIconComponent Kind="@MaterialIconKind.AlertCircle" Size="16" Color="#d32f2f" />
				break;
			case ToolStatus.Cancelled:
				<VisualIconComponent Kind="@MaterialIconKind.CancelCircle" Size="16" Color="#d32f2f" />
				break;
			default:
				<VisualIconComponent Kind="@MaterialIconKind.Wrench" Size="16" />
				break;
		}
	</span>
	<span class="toolcall-name">@_title</span>
	@if (!string.IsNullOrWhiteSpace(ToolCall.StatusTitle))
	{
		@if (ToolCall.StatusIcon.HasValue)
		{
			<VisualIconComponent Kind="@ToolCall.StatusIcon" />
		}
		<span class="toolcall-status">
			<MarkdownComponent MarkdownText="@ToolCall.StatusTitle" />
		</span>
	}

	@if (_showArgs)
	{
		<div class="toolcall-args">
			<MarkdownComponent MarkdownText="@ToolCallArgumentFormatter.FormatToMarkdown(TolerantJsonParser.Parse(ToolCall.Arguments))" />
		</div>
	}

	@if (!string.IsNullOrWhiteSpace(ToolCall.ResultContent))
	{
		<details class="toolcall-result-details">
			<summary class="toolcall-result-summary">
				<VisualIconComponent Kind="@MaterialIconKind.CodeBraces" Size="14" Color="rgba(0,0,0,0.5)" AdditionalStyle="margin-right: 4px;" />
				@LocalizationManager.LocalizeStatic("webui.result")
			</summary>
			<div class="toolcall-result-content">
				<pre><code>@ToolCall.ResultContent</code></pre>
			</div>
		</details>
	}
</div>

@code {

	[Parameter]
	public required ToolCall ToolCall { get; init; }

	private string? _title;
	private bool _showArgs = false;
	private string _argsPreview = string.Empty;

	protected override void OnInitialized()
	{
		_title = ToolsetCache.AvailableTools.GetValueOrDefault(ToolCall.ToolName)
			?.NameKey.Value ?? LocalizationManager.LocalizeStatic(ToolCall.ToolName);

		ToolCall.PropertyChanged += OnToolCallPropertyChanged;
	}

	private void OnToolCallPropertyChanged(object? sender, PropertyChangedEventArgs e)
	{
		InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}

	public void Dispose()
	{
		ToolCall.PropertyChanged -= OnToolCallPropertyChanged;
	}
}
