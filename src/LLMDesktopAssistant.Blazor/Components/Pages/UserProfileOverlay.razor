@using LLMDesktopAssistant.Users
@using Material.Icons

<div class="user-profile-overlay @(_isVisible ? "visible" : "")" @onclick="HandleOverlayClick">
	<div class="user-profile-panel" @onclick:stopPropagation>
		<div class="user-profile-header">
			<h3>@LocalizationManager.LocalizeStatic("webui.profile.title")</h3>
			<button class="user-profile-close-btn" @onclick="Close" title="@LocalizationManager.LocalizeStatic("webui.profile.close")">
				<VisualIconComponent Kind="@MaterialIconKind.Close" Size="20" Color="#666" />
			</button>
		</div>

		<div class="user-profile-body">
			@* Profile *@
			<div class="user-profile-avatar-section">
				@if (!string.IsNullOrEmpty(_user?.Base64ProfileImage))
				{
					<div class="user-profile-avatar">
						<img src="data:image/png;base64,@_user.Base64ProfileImage" alt="Avatar" />
					</div>
				}
				else
				{
					<div class="user-profile-avatar user-profile-avatar-placeholder">
						<VisualIconComponent Kind="@MaterialIconKind.AccountCircle" Size="64" Color="#888" />
					</div>
				}
				<div class="user-profile-avatar-actions">
					<button class="user-profile-avatar-btn"
							@onclick="SelectImage"
							disabled="@_isUploading"
							title="Upload avatar">
						<VisualIconComponent Kind="@MaterialIconKind.Camera" Size="16" Color="white" />
					</button>
					@if (!string.IsNullOrEmpty(_user?.Base64ProfileImage))
					{
						<button class="user-profile-avatar-btn user-profile-avatar-delete-btn"
								@onclick="DeleteAvatar"
								disabled="@_isUploading"
								title="@LocalizationManager.LocalizeStatic("webui.profile.avatar.delete.title")">
							<VisualIconComponent Kind="@MaterialIconKind.Delete" Size="16" Color="#d32f2f" />
						</button>
					}
				</div>
			</div>

			@* Fields *@
			<div class="user-profile-field">
				<label class="user-profile-label">@LocalizationManager.LocalizeStatic("webui.login.label")</label>
				<input class="user-profile-input" @bind="_editLogin" placeholder="user_login" disabled="@_isDisabled" />
			</div>

			<div class="user-profile-field">
				<label class="user-profile-label">@LocalizationManager.LocalizeStatic("webui.profile.name")</label>
				<input class="user-profile-input" @bind="_editName" placeholder="User" />
			</div>

			<div class="user-profile-field">
				<label class="user-profile-label">@LocalizationManager.LocalizeStatic("webui.profile.description")</label>
				<textarea class="user-profile-textarea" @bind="_editDescription" placeholder="@LocalizationManager.LocalizeStatic("webui.profile.description.placeholder")" rows="4"></textarea>
			</div>

			@if (!string.IsNullOrEmpty(_statusMessage))
			{
				<div class="user-profile-status @(_statusIsError ? "error" : "success")">
					@_statusMessage
				</div>
			}
		</div>

		<div class="user-profile-footer">
			<div class="user-profile-footer-left">
				<button class="user-profile-logout-btn" @onclick="Logout">
					<VisualIconComponent Kind="@MaterialIconKind.Logout" Size="16" Color="#d32f2f" />
					<span>@LocalizationManager.LocalizeStatic("webui.profile.logout")</span>
				</button>
			</div>
			<div class="user-profile-footer-right">
				<button class="user-profile-cancel-btn" @onclick="Close">@LocalizationManager.LocalizeStatic("webui.profile.cancel")</button>
				<button class="user-profile-save-btn" @onclick="Save" disabled="@_isSaving">
					@if (_isSaving)
					{
						<span>@LocalizationManager.LocalizeStatic("webui.profile.saving")</span>
					}
					else
					{
						<span>@LocalizationManager.LocalizeStatic("webui.profile.save")</span>
					}
				</button>
			</div>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public bool IsVisible { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	[Parameter]
	public UserInformation? User { get; set; }

	[Inject]
	private IJSRuntime JS { get; set; } = default!;

	[Inject]
	private NavigationManager NavigationManager { get; set; } = default!;

	private bool _isVisible;
	private bool _isSaving;
	private bool _isDisabled;
	private bool _isUploading;
	private CancellationTokenSource? _imageCts;
	private string? _statusMessage;
	private bool _statusIsError;

	private string _editLogin = string.Empty;
	private string _editName = string.Empty;
	private string _editDescription = string.Empty;
	private UserInformation? _user;

	protected override void OnParametersSet()
	{
		_isVisible = IsVisible;
		_user = User;

		if (_user != null)
		{
			_editLogin = _user.Login;
			_editName = _user.Name;
			_editDescription = _user.Description;
			_isDisabled = true;
		}

		_statusMessage = null;
	}

	private async Task Save()
	{
		if (_user == null) return;

		_isSaving = true;
		_statusMessage = null;

		try
		{
			_user.Name = _editName;
			_user.Description = _editDescription;

			_statusMessage = LocalizationManager.LocalizeStatic("webui.profile.save.success");
			_statusIsError = false;
		}
		catch (Exception ex)
		{
			_statusMessage = $"Ошибка: {ex.Message}";
			_statusIsError = true;
		}
		finally
		{
			_isSaving = false;
		}
	}

	private void Close()
	{
		OnClose.InvokeAsync();
	}

	private async Task Logout()
	{
		await JS.InvokeVoidAsync("logoutUser");
		NavigationManager.NavigateTo("/login", forceLoad: false);
	}

	private async Task SelectImage()
	{
		if (_user == null || _isUploading) return;

		_isUploading = true;
		_imageCts = new CancellationTokenSource(TimeSpan.FromSeconds(65));
		_statusMessage = null;

		try
		{
			var base64 = await JS.InvokeAsync<string>("selectProfileImage", _imageCts.Token);
			if (!string.IsNullOrEmpty(base64))
			{
				_user.Base64ProfileImage = base64;
				_statusMessage = LocalizationManager.LocalizeStatic("webui.profile.avatar.updated");
				_statusIsError = false;
			}
			else
			{
				// User cancelled or the operation was aborted — no feedback needed
			}
		}
		catch (OperationCanceledException)
		{
			// JS interop timed out — user likely walked away with the dialog open
			_statusMessage = LocalizationManager.LocalizeStatic("webui.profile.avatar.timeout");
			_statusIsError = true;
		}
		catch (Exception ex)
		{
			_statusMessage = $"{LocalizationManager.LocalizeStatic("webui.profile.avatar.error")}: {ex.Message}";
			_statusIsError = true;
		}
		finally
		{
			_isUploading = false;
			_imageCts?.Dispose();
			_imageCts = null;
		}
	}


	private void DeleteAvatar()
	{
		if (_user == null || string.IsNullOrEmpty(_user.Base64ProfileImage))
			return;

		_user.Base64ProfileImage = string.Empty;
		_statusMessage = LocalizationManager.LocalizeStatic("webui.profile.avatar.deleted");
		_statusIsError = false;
	}

	private void HandleOverlayClick()
	{
		Close();
	}
}
