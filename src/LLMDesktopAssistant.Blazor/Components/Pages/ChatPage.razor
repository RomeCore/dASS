@page "/"

@using LLMDesktopAssistant.Blazor.Components.Messages
@using LLMDesktopAssistant.Blazor.Services
@using LLMDesktopAssistant.LLM.Domain
@using LLMDesktopAssistant.LLM.Services
@using LLMDesktopAssistant.Users
@using Material.Icons
@using Microsoft.AspNetCore.Authorization

@implements IDisposable

@inject NavigationManager Navigation
@inject IUserStateService UserState
@inject Chat chat
@inject IChatOperationService chatOperation
@inject IChatExecutionTokenService ExecutionTokens
@inject IFollowUpChatMessageQueue FollowUps
@inject IUserManagementService userManager
@inject IJSRuntime JS

@rendermode InteractiveServer

@attribute [Authorize]

<div class="chat-layout">

	<div class="chat-topbar">
		<div class="chat-topbar-left">
			<VisualIconComponent Kind="@MaterialIconKind.ShieldAccount" Size="20" Color="#0078d4" />
			<span class="chat-topbar-user">@(UserState.GetCurrentUser()?.Name ?? LocalizationManager.LocalizeStatic("webui.anonymous"))</span>
		</div>
		<div class="chat-topbar-right">
			<button class="chat-topbar-profile-btn" @onclick="ToggleProfileOverlay" title="@LocalizationManager.LocalizeStatic("webui.profile.title")">
				<VisualIconComponent Kind="@MaterialIconKind.AccountSettings" Size="18" Color="#666" />
				<span>@LocalizationManager.LocalizeStatic("webui.profile.button")</span>
			</button>
		</div>
	</div>
	<div class="chat-messages-container" id="messages-container">
		<MessageSequenceComponent Messages="@chat.Messages" OnEdit="BeginEdit" />
		<ChatStatusComponent />
	</div>

	<div class="chat-input-area">

		@* Input chips: the pending queue and the message being edited, as an overlay above the divider. *@
		@if (_queueCount > 0 || _editingMessage != null)
		{
			<div class="chat-chips">
				@if (_queueCount > 0)
				{
					<div class="chat-chip">
						<button class="chat-chip-body" @onclick="OpenQueueDialog">
							@LocalizationManager.LocalizeStaticFormat("chat.follow_up.chip", _queueCount)
						</button>
						<button class="chat-chip-close" title="@LocalizationManager.LocalizeStatic("chat.follow_up.clear")" @onclick="ClearQueue">
							<VisualIconComponent Kind="@MaterialIconKind.Close" Size="14" />
						</button>
					</div>
				}

				@if (_editingMessage != null)
				{
					<div class="chat-chip">
						<button class="chat-chip-body" @onclick="RevealEditingMessage">
							@LocalizationManager.LocalizeStatic("chat.follow_up.edit_chip")
						</button>
						<button class="chat-chip-close" title="@LocalizationManager.LocalizeStatic("chat.input.cancel_edit.hint")" @onclick="CancelEdit">
							<VisualIconComponent Kind="@MaterialIconKind.Close" Size="14" />
						</button>
					</div>
				}
			</div>
		}

		@* Queue dialog: every pending follow-up in composition order, each removable on its own. *@
		@if (_showQueueDialog)
		{
			<div class="chat-dialog-backdrop" @onclick="CloseQueueDialog">
				<div class="chat-dialog-card" @onclick:stopPropagation="true">
					<div class="chat-dialog-title">@LocalizationManager.LocalizeStatic("chat.follow_up.dialog.title")</div>

					@if (_queueEntries.Count == 0)
					{
						<span class="chat-dialog-empty">@LocalizationManager.LocalizeStatic("chat.follow_up.dialog.empty")</span>
					}
					else
					{
						@foreach (var entry in _queueEntries)
						{
							<div class="chat-queue-item">
								<div class="chat-queue-preview">@Preview(entry)</div>
								<div class="chat-queue-meta">
									<span>@LocalizationManager.LocalizeStaticFormat("chat.follow_up.item.sender", entry.UserInput.SenderLogin)</span>
									<span>@LevelTitle(entry.Level)</span>
									<span>@entry.CreatedAt.ToLocalTime().ToString("g")</span>
								</div>
								<button class="msg-action-btn" title="@LocalizationManager.LocalizeStatic("chat.follow_up.item.remove")" @onclick="() => RemoveEntry(entry)">
									<VisualIconComponent Kind="@MaterialIconKind.Close" Size="16" />
								</button>
							</div>
						}
					}

					<button class="chat-dialog-close" @onclick="CloseQueueDialog">@LocalizationManager.LocalizeStatic("chat.follow_up.close")</button>
				</div>
			</div>
		}

		<div class="chat-input-row">
			<input class="chat-input"
				   @bind="_inputText"
				   @bind:event="oninput"
				   @onkeydown="HandleKeyDown"
				   placeholder="@LocalizationManager.LocalizeStatic("webui.chat.input.placeholder")" />

			@* Send without generation: while a run is going this queues with no answer requested *@
			<button class="chat-send-btn"
					@onclick="SendMessageWithoutGeneration"
					disabled="@(!CanSubmit)"
					title="@LocalizationManager.LocalizeStatic("chat.input.send_button.hint")">
				<VisualIconComponent Kind="@MaterialIconKind.SendClock" Size="18" Color="white" />
			</button>

			@* Send: inserts at once when idle, queues while a run is going, flushes on an empty box with a pending queue *@
			<button class="chat-send-btn"
					@onclick="SendMessageWithGeneration"
					disabled="@(!CanSubmit)"
					title="@LocalizationManager.LocalizeStatic("chat.input.send_generate_button.hint")">
				<VisualIconComponent Kind="@MaterialIconKind.Send" Size="18" Color="white" />
			</button>

			@if (_isGenerating)
			{
				@* Stop: a hard stop, it never injects the queue *@
				<button class="chat-stop-btn" title="@LocalizationManager.LocalizeStatic("webui.generation.stop")" @onclick="StopGeneration">
					<VisualIconComponent Kind="@MaterialIconKind.Stop" Size="20" Color="white" />
				</button>
			}
		</div>

		<div class="chat-input-row chat-input-tools">
			<select class="chat-visibility-select"
					@bind="_selectedVisibility"
					title="@LocalizationManager.LocalizeStatic("message.visibility.hint")">
				@foreach (var vis in _visibilityOptions)
				{
					<option value="@vis.Key">@vis.Value</option>
				}
			</select>

			<ReadinessPanel />
		</div>
	</div>
</div>

<UserProfileOverlay IsVisible="_showProfileOverlay"
					User="@(UserState.GetCurrentUser())"
					OnClose="CloseProfileOverlay" />

@code {
	private string _inputText = string.Empty;
	private bool _isGenerating = false;
	private bool _showProfileOverlay = false;

	private int _queueCount;
	private List<FollowUpMessage> _queueEntries = [];
	private bool _showQueueDialog;
	private BranchedMessage? _editingMessage;

	/// <summary>
	/// When <see langword="true"/>, the next render will scroll to bottom.
	/// Used after sending a message (without generation) to ensure the new message is visible.
	/// </summary>
	private bool _pendingScroll = false;

	private MessageVisibility _selectedVisibility = MessageVisibility.Always;
	private Dictionary<MessageVisibility, string> _visibilityOptions = new()
	{
		{ MessageVisibility.Always, LocalizationManager.LocalizeStatic("message.visibility.always") },
		{ MessageVisibility.RevealAfterSend, LocalizationManager.LocalizeStatic("message.visibility.reveal_after_send") },
		{ MessageVisibility.OnlyUsers, LocalizationManager.LocalizeStatic("message.visibility.only_users") },
		{ MessageVisibility.OnlyAgents, LocalizationManager.LocalizeStatic("message.visibility.only_agents") },
	};

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		chat.Messages.CollectionChanged += MessagesChanged;
		ExecutionTokens.ExecutionCancellationTokenChanged += ExecutionStateChanged;
		FollowUps.Changed += OnQueueChanged;
		_isGenerating = ExecutionTokens.ExecutionCancellationToken != null;
		_queueCount = FollowUps.Count;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await base.OnAfterRenderAsync(firstRender);

		if (firstRender)
		{
			// Set up the observer once on first render - it will watch for DOM changes
			await JS.InvokeVoidAsync("ChatScroll.init", "messages-container");
			await ScrollToBottom(true);
		}
		else if (_pendingScroll)
		{
			_pendingScroll = false;
			await ScrollToBottom(true);
		}
	}

	private async void MessagesChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e)
	{
		await InvokeAsync(StateHasChanged);

		// JS observer handles auto-scroll when _autoScrollEnabled is active.
		// No need to call JS interop here for every change.
	}

	private void ExecutionStateChanged()
	{
		InvokeAsync(() =>
		{
			_isGenerating = ExecutionTokens.ExecutionCancellationToken != null;
			StateHasChanged();

			if (_isGenerating)
			{
				StartAutoScroll();
			}
			else
			{
				StopAutoScroll();
			}
		});
	}

	private void StartAutoScroll()
	{
		// Enable the JS observer and scroll to bottom immediately
		_ = JS.InvokeVoidAsync("ChatScroll.enable");
	}

	private void StopAutoScroll()
	{
		// Disable the JS observer and do one final smooth scroll
		_ = JS.InvokeVoidAsync("ChatScroll.disable");
		_ = ScrollToBottom(true);
	}

	private async Task HandleKeyDown(KeyboardEventArgs e)
	{
		if (e.Key != "Enter" || e.ShiftKey)
			return;

		await SubmitAsync(generate: !e.CtrlKey);
	}

	/// <summary>
	/// Routes a submit through the follow-up matrix, mirroring the desktop: a run in progress queues the text or stops
	/// the run, an empty box flushes the queue, and an idle chat sends as usual.
	/// </summary>
	private async Task SubmitAsync(bool generate)
	{
		var text = _inputText?.Trim();

		try
		{
			// An edit is never queued: committing it is a turn of its own, and that turn stops the run.
			if (_editingMessage != null)
			{
				if (!string.IsNullOrWhiteSpace(text))
					await SendAsync(text, generate);

				return;
			}

			if (_isGenerating)
			{
				if (!string.IsNullOrWhiteSpace(text))
					await EnqueueAsync(text, generate);
				else if (generate)
					await chatOperation.StopAndFlushAsync();
				else
					await chatOperation.StopGenerationAsync();

				return;
			}

			if (!string.IsNullOrWhiteSpace(text))
			{
				await SendAsync(text, generate);
				return;
			}

			if (FollowUps.HasAny)
				await chatOperation.FlushFollowUpsAsync(generate: false);
		}
		catch (Exception ex)
		{
			Console.Error.WriteLine($"Failed to submit: {ex.Message}");
		}
	}

	private UserInputState CreateUserInput(string text) => new()
	{
		Content = text,
		SenderLogin = UserState.GetCurrentUser()?.Login ?? "anonymous",
		Parts = [],
		Visibility = _selectedVisibility,
		VisibleTo = [],
		// TODO: Rights are not modelled yet: every participant may run a command.
		CanExecuteCommand = true
	};

	private async Task SendAsync(string text, bool generate)
	{
		var editing = _editingMessage;
		_inputText = string.Empty;
		_editingMessage = null;

		if (editing is { } message)
		{
			// The history may have moved under the edit: never rewrite a message the participant did not open.
			var index = message.MessageIndex;
			if (index < 0 || index >= chat.Messages.Count || !ReferenceEquals(chat.Messages[index], message))
				return;

			await chatOperation.SendEditedUserInputAsync(index, CreateUserInput(text), generate);
		}
		else
		{
			await chatOperation.SendUserInputAsync(CreateUserInput(text), generate);
		}

		// Mark for scroll on next render so the sent message is visible
		_pendingScroll = true;
	}

	private async Task EnqueueAsync(string text, bool generate)
	{
		_inputText = string.Empty;

		await chatOperation.QueueUserInputAsync(CreateUserInput(text), generate);
	}

	private Task SendMessageWithoutGeneration() => SubmitAsync(false);
	private Task SendMessageWithGeneration() => SubmitAsync(true);

	private void StopGeneration()
	{
		try
		{
			// The Stop button is a hard stop: it never injects the queue.
			_ = chatOperation.StopGenerationAsync();
		}
		catch (Exception ex)
		{
			Console.Error.WriteLine($"Failed to stop generation: {ex.Message}");
		}
	}

	private void OnQueueChanged() => InvokeAsync(() =>
	{
		_queueCount = FollowUps.Count;
		_queueEntries = [.. FollowUps.Entries];
		StateHasChanged();
	});

	private void OpenQueueDialog()
	{
		_queueEntries = [.. FollowUps.Entries];
		_showQueueDialog = true;
	}

	private void CloseQueueDialog() => _showQueueDialog = false;

	private void RemoveEntry(FollowUpMessage entry) => FollowUps.Remove(entry);

	private async Task ClearQueue()
	{
		if (!await JS.InvokeAsync<bool>("confirm", LocalizationManager.LocalizeStatic("chat.follow_up.clear.description")))
			return;

		FollowUps.Clear();
	}

	private void BeginEdit(BranchedMessage message)
	{
		if (message.Message is not UserMessage userMessage)
			return;

		_editingMessage = message;
		_inputText = userMessage.Content ?? string.Empty;
	}

	private void CancelEdit()
	{
		_editingMessage = null;
		_inputText = string.Empty;
	}

	private Task RevealEditingMessage()
	{
		if (_editingMessage is not { } message)
			return Task.CompletedTask;

		return JS.InvokeVoidAsync("eval",
			$"document.getElementById('msg-{message.MessageIndex}')?.scrollIntoView({{block: 'center'}})").AsTask();
	}

	/// <summary>
	/// Gets a value indicating whether there is anything to submit: text to send or a pending queue to flush.
	/// </summary>
	private bool CanSubmit => !string.IsNullOrWhiteSpace(_inputText) || _queueCount > 0;

	private static string Preview(FollowUpMessage entry)
	{
		var text = entry.UserInput.Content.Replace('\r', ' ').Replace('\n', ' ').Replace('\t', ' ').Trim();
		return text.Length <= 120 ? text : text[..117] + "...";
	}

	private static string LevelTitle(FollowUpInjectionLevel level) => LocalizationManager.LocalizeStatic(level switch
	{
		FollowUpInjectionLevel.Immediate => "chat.follow_up.level.immediate",
		FollowUpInjectionLevel.Message => "chat.follow_up.level.message",
		FollowUpInjectionLevel.Agent => "chat.follow_up.level.agent",
		_ => "chat.follow_up.level.agent_sequence",
	});

	private async Task ScrollToBottom(bool smooth = true)
	{
		try
		{
			await JS.InvokeVoidAsync("ChatScroll.scrollToBottom", smooth);
		}
		catch { }
	}

	private void ToggleProfileOverlay() => _showProfileOverlay = !_showProfileOverlay;
	private void CloseProfileOverlay() => _showProfileOverlay = false;

	public void Dispose()
	{
		chat.Messages.CollectionChanged -= MessagesChanged;
		ExecutionTokens.ExecutionCancellationTokenChanged -= ExecutionStateChanged;
		FollowUps.Changed -= OnQueueChanged;
		_ = JS.InvokeVoidAsync("ChatScroll.destroy");
	}
}
